<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ============================== BADGE (systray) ============================== -->
<!-- Native Odoo 18 systray item: registered in registry.category("systray")
     (see inbox_badge.js, sequence 10). The navbar renders the registry in
     .o_menu_systray (top-right). The anchor button is the Dropdown target —
     Odoo wires the open/close toggle, aria-expanded and the caret-free
     .o-dropdown classes on it. The menu is Odoo's DropdownPopover:
     bottom-end, auto-flip, viewport-clamped — no manual coordinates. -->
<t t-name="prema_dispatch_inbox.InboxBadge" owl="1">
    <!-- OWL 2: component-tag attributes are expressions — string literals
         need explicit quotes (menuClass="o_inbox_badge_menu" would resolve
         as this.o_inbox_badge_menu → undefined, silently dropping the class). -->
    <Dropdown position="'bottom-end'" state="dropdown" menuClass="'o_inbox_badge_menu'">
        <button type="button" class="o_inbox_badge">
            <span class="o_inbox_badge_env">
                <i class="fa fa-envelope" t-att-class="{ 'o-inbox-pulse': state.pulse }"
                   role="img" aria-label="Dispatch Inbox"/>
                <span t-if="state.total" class="o_inbox_badge_count"
                      t-att-class="{ 'o-inbox-anim': state.animations }">
                    <t t-esc="state.total &gt; 99 ? '99+' : state.total"/>
                </span>
            </span>
        </button>
        <t t-set-slot="content">
            <div class="o_inbox_popover">
                <div class="o_inbox_popover_head">
                    <strong>Dispatch Inbox</strong>
                    <span t-if="state.spam" class="o_inbox_spam_count">
                        <i class="fa fa-shield"/> <t t-esc="state.spam"/> spam
                    </span>
                </div>
                <button class="btn btn-primary btn-sm w-100"
                        t-on-click="() => this.openInbox()">
                    Open Dispatch Inbox
                </button>
                <label class="o_inbox_popover_row">
                    <input type="checkbox" t-att-checked="state.animations"
                           t-on-change="() => this.toggleAnimations()"/>
                    Disable animation
                </label>
                <label class="o_inbox_popover_row">
                    <input type="checkbox" t-att-checked="state.sound"
                           t-on-change="() => this.toggleSound()"/>
                    Sound for new messages
                </label>
                <div class="text-muted small o_inbox_popover_note">
                    Badge counts messages only you haven't read. Notifications
                    require the browser tab to be open.
                </div>
            </div>
        </t>
    </Dropdown>
</t>

<!-- ============================== APP ============================== -->
<t t-name="prema_dispatch_inbox.InboxApp" owl="1">
    <div class="o_inbox_app">
        <!-- C1 · Folders -->
        <div class="o_inbox_col o_inbox_folders"
             t-att-class="{ 'o-inbox-show': state.mobileScreen === 'list' || state.selectedId === null }">
            <div class="o_inbox_col_head">Dispatch Inbox</div>
            <div t-foreach="state.folders" t-as="f" t-key="f.key"
                 class="o_inbox_folder"
                 t-att-class="{ 'active': state.folder === f.key }"
                 t-on-click="() => this.selectFolder(f.key)">
                <span class="o_inbox_folder_label">
                    <t t-esc="f.label"/>
                </span>
                <span t-if="f.count" class="badge text-bg-secondary">
                    <t t-esc="f.count"/>
                </span>
            </div>
        </div>

        <!-- C2 · Conversation list -->
        <div class="o_inbox_col o_inbox_list"
             t-att-class="{ 'o-inbox-show': state.mobileScreen === 'list' }">
            <div class="o_inbox_col_head">
                <span t-esc="folderLabel(state.folder)"/>
                <span t-if="state.loading" class="spinner-border spinner-border-sm ms-2"/>
            </div>
            <input class="form-control form-control-sm o_inbox_search"
                   placeholder="Search sender, subject, body, customer…"
                   t-model="state.search" t-on-input="(ev) => this.onSearch()"/>
            <div class="o_inbox_convs">
                <t t-if="state.loadError">
                    <div class="o_inbox_empty">
                        <div t-esc="state.loadError"/>
                        <button class="btn btn-sm btn-primary mt-2"
                                t-on-click="() => this.retryLoad()">
                            Retry
                        </button>
                    </div>
                </t>
                <t t-elif="!state.conversations.length">
                    <div class="o_inbox_empty">Nothing here.</div>
                </t>
                <div t-foreach="state.conversations" t-as="c" t-key="c.id"
                     class="o_inbox_conv"
                     t-att-class="{
                        'active': state.selectedId === c.id,
                        'o-inbox-unread': c.unread_count &gt; 0,
                     }"
                     t-on-click="() => this.openConversation(c.id)">
                    <div class="o_inbox_conv_top">
                        <span class="o_inbox_conv_from"
                              t-esc="c.customer_label || '(no customer)'"/>
                        <span t-if="c.partner_provisional"
                              class="fa fa-exclamation-triangle o_inbox_prov_ico"
                              t-att-title="'Customer not confirmed — open to review'"/>
                        <span class="o_inbox_conv_time"
                              t-esc="fmtDate(c.last_message_date)"/>
                    </div>
                    <div class="o_inbox_conv_subject" t-esc="c.name"/>
                    <div class="o_inbox_conv_meta">
                        <span class="badge o_inbox_cat"
                              t-att-class="'o_inbox_cat_' + c.category">
                            <t t-esc="this.CATEGORY_LABELS[c.category] || c.category"/>
                        </span>
                        <span t-if="c.priority === 'urgent'" class="fa fa-flag text-warning"/>
                        <span t-if="c.priority === 'emergency'" class="fa fa-flag text-danger"/>
                        <span t-if="c.has_attachment" class="fa fa-paperclip text-muted"/>
                        <span t-if="c.booking_id || c.job_id || c.invoice_id || c.opportunity_id"
                              class="o_inbox_chip">linked</span>
                        <span t-if="c.is_load_board" class="o_inbox_chip">load board</span>
                        <span t-if="c.assignee_id" class="o_inbox_chip o_inbox_chip_assign"
                              t-att-title="'Assigned to ' + (c.assignee_name || '')">
                            <t t-esc="c.assignee_name || ''"/>
                        </span>
                        <span t-if="c.unread_count" class="o_inbox_unread_dot"
                              t-att-title="c.unread_count"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- C3 · Conversation -->
        <div class="o_inbox_col o_inbox_thread"
             t-att-class="{ 'o-inbox-show': state.mobileScreen === 'conversation' || state.mobileScreen === 'ai' }">
            <div t-if="!state.detail" class="o_inbox_empty">
                Select a conversation.
            </div>
            <t t-elif="!state.detail.conversation">
                <div class="o_inbox_empty">
                    <div>Conversation no longer exists.</div>
                    <button class="btn btn-sm btn-primary mt-2"
                            t-on-click="() => this.loadConversations()">
                        Refresh
                    </button>
                </div>
            </t>
            <t t-else="">
                <div class="o_inbox_col_head">
                    <button class="btn btn-sm btn-light d-lg-none me-2"
                            t-on-click="() => this.backTo('list')"><i class="fa fa-arrow-left"/></button>
                    <div class="o_inbox_thread_title">
                        <div t-esc="state.detail.conversation.name"/>
                        <a role="button" class="o_inbox_partner_chip"
                           t-if="state.detail.conversation.partner_id"
                           t-on-click="() => this.openPartner()"
                           t-att-title="'Open customer record'">
                            <i class="fa fa-building-o"/>
                            <t t-esc="state.detail.conversation.customer_label"/>
                        </a>
                        <span t-else="" class="text-muted small">(no customer)</span>
                    </div>
                    <!-- assignment: native Dropdown, group-filtered -->
                    <Dropdown state="assignDropdown" menuClass="'o_inbox_assign_dd'"
                              t-on-open="() => this.loadAssignCandidates()">
                        <button class="btn btn-sm btn-outline-secondary ms-auto"
                                t-att-class="{ 'o_inbox_assign_me': isMine(state.detail.conversation.assignee_id) }">
                            <i class="fa fa-user-o"/>
                            <span t-if="state.detail.conversation.assignee_name"
                                  t-esc="state.detail.conversation.assignee_name"/>
                            <span t-else="">Assign</span>
                        </button>
                        <t t-set-slot="content">
                            <div class="o_inbox_assign_menu">
                                <div class="o_inbox_assign_row"
                                     t-on-click="() => this.doUnassign()">
                                    <i class="fa fa-user-times o_inbox_assign_ico"/> Unassigned
                                    <i t-if="!state.detail.conversation.assignee_id"
                                       class="fa fa-check ms-auto"/>
                                </div>
                                <div t-foreach="state.assignCandidates" t-as="u" t-key="u.id"
                                     class="o_inbox_assign_row"
                                     t-on-click="() => this.doAssign(u.id)">
                                    <i class="fa fa-user o_inbox_assign_ico"/>
                                    <span t-esc="u.name"/>
                                    <i t-if="u.id === state.detail.conversation.assignee_id"
                                       class="fa fa-check ms-auto"/>
                                </div>
                            </div>
                        </t>
                    </Dropdown>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.toggleMute()"
                            t-att-class="{ 'o_inbox_muted_btn': state.detail.muted }"
                            t-att-title="state.detail.muted ? 'Muted — suppresses notification/sound; does NOT mark read' : 'Mute — suppresses notification/sound; does NOT mark read'">
                        <i class="fa" t-att-class="state.detail.muted ? 'fa-bell-slash' : 'fa-bell-slash-o'"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.markUnread(state.detail.conversation.id)"
                            t-att-title="'Mark unread'">
                        <i class="fa fa-envelope-o"/> Unread
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_inbox_ai_toggle"
                            t-on-click="() => this.toggleAiPanel()"
                            t-att-title="'AI Assistant'">
                        <i class="fa fa-magic"/>
                    </button>
                </div>

                <!-- thread header: status/category/linked records -->
                <div class="o_inbox_thread_meta">
                    <select class="form-select form-select-sm o_inbox_sel"
                            t-model="state.detail.conversation.category"
                            t-on-change="(ev) => this.setCategory(ev.target.value)">
                        <t t-foreach="this.CATEGORY_OPTIONS" t-as="cat" t-key="cat.value">
                            <option t-att-value="cat.value" t-esc="cat.label"/>
                        </t>
                    </select>
                    <select class="form-select form-select-sm o_inbox_sel"
                            t-model="state.detail.conversation.workflow_state"
                            t-on-change="(ev) => this.setState(ev.target.value)">
                        <t t-foreach="this.STATE_OPTIONS" t-as="st" t-key="st.value">
                            <option t-att-value="st.value" t-esc="st.label"/>
                        </t>
                    </select>
                    <div class="o_inbox_linked">
                        <!-- linked records: human-readable clickable chips -->
                        <t t-foreach="linkedRows()" t-as="lr" t-key="lr.model">
                            <span class="o_inbox_chip o_inbox_linkchip">
                                <span class="o_inbox_linkchip_label" t-esc="lr.label"/>
                                <a role="button" class="o_inbox_linkchip_name"
                                   t-on-click="() => this.openLinkedRecord(lr.model, lr.id)"
                                   t-att-title="'Open ' + lr.label">
                                    <t t-esc="lr.name || ('#' + lr.id)"/>
                                </a>
                                <button type="button" class="btn btn-link btn-sm p-0 o_inbox_linkchip_x"
                                        t-att-title="'Unlink ' + lr.label"
                                        t-on-click="() => this.unlinkRecord(lr.model)">
                                    <i class="fa fa-times"/>
                                </button>
                            </span>
                        </t>
                        <!-- link picker: one native Dropdown, four types,
                             replaces its content on type switch -->
                        <Dropdown state="linkDropdown" menuClass="'o_inbox_picker'">
                            <button class="btn btn-link btn-sm p-0 o_inbox_linkbtn"
                                    title="Link a booking, job, invoice or opportunity">
                                <i class="fa fa-link"/> Link
                            </button>
                            <t t-set-slot="content">
                                <div class="o_inbox_picker" t-if="state.linkCandidates">
                                    <div class="o_inbox_picker_head">
                                        <strong t-esc="'Link ' + linkTypeLabel(state.linkCandidates.model)"/>
                                        <button type="button" class="btn btn-sm btn-link p-0"
                                                t-on-click="() => this.linkDropdown.close()">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                    <div class="o_inbox_picker_types">
                                        <button t-foreach="['booking', 'job', 'invoice', 'opportunity']"
                                                t-as="ltype" t-key="ltype" class="btn btn-sm"
                                                t-att-class="state.linkCandidates.model === ltype ? 'btn-primary' : 'btn-outline-primary'"
                                                t-on-click="() => this.searchLinks(ltype)">
                                            <t t-esc="linkTypeLabel(ltype)"/>
                                        </button>
                                    </div>
                                    <input class="form-control form-control-sm mt-1 o_inbox_picker_search"
                                           t-model="state.linkSearch"
                                           placeholder="Number, name, customer…"
                                           t-on-input="(ev) => this.onLinkSearch()"/>
                                    <label class="o_inbox_picker_manual">
                                        <input type="checkbox"
                                               t-att-checked="state.linkCandidates.manual"
                                               t-on-change="(ev) => this.toggleManualLinkSearch(ev.target.checked)"/>
                                        Manual search (any customer)
                                    </label>
                                    <div class="o_inbox_picker_results">
                                        <t t-if="state.linkCandidates.records.length">
                                            <div t-foreach="state.linkCandidates.records"
                                                 t-as="r" t-key="r.id"
                                                 class="o_inbox_picker_row"
                                                 t-on-click="() => this.linkRecord(state.linkCandidates.model, r.id)">
                                                <div class="o_inbox_picker_row_name">
                                                    <span class="fw-bold" t-esc="r.name"/>
                                                    <span t-if="r.state"
                                                          class="badge text-bg-secondary ms-1"
                                                          t-esc="r.state"/>
                                                </div>
                                                <div class="small text-muted"
                                                     t-esc="r.partner_name || ''"/>
                                                <!-- D-5: model-specific detail line
                                                     (number/pickup/delivery/date/total) -->
                                                <div class="small text-muted o_inbox_picker_row_detail"
                                                     t-esc="linkDetail(r, state.linkCandidates.model)"/>
                                            </div>
                                        </t>
                                        <div t-else="" class="o_inbox_picker_empty">
                                            No records found for this contact/company.
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </Dropdown>
                    </div>
                </div>

                <!-- D-4: ambiguous sender match — dispatcher MUST confirm.
                     No automatic association is ever made for it. -->
                <div t-if="state.detail.conversation.partner_provisional"
                     class="o_inbox_prov">
                    <div class="fw-bold small">
                        <i class="fa fa-exclamation-triangle"/> Confirm customer
                    </div>
                    <div class="small">
                        This sender's email matches multiple records — no
                        customer was associated automatically.
                    </div>
                    <div class="o_inbox_prov_actions">
                        <button t-foreach="state.detail.conversation.partner_suggestions || []"
                                t-as="s" t-key="s.id"
                                class="btn btn-sm btn-outline-primary"
                                t-att-title="'Associate with ' + s.email"
                                t-on-click="() => this.confirmPartner(s.id)">
                            <t t-esc="s.name"/>
                            <t t-if="s.reason"> · <t t-esc="s.reason"/></t>
                        </button>
                        <button class="btn btn-sm btn-link p-0"
                                t-on-click="() => this.dismissProvisional()"
                                title="Leave unassigned">Leave unassigned</button>
                    </div>
                </div>

                <!-- drafts banner (resume edits the SAME message) -->
                <div t-if="state.detail.drafts.length" class="o_inbox_draftbar">
                    <div class="small fw-bold">
                        <i class="fa fa-pencil-square-o"/> Draft in this thread
                    </div>
                    <div t-foreach="state.detail.drafts" t-as="d" t-key="d.id"
                         class="o_inbox_draftbar_row">
                        <span class="text-truncate" t-att-title="d.subject || d.body_plain">
                            <t t-esc="d.subject || d.body_plain || '(no subject)'"/>
                        </span>
                        <span class="text-muted small ms-2" t-esc="fmtDate(d.date)"/>
                        <span class="ms-auto d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary"
                                    t-on-click="() => this.resumeDraft(d)">
                                Resume
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    t-on-click="() => this.discardDraft(d.id)">
                                Discard
                            </button>
                        </span>
                    </div>
                </div>

                <!-- message history -->
                <div class="o_inbox_msgs">
                    <div t-foreach="state.detail.messages" t-as="m" t-key="m.id"
                         class="o_inbox_msg"
                         t-att-class="'o_inbox_' + m.direction">
                        <div class="o_inbox_msg_head">
                            <span class="o_inbox_msg_author" t-esc="m.author_name"/>
                            <span t-if="m.direction === 'outgoing' &amp;&amp; m.to.length"
                                  class="o_inbox_msg_to"
                                  t-att-title="'To: ' + toLine(m)">
                                → <t t-esc="toLine(m)"/>
                            </span>
                            <span class="o_inbox_msg_time" t-esc="fmtDate(m.date)"/>
                            <span t-if="m.direction === 'outgoing'"
                                  class="o_inbox_chip"
                                  t-att-class="{'o_inbox_chip_failed': m.outbound_state === 'failed'}"
                                  t-att-title="m.send_error || ''"
                                  t-esc="m.outbound_state === 'intercepted' ? 'intercepted (never sent)' : (this.OUTBOUND_LABELS[m.outbound_state] || 'outgoing')"/>
                            <span t-if="m.direction === 'note'"
                                  class="o_inbox_chip o_inbox_chip_note">Internal note</span>
                            <button t-if="m.direction === 'outgoing' &amp;&amp; m.outbound_state === 'failed'"
                                    class="btn btn-sm btn-outline-danger ms-1"
                                    t-on-click="() => this.retrySend(m.id)">
                                Retry
                            </button>
                        </div>
                        <!-- Incoming HTML is sanitized ONCE at ingest
                             (scripts / on* / javascript: hrefs / remote
                             images / tracking pixels stripped; tables,
                             lists and links kept). The default view renders
                             that sanitized HTML — readable email formatting
                             with no XSS surface. "View plain text" opts
                             out. Outgoing/notes always render plain text
                             (dispatcher-typed). -->
                        <div t-if="m.direction === 'incoming' &amp;&amp; m.body &amp;&amp; state.plainMsg !== m.id"
                             class="o_inbox_msg_body o_inbox_html" t-raw="m.body"/>
                        <div t-else=""
                             class="o_inbox_msg_body o_inbox_plain" t-esc="m.body_plain"/>
                        <div class="o_inbox_msg_fmt">
                            <button t-if="m.direction === 'incoming' &amp;&amp; m.body"
                                    class="btn btn-link btn-sm p-0"
                                    t-on-click="() => this.toggleFormatted(m.id)">
                                <t t-esc="state.plainMsg === m.id ? 'View formatted' : 'View plain text'"/>
                            </button>
                        </div>
                        <!-- attachments: open / preview / download via the
                             authenticated authorized route (inbox group) -->
                        <div t-if="m.attachments.length" class="o_inbox_att">
                            <span t-foreach="m.attachments" t-as="a" t-key="a.id"
                                  class="o_inbox_att_row">
                                <i class="fa" t-att-class="attIcon(a.mimetype)"/>
                                <a class="o_inbox_att_link" target="_blank" rel="noopener"
                                   t-att-href="attHref(a)" t-att-title="a.name">
                                    <t t-esc="a.name"/>
                                </a>
                                <a class="o_inbox_att_dl" t-att-href="attDownloadHref(a)"
                                   t-att-title="'Download ' + a.name">
                                    <i class="fa fa-download"/>
                                </a>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- composer (C3) -->
                <div class="o_inbox_composer">
                    <div class="btn-group btn-group-sm mb-1">
                        <button class="btn btn-outline-primary"
                                t-on-click="() => this.startComposer('reply')">Reply</button>
                        <button class="btn btn-outline-primary"
                                t-on-click="() => this.startComposer('reply_all')">Reply all</button>
                        <button class="btn btn-outline-secondary"
                                t-on-click="() => this.startComposer('forward')">Forward</button>
                        <button class="btn btn-outline-primary"
                                t-on-click="() => this.startComposer('compose')">New email</button>
                        <button class="btn btn-outline-secondary"
                                t-on-click="() => this.startComposer('note')">Internal note</button>
                    </div>
                    <t t-if="state.composer.mode">
                        <t t-if="state.composer.mode !== 'note'">
                            <div class="o_inbox_comp_row">
                                <label>To</label>
                                <input class="form-control form-control-sm" type="text"
                                       t-model="state.composer.to"
                                       placeholder="customer@example.com"/>
                            </div>
                            <div class="o_inbox_comp_row"
                                 t-if="state.composer.mode === 'reply_all' || state.composer.mode === 'compose'">
                                <label>Cc</label>
                                <input class="form-control form-control-sm" type="text"
                                       t-model="state.composer.cc"
                                       placeholder="cc@example.com"/>
                            </div>
                            <div class="o_inbox_comp_row">
                                <label>Subject</label>
                                <input class="form-control form-control-sm" type="text"
                                       t-model="state.composer.subject"
                                       placeholder="Subject"/>
                            </div>
                            <div t-if="state.composer.attachments.length"
                                 class="o_inbox_comp_att">
                                <span t-foreach="state.composer.attachments" t-as="a"
                                      t-key="a.id" class="o_inbox_chip">
                                    <i class="fa fa-paperclip"/> <t t-esc="a.name"/>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1"
                                            t-att-title="'Remove ' + a.name"
                                            t-on-click="() => this.removeAttachment(a.id)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                            </div>
                        </t>
                        <textarea class="form-control form-control-sm"
                                  rows="4" t-model="state.composer.body"
                                  t-att-placeholder="state.composer.mode === 'note' ? 'Internal note — never emailed.' : 'Draft…'"/>
                        <div class="mt-1 d-flex gap-1 flex-wrap align-items-center">
                            <t t-if="state.composer.mode !== 'note'">
                                <button class="btn btn-sm btn-secondary"
                                        t-on-click="() => this.saveDraft()"
                                        t-att-disabled="state.composer.sending">
                                    Save draft
                                </button>
                                <button class="btn btn-sm btn-primary"
                                        t-on-click="() => this.sendNow()"
                                        t-att-disabled="state.composer.sending">
                                    Send
                                </button>
                                <label class="btn btn-sm btn-outline-secondary mb-0"
                                       title="Attach a file">
                                    <i class="fa fa-paperclip"/> Attach
                                    <input type="file" multiple="multiple" class="d-none"
                                           t-on-change="(ev) => this.onFileSelected(ev)"/>
                                </label>
                                <span class="small text-muted">
                                    From dispatcher@logistics.premafirm.com.
                                </span>
                            </t>
                            <t t-else="">
                                <button class="btn btn-sm btn-primary"
                                        t-on-click="() => this.addNote()"
                                        t-att-disabled="state.composer.sending">
                                    Add note
                                </button>
                                <span class="small text-muted">
                                    Internal note — never emailed.
                                </span>
                            </t>
                            <button t-if="state.composer.draftId"
                                    class="btn btn-sm btn-outline-danger ms-auto"
                                    t-on-click="() => this.discardDraft(state.composer.draftId)">
                                <i class="fa fa-trash-o"/> Discard
                            </button>
                        </div>
                    </t>
                </div>
            </t>
        </div>

        <!-- C4 · AI Assistant -->
        <div class="o_inbox_col o_inbox_ai"
             t-att-class="{
                'o-inbox-show': state.mobileScreen === 'ai',
                'o-inbox-ai-closed': !state.ai.panelOpen,
             }">
            <div class="o_inbox_col_head">
                <span>AI Assistant</span>
                <button class="btn btn-sm btn-link p-0 ms-auto"
                        t-on-click="() => this.toggleAiPanel()"
                        t-att-title="'Collapse / expand AI panel'">
                    <i class="fa" t-att-class="state.ai.panelOpen ? 'fa-chevron-right' : 'fa-chevron-left'"/>
                </button>
                <button class="btn btn-sm btn-link p-0 d-lg-none"
                        t-on-click="() => this.backTo('conversation')"><i class="fa fa-times"/></button>
            </div>
            <div t-if="!state.detail || !state.detail.conversation" class="o_inbox_empty">
                Select a conversation to analyze.
            </div>
            <t t-else="">
                <div class="o_inbox_ai_body" t-att-class="{ 'd-none': !state.ai.panelOpen }">
                    <!-- summary (persisted server-side) -->
                    <div t-if="state.detail.ai.summary" class="o_inbox_ai_section">
                        <div class="o_inbox_ai_card">
                            <div class="fw-bold small">Thread summary</div>
                            <div class="o_inbox_ai_summary" t-esc="state.detail.ai.summary"/>
                        </div>
                    </div>

                    <!-- formatted extraction — never raw JSON -->
                    <div t-if="state.detail.ai.extraction" class="o_inbox_ai_section">
                        <div class="o_inbox_ai_card">
                            <div class="fw-bold small">Shipment extraction</div>
                            <div t-foreach="extractionRows()" t-as="r" t-key="r.label"
                                 class="o_inbox_ai_row">
                                <span class="o_inbox_ai_key" t-esc="r.label"/>
                                <!-- D-9: inline edit (postal code for
                                     stop rows, value for scalars) -->
                                <t t-if="state.ai.editingKey === r.key">
                                    <span class="o_inbox_ai_val">
                                        <input class="form-control form-control-sm"
                                               t-model="state.ai.editValue"
                                               t-on-keydown="(ev) => { if (ev.key === 'Enter') this.saveEditExtraction(); if (ev.key === 'Escape') this.cancelEditExtraction(); }"/>
                                    </span>
                                    <span class="o_inbox_ai_actions">
                                        <button class="btn btn-sm btn-link p-0"
                                                t-on-click="() => this.saveEditExtraction()"
                                                title="Save">
                                            <i class="fa fa-check"/>
                                        </button>
                                        <button class="btn btn-sm btn-link p-0 ms-1"
                                                t-on-click="() => this.cancelEditExtraction()"
                                                title="Cancel">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="o_inbox_ai_val" t-esc="r.value"/>
                                    <span class="o_inbox_ai_src"
                                          t-att-class="{ 'o_inbox_ai_miss': r.missing }">
                                        <t t-if="r.key === 'pickup' || r.key === 'delivery'">
                                            Postal/FSA:
                                            <t t-esc="r.missing ? 'missing' : r.fsa"/>
                                            <button class="btn btn-link btn-sm p-0 ms-1 o_inbox_ai_edit"
                                                    t-on-click="() => this.editExtraction(r.key)"
                                                    title="Edit postal code">
                                                <i class="fa fa-pencil"/>
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <button class="btn btn-link btn-sm p-0 o_inbox_ai_edit"
                                                    t-on-click="() => this.editExtraction(r.key)"
                                                    title="Edit value">
                                                <i class="fa fa-pencil"/>
                                            </button>
                                        </t>
                                    </span>
                                </t>
                            </div>
                            <div t-if="extractionMissing().length" class="o_inbox_ai_warn">
                                Missing: <t t-esc="extractionMissing().join(', ')"/>
                            </div>
                            <div t-if="extractionConflicts().length" class="mt-1">
                                <button class="btn btn-sm btn-outline-warning w-100"
                                        t-on-click="() => this.toggleConflicts()">
                                    <i class="fa fa-exclamation-triangle"/>
                                    Conflicts: <t t-esc="extractionConflicts().length"/>
                                </button>
                                <div t-if="state.ai.conflictsOpen"
                                     class="o_inbox_ai_conflicts">
                                    <div t-foreach="extractionConflicts()" t-as="cfl"
                                         t-key="cfl_index" class="o_inbox_ai_row">
                                        <span class="o_inbox_ai_key" t-esc="cfl.field || 'field'"/>
                                        <span class="small"
                                              t-esc="cfl.reason || fmtValue(cfl)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_inbox_ai_section">
                        <button class="btn btn-sm btn-outline-primary w-100"
                                t-on-click="() => this.aiAction('summarize')"
                                t-att-disabled="state.ai.busy">
                            <i class="fa fa-magic"/> Summarize thread
                        </button>
                        <button class="btn btn-sm btn-outline-secondary w-100 mt-1"
                                t-on-click="() => this.aiAction('extract')"
                                t-att-disabled="state.ai.busy">
                            <i class="fa fa-database"/> Extract shipment
                        </button>
                        <button class="btn btn-sm btn-outline-secondary w-100 mt-1"
                                t-on-click="() => this.aiAction('draft_reply')"
                                t-att-disabled="state.ai.busy">
                            <i class="fa fa-pencil"/> Draft reply
                        </button>
                    </div>

                    <!-- Prema Pricing Engine card (D-10 state + breakdown,
                         F-1 dispatcher adjustment, F-2 Reply with Quote) -->
                    <div class="o_inbox_ai_section">
                        <div class="o_inbox_ai_card o_inbox_price_card">
                            <div class="d-flex align-items-center gap-2">
                                <div class="fw-bold small">Prema Pricing Engine</div>
                                <span class="badge o_inbox_ps_badge"
                                      t-att-class="pricingStateClass(pricingState().state)"
                                      t-esc="pricingState().label"/>
                            </div>
                            <div class="text-muted small">
                                Deterministic corridor pricing — never AI-invented.
                            </div>
                            <button class="btn btn-sm btn-primary w-100 mt-1"
                                    t-on-click="() => this.calculatePrice()"
                                    t-att-disabled="state.ai.busy">
                                <i class="fa fa-calculator"/> Review &amp; calculate quote
                            </button>
                            <div t-if="state.detail.pricing" class="mt-2">
                                <div t-if="state.detail.pricing.available"
                                     class="o_inbox_price"
                                     t-esc="fmtMoney(state.detail.pricing.calculated_price, state.detail.pricing.currency)"/>
                                <div t-elif="state.detail.pricing.reason_text"
                                     class="o_inbox_ai_warn"
                                     t-esc="state.detail.pricing.reason_text"/>
                                <div t-else="" class="o_inbox_ai_warn"
                                     t-esc="'Engine: ' + (state.detail.pricing.reason || 'unavailable')"/>
                                <div t-if="state.detail.pricing.missing_sides"
                                     class="small text-muted mt-1">
                                    <div t-if="state.detail.pricing.missing_sides.pickup">
                                        <i class="fa fa-circle-o text-warning"/> Pickup location: postal code missing
                                    </div>
                                    <div t-if="state.detail.pricing.missing_sides.delivery">
                                        <i class="fa fa-circle-o text-warning"/> Delivery location: postal code missing
                                    </div>
                                </div>

                                <!-- D-10: engine breakdown ± adjustment = final -->
                                <div t-if="quoteBreakdown().length"
                                     class="small text-muted mt-1 o_inbox_price_breakdown">
                                    <div t-foreach="quoteBreakdown()" t-as="pl"
                                         t-key="pl_index"
                                         t-att-class="{ 'o_inbox_adj_line': pl.kind === 'adjustment' }">
                                        <span t-esc="pl.label"/>
                                        <span class="float-end"
                                              t-esc="fmtMoney(pl.amount, quoteState().currency)"/>
                                    </div>
                                </div>
                                <div t-if="quoteState().engine_calculated_price"
                                     class="small o_inbox_price_total mt-1">
                                    <span>Final quoted price</span>
                                    <span class="float-end fw-bold"
                                          t-esc="fmtMoney(quoteState().final_quoted_price, quoteState().currency)"/>
                                </div>
                                <div t-if="quoteState().quoted_by" class="small text-muted">
                                    Quoted by <t t-esc="quoteState().quoted_by"/>
                                    <t t-if="quoteState().quoted_at"
                                       t-esc="' · ' + fmtDate(quoteState().quoted_at)"/>
                                </div>
                                <div t-if="quoteState().adjustment_reason"
                                     class="small text-muted o_inbox_quote_reason"
                                     t-esc="'Reason: ' + quoteState().adjustment_reason"/>

                                <!-- F-1: dispatcher adjustment (engine price
                                     untouched — separate quote state) -->
                                <div t-if="quoteState().engine_calculated_price"
                                     class="o_inbox_quote_adj mt-2">
                                    <div class="small fw-semibold">Dispatcher price adjustment</div>
                                    <div class="d-flex gap-1">
                                        <input class="form-control form-control-sm"
                                               type="number" step="0.01"
                                               t-model="state.ai.adjInput"
                                               placeholder="+/- amount"
                                               t-on-keydown="(ev) => { if (ev.key === 'Enter') this.saveAdjustment(); }"/>
                                        <input class="form-control form-control-sm"
                                               t-model="state.ai.adjReason"
                                               placeholder="Reason (optional)"/>
                                    </div>
                                    <div class="d-flex gap-1 mt-1">
                                        <button class="btn btn-sm btn-outline-primary"
                                                t-on-click="() => this.saveAdjustment()">
                                            <i class="fa fa-check"/> Apply
                                        </button>
                                        <button t-if="quoteState().dispatcher_adjustment"
                                                class="btn btn-sm btn-outline-secondary"
                                                t-on-click="() => this.clearAdjustment()">
                                            Reset to engine price
                                        </button>
                                    </div>
                                </div>

                                <!-- F-2: deterministic quote reply → composer,
                                     dispatcher reviews + sends -->
                                <button class="btn btn-sm btn-outline-primary w-100 mt-2"
                                        t-on-click="() => this.quoteReply()"
                                        t-att-disabled="state.ai.busy">
                                    <i class="fa fa-paper-plane-o"/> Reply with Quote
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="o_inbox_ai_footer">
                        Suggestions require approval — nothing is sent or booked
                        automatically.
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

</odoo>
