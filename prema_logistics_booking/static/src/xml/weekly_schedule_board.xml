<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="prema_logistics_booking.WeeklyScheduleBoard">
        <div class="o_weekly_schedule_board container-fluid py-2">
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x text-muted"/><p class="mt-2 text-muted">Loading...</p>
            </div>
            <t t-else="">
                <!-- Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="mb-0">Weekly Schedule</h4>
                        <select class="form-select form-select-sm" style="width:auto" t-on-change="(ev) => this.onTruckChange(ev)">
                            <option t-foreach="state.trucks" t-as="t" t-key="t.id" t-att-value="t.id" t-att-selected="t.id === state.selectedTruckId" t-esc="t.name"/>
                        </select>
                        <small class="text-muted" t-esc="state.dateRange"/>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <t t-foreach="filterOptions" t-as="f" t-key="f[0]">
                            <span t-attf-class="badge rounded-pill #{state.filter===f[0]?'bg-primary':'bg-light text-dark'}" t-esc="f[1]" t-on-click="() => this.state.filter = f[0]" style="cursor:pointer"/>
                        </t>
                        <input type="text" class="form-control form-control-sm" placeholder="Search..." style="width:180px" t-model="state.search"/>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.loadData()"><i class="fa fa-refresh"/></button>
                    </div>
                </div>
                <!-- Legend -->
                <div class="mb-2 d-flex gap-3 flex-wrap small">
                    <span><span class="badge bg-success">●</span> On Time</span>
                    <span><span class="badge bg-info">●</span> Scheduled</span>
                    <span><span class="badge bg-warning text-dark">●</span> Nearly Full</span>
                    <span><span class="badge bg-danger">●</span> Delayed</span>
                    <span><span class="badge bg-dark">●</span> Cancelled</span>
                    <span><span class="badge bg-purple">●</span> Completed</span>
                    <span><span class="badge bg-secondary">●</span> No Truck</span>
                </div>
                <!-- 7-Column Grid -->
                <div class="row g-2" style="flex-wrap:nowrap;overflow-x:auto;min-width:1540px">
                    <t t-foreach="state.weekDays" t-as="day" t-key="day.date">
                        <div class="col" style="min-width:260px;max-width:320px">
                            <div t-attf-class="text-center p-2 rounded-top fw-bold small #{day.date===state.today?'bg-primary text-white':'bg-light'}">
                                <div t-esc="day.label"/><div t-esc="day.date"/>
                            </div>
                            <div class="border border-top-0 rounded-bottom bg-light" style="max-height:55vh;overflow-y:auto;min-height:200px">
                                <t t-if="filteredDayCards[day_index] and filteredDayCards[day_index].length">
                                    <t t-foreach="filteredDayCards[day_index]" t-as="card" t-key="card.departure_id">
                                        <div class="bg-white m-1 rounded shadow-sm position-relative" t-on-click="() => this.openLane(card.id)" style="cursor:pointer">
                                            <span class="position-absolute top-0 end-0 p-1 text-danger cursor-pointer fw-bold"
                                                  t-on-click.stop="() => this.removeDeparture(card.departure_id)" style="cursor:pointer;z-index:2"
                                                  title="Remove departure">×</span>
                                            <div t-attf-class="p-1 #{this.statusColor(card.status)==='success'?'bg-success':this.statusColor(card.status)==='warning'?'bg-warning':this.statusColor(card.status)==='danger'?'bg-danger':this.statusColor(card.status)==='dark'?'bg-dark':this.statusColor(card.status)==='purple'?'bg-purple':'bg-info'} text-white text-center fw-bold small"
                                                 t-esc="card.status_label"/>
                                            <div class="px-2 pt-1 fw-bold small" t-esc="card.route"/>
                                            <div class="px-2 pb-2 small">
                                                <div class="d-flex justify-content-between" t-if="card.driver"><span class="text-muted">Driver</span><span t-esc="card.driver"/></div>
                                                <div class="d-flex justify-content-between" t-if="card.equipment"><span class="text-muted">Equip</span><span t-esc="card.equipment"/></div>
                                                <div class="mt-1">
                                                    <div class="d-flex justify-content-between small"><span>Peak <strong t-esc="card.booked_pallets+' / '+card.max_pallets+' Pallets'"/></span><span t-esc="Math.round(card.booked_pallets/Math.max(card.max_pallets,1)*100)+'%'"/></div>
                                                    <div class="progress" style="height:5px"><div t-attf-class="progress-bar #{Math.round(card.booked_pallets/Math.max(card.max_pallets,1)*100)>=100?'bg-danger':Math.round(card.booked_pallets/Math.max(card.max_pallets,1)*100)>=80?'bg-warning':'bg-success'}" t-attf-style="width:#{Math.round(card.booked_pallets/Math.max(card.max_pallets,1)*100)}%"/></div>
                                                    <div class="d-flex justify-content-between small text-muted" t-if="card.total_handled"><span>Total</span><span t-esc="card.total_handled+' Pallets'"/></div>
                                                </div>
                                                <div class="d-flex justify-content-between"><span class="text-muted">Revenue</span><span t-esc="'$'+(card.revenue_target||0).toLocaleString()"/></div>
                                                <div class="d-flex justify-content-between fw-bold"><span class="text-muted">NET</span><span t-attf-class="#{(card.net_profit||0)>=0?'text-success':'text-danger'}" t-esc="'$'+(card.net_profit||0).toLocaleString()"/></div>
                                                <div class="d-flex justify-content-between" t-if="card.countdown"><span class="text-muted">Leaves In</span><strong t-esc="card.countdown"/></div>
                                                <div class="d-flex justify-content-between"><span class="text-muted">Stops</span><span t-esc="(card.stop_count||0)"/></div>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <!-- + Add button for each day -->
                                <div class="text-center p-2" t-if="state.selectedTruckId">
                                    <button class="btn btn-sm btn-outline-secondary w-100" t-on-click="() => this.openAddDialog(day_index)">+</button>
                                </div>
                                <t t-if="!state.selectedTruckId">
                                    <div class="p-3 text-center text-muted small py-4">Select a truck above</div>
                                </t>
                            </div>
                            <!-- Day Summary -->
                            <t t-set="sum" t-value="daySummary(day_index)"/>
                            <div class="bg-light rounded-bottom p-1 mt-1 small text-center border" t-if="sum.count">
                                <div><strong t-esc="sum.totalBooked"/> / <strong t-esc="sum.totalCap"/> Pallets (<strong t-esc="sum.pct"/>%)</div>
                                <div>Need <strong t-esc="sum.need"/> Pallets</div>
                                <t t-if="sum.delayed"><span class="text-danger">Delayed <strong t-esc="sum.delayed"/></span></t>
                                <t t-if="sum.cancelled"><span class="text-dark ms-2">Cancelled <strong t-esc="sum.cancelled"/></span></t>
                            </div>
                        </div>
                    </t>
                </div>
                <!-- Add Corridor Dialog -->
                <div class="modal d-block" tabindex="-1" t-if="state.showAddDialog" style="background:rgba(0,0,0,0.5)">
                    <div class="modal-dialog modal-sm"><div class="modal-content">
                        <div class="modal-header"><h6 class="modal-title">Add Lane</h6><button class="btn-close" t-on-click="() => this.cancelAdd()"/></div>
                        <div class="modal-body">
                            <select class="form-select o_add_corridor_select">
                                <t t-foreach="state.corridors" t-as="c" t-key="c.id">
                                    <option t-att-value="c.id" t-esc="c.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary btn-sm" t-on-click="() => this.cancelAdd()">Cancel</button>
                            <button class="btn btn-primary btn-sm" t-on-click="() => this.confirmAdd()">Add</button>
                        </div>
                    </div></div>
                </div>
            </t>
        </div>
        <style>
            .bg-purple{background-color:#6f42c1!important;}
        </style>
    </t>
</templates>
