<?xml version="1.0" encoding="utf-8"?>
<templates>
<t t-name="prema_logistics_booking.WhereWeGoAction">
    <div class="d-flex h-100">
        <div class="border-end p-3" style="width: 380px; flex-shrink: 0; overflow-y: auto;">
            <h4 class="mb-1">Where We Go</h4>
            <p class="small text-muted">Choose a pickup to see every configured LTL destination. Prices are not shown here.</p>
            <label class="form-label">Pickup Point</label>
            <select class="form-select mb-3" t-on-change="(event) => this.onSelectOrigin(event.target.value)">
                <option value="">Select a pickup...</option>
                <t t-foreach="state.hubs" t-as="hub" t-key="hub.key">
                    <option t-att-value="hub.key">HUB — <t t-esc="hub.public_name || hub.name"/></option>
                </t>
                <t t-foreach="state.origins" t-as="origin" t-key="origin.key">
                    <option t-att-value="origin.key"><t t-esc="origin.name"/></option>
                </t>
            </select>

            <div t-if="state.loadingDestinations" class="text-muted">
                <span class="spinner-border spinner-border-sm me-2" role="status"/>Loading destinations...
            </div>
            <div t-elif="!state.selectedOriginKey" class="text-muted">Select a pickup to see destination lines.</div>
            <div t-else="">
                <h6 class="mt-2 mb-2">Configured Destinations</h6>
                <div t-if="!state.destinations.length" class="alert alert-warning">No complete corridor topology is configured from this pickup.</div>
                <t t-foreach="state.destinations" t-as="destination" t-key="destination.region_id">
                    <button type="button"
                            t-att-class="'btn text-start w-100 border rounded p-2 mb-2 ' + (state.selectedDestinationId === destination.region_id ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.onSelectDestination(destination)">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong t-esc="destination.region_name"/>
                            <span t-if="destination.status === 'direct'" class="badge bg-success">Direct</span>
                            <span t-else="" class="badge bg-info text-dark">Via Hub</span>
                        </div>
                        <div t-if="destination.bookable" class="small mt-1">
                            <t t-foreach="destination.legs" t-as="leg" t-key="leg_index">
                                <div>
                                    Leg <t t-esc="leg_index + 1"/>:
                                    <t t-esc="leg.departure_date"/> at <t t-esc="formatDepartureTime(leg.departure_time)"/>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="small mt-1 text-muted" t-esc="getReasonText(destination.reason)"/>
                    </button>
                </t>
            </div>
        </div>
        <div class="flex-fill position-relative p-3">
            <div t-if="state.mapError" class="alert alert-danger" t-esc="state.mapError"/>
            <div t-ref="map" class="w-100 h-100 border rounded" style="min-height: 520px;"/>
        </div>
    </div>
</t>
</templates>
