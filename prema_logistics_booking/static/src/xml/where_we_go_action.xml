<?xml version="1.0" encoding="utf-8"?>
<templates>
<t t-name="prema_logistics_booking.WhereWeGoAction">
<div style="display:flex;height:100%">
<div style="width:360px;min-width:360px;background:#fff;overflow-y:auto;border-right:1px solid #dee2e6">
<div style="padding:16px 20px;background:#1a73e8;color:#fff"><h3 style="margin:0">Where We Go</h3><p style="margin:4px 0 0;font-size:13px;opacity:.9">Select pickup and delivery regions to view routes and schedule.</p></div>
<div style="padding:16px 20px">
<div class="mb-3"><label class="form-label fw-bold">Pickup Region</label>
<select class="form-select" t-model="state.oid">
<option value="0">-- Select Pickup --</option>
<t t-foreach="state.regions" t-as="r" t-key="r.id">
<option t-att-value="r.id"><t t-esc="r.display_number or r.id"/>. <t t-esc="r.name"/> - <t t-esc="r.main_city or ''"/></option>
</t></select></div>
<div class="mb-3"><label class="form-label fw-bold">Delivery Region</label>
<select class="form-select" t-model="state.did">
<option value="0">-- Select Delivery --</option>
<t t-foreach="validDestinations" t-as="r" t-key="r.id">
<option t-att-value="r.id"><t t-esc="r.display_number or r.id"/>. <t t-esc="r.name"/> - <t t-esc="r.main_city or ''"/></option>
</t></select></div>
<button class="btn btn-secondary btn-sm" t-on-click="reset">Reset</button></div>
<div style="padding:16px 20px;border-top:1px solid #dee2e6" t-if="routeInfo">
<div class="alert alert-success mb-2"><strong><t t-esc="routeInfo.type"/></strong></div>
<p class="mb-1"><strong>Pickup:</strong> <t t-esc="routeInfo.origin.name"/> - <t t-esc="routeInfo.origin.main_city or ''"/></p>
<p class="mb-1"><strong>Delivery:</strong> <t t-esc="routeInfo.destination.name"/> - <t t-esc="routeInfo.destination.main_city or ''"/></p>
<t t-if="routeInfo.service"><p class="mb-1"><strong>Service Day:</strong> <t t-esc="routeInfo.service.weekday or 'Scheduled'"/></p>
<p class="mb-1"><strong>Weekly Service:</strong> <t t-esc="routeInfo.service.name"/></p></t>
<t t-if="routeInfo.departure"><p class="mb-1"><strong>Next Departure:</strong> <t t-esc="routeInfo.departure.date"/></p></t>
<p class="mb-1"><strong>Frequency:</strong> Weekly</p>
<t t-if="routeInfo.lane"><p class="mb-1"><strong>Road Distance:</strong> <t t-esc="routeInfo.lane.road_km"/> km</p></t>
<div class="mt-3"><a href="#" class="btn btn-primary btn-sm me-2">Check Price</a><a href="#" class="btn btn-outline-primary btn-sm">Book Shipment</a></div></div>
<div style="padding:16px 20px;color:#999;font-size:13px" t-else="">Select origin and destination to see route details.</div></div>
<div class="flex-grow-1" style="min-width:0" id="wwg_map_inner"/>
</div></t></templates>
