<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Warehouse operator: no commercial records.

         **Global** rules (no group on the rule) with a domain conditional on
         membership of the operator role. Odoo combines rules as
         AND(global_domains + [OR(group_domains)]) in ir.rule._compute_domain,
         so an operator matches no record and cannot be put back by any other
         rule, while for everybody else [(1, '=', 1)] is a genuine no-op that
         leaves their existing rules (company rules included) exactly as they
         were.

         No change to base.group_user; no code on core Sales or Accounting.
         ================================================================ -->
    <data>

        <record id="rule_pfl_operator_no_sale_order" model="ir.rule">
            <field name="name">PF Logistics warehouse operator: no sale.order</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('id', '=', 0)] if user.has_group('prema_logistics_booking.group_pfl_warehouse_operator') else [(1, '=', 1)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

