<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_logistics_booking" model="ir.sequence">
            <field name="name">Logistics Booking Number</field>
            <field name="code">logistics.booking</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
        <record id="seq_logistics_custom_quote" model="ir.sequence">
            <field name="name">Custom Quote Number</field>
            <field name="code">logistics.custom.quote</field>
            <field name="prefix">CQ-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
    </data>
</odoo>
