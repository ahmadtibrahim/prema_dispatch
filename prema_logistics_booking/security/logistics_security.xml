<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_logistics_pricing" model="ir.module.category">
            <field name="name">Logistics Pricing</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_logistics_pricing_viewer" model="res.groups">
            <field name="name">Pricing Viewer</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="comment">Read-only access to regions/FSAs/lanes/services/schedules — for
                support staff who need to explain a price or serviceability answer.</field>
        </record>

        <record id="group_logistics_pricing_manager" model="res.groups">
            <field name="name">Pricing Manager</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="implied_ids" eval="[(4, ref('group_logistics_pricing_viewer'))]"/>
            <field name="comment">Can edit lanes, service levels, service offerings, schedules,
                and holiday calendars. Region/FSA geography stays Administrator-only.</field>
        </record>

        <record id="group_logistics_booking_manager" model="res.groups">
            <field name="name">Booking Manager</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="implied_ids" eval="[(4, ref('group_logistics_pricing_viewer'))]"/>
            <field name="comment">Manages bookings/quotes on behalf of customers. No rate-table
                write access. (Booking models arrive in a later phase.)</field>
        </record>

        <record id="group_logistics_pricing_administrator" model="res.groups">
            <field name="name">Pricing Administrator</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="implied_ids" eval="[(4, ref('group_logistics_pricing_manager'))]"/>
            <field name="comment">Full control, including region/FSA/equipment-profile
                structural changes.</field>
        </record>

        <record id="group_booking_beta_tester" model="res.groups">
            <field name="name">Booking Beta Tester</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="comment">Portal-side group. Bypasses the
                logistics_booking.portal_enabled hidden-development gate.
                Does NOT bypass customer ownership, pricing approval, or any
                other ACL/record rule -- only the hidden-development gate.</field>
        </record>

        <record id="group_logistics_customer" model="res.groups">
            <field name="name">Logistics Customer</field>
            <field name="category_id" ref="module_category_logistics_pricing"/>
            <field name="comment">Approved customer portal access. Granted/revoked
                together with res.partner.logistics_pricing_status by
                action_approve_logistics_pricing()/action_block_logistics_pricing()
                -- never assign this group manually without also setting the
                status field.</field>
        </record>

        <!-- Record rules: scoped ONLY to group_logistics_customer via the
             groups field, so staff/admin users are entirely unaffected by
             these rules (their access is governed by ACLs + the manager/
             administrator groups above, not by these customer-ownership
             rules). -->
        <record id="rule_logistics_booking_customer_own" model="ir.rule">
            <field name="name">Logistics Booking: customer sees only own company's bookings</field>
            <field name="model_id" ref="model_logistics_booking"/>
            <field name="domain_force">[('commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_customer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        <record id="rule_logistics_pricing_session_customer_own" model="ir.rule">
            <field name="name">Pricing Session: customer sees only own sessions</field>
            <field name="model_id" ref="model_logistics_pricing_session"/>
            <field name="domain_force">[('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_customer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Phase V3: Ownership rules for child models — prevent cross-tenant access -->
        <record id="rule_logistics_booking_line_customer_own" model="ir.rule">
            <field name="name">Booking Line: customer sees only own company's lines</field>
            <field name="model_id" ref="model_logistics_booking_line"/>
            <field name="domain_force">[('booking_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_customer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        <record id="rule_logistics_booking_stop_customer_own" model="ir.rule">
            <field name="name">Booking Stop: customer sees only own company's stops</field>
            <field name="model_id" ref="model_logistics_booking_stop"/>
            <field name="domain_force">[('booking_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_customer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        <record id="rule_logistics_booking_leg_customer_own" model="ir.rule">
            <field name="name">Booking Leg: customer sees only own company's legs</field>
            <field name="model_id" ref="model_logistics_booking_leg"/>
            <field name="domain_force">[('booking_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_customer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>
</odoo>
