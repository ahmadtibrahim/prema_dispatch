<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_service_level_list" model="ir.ui.view">
        <field name="name">logistics.service.level.list</field>
        <field name="model">logistics.service.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="max_transit_hours"/>
                <field name="reefer_food_eligible"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_service_level_form" model="ir.ui.view">
        <field name="name">logistics.service.level.form</field>
        <field name="model">logistics.service.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="max_transit_hours"/>
                        <field name="reefer_food_eligible"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_logistics_service_level" model="ir.actions.act_window">
        <field name="name">Service Levels</field>
        <field name="res_model">logistics.service.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
