<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_logistics_network_map" model="ir.actions.act_url">
        <field name="name">Network Map</field>
        <field name="url">/logistics/network-map</field>
        <field name="target">self</field>
    </record>
    <record id="action_logistics_price_matrix" model="ir.actions.act_url">
        <field name="name">Price Matrix</field>
        <field name="url">/logistics/price-matrix</field>
        <field name="target">self</field>
    </record>

<!-- ======== NETWORK MAP PAGE ======== -->
<template id="logistics_network_map_page" name="Logistics Network Map">
    <t t-call="web.layout">
        <t t-set="head">
            <title>Prema Logistics — Network Map</title>
            <meta name="viewport" content="width=device-width,initial-scale=1"/>
        </t>
        <div class="container-fluid py-3">
            <!-- Phase Header -->
            <div class="alert alert-primary mb-3 text-center">
                <h4 class="mb-1">CURRENT NETWORK: PHASE <t t-esc="phase"/> </h4>
                <span t-esc="truck_count"/> OPERATIONAL TRUCK<t t-esc="'S' if truck_count != 1 else ''"/>
                <t t-if="trucks">
                    <br/><small t-esc="', '.join(trucks)"/>
                </t>
            </div>

            <div class="row">
                <!-- Region Grid -->
                <div class="col-md-9">
                    <h5>Network Map — Click a Region</h5>
                    <div class="row g-2">
                        <t t-foreach="regions" t-as="r">
                            <div class="col-md-4 col-lg-3">
                                <a t-attf-href="#region-#{r['code']}" class="card text-decoration-none mb-2"
                                   t-att-class="'card text-decoration-none mb-2 border-' + ('success' if r['active'] else 'secondary')"
                                   style="cursor:pointer">
                                    <div class="card-body py-2 px-3">
                                        <strong t-esc="r['name']"/>
                                        <br/><small class="text-muted" t-esc="r['code']"/>
                                        <t t-if="r['lanes_out'] > 0">
                                            <br/><span class="badge bg-info" t-esc="str(r['lanes_out']) + ' destinations'"/>
                                        </t>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Lane Detail Panel -->
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-header fw-bold">Lane Detail</div>
                        <div class="card-body" id="lane-detail">
                            <p class="text-muted">Click a region to see its active lanes and pricing.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>

<!-- ======== PRICE MATRIX PAGE ======== -->
<template id="logistics_price_matrix_page" name="Logistics Price Matrix">
    <t t-call="web.layout">
        <t t-set="head">
            <title>Prema Logistics — Price Matrix</title>
            <meta name="viewport" content="width=device-width,initial-scale=1"/>
        </t>
        <div class="container-fluid py-3">
            <div class="alert alert-primary mb-3 text-center">
                <h4 class="mb-1">NETWORK PRICING — PHASE <t t-esc="phase"/> </h4>
                <span t-esc="truck_count"/> OPERATIONAL TRUCK<t t-esc="'S' if truck_count != 1 else ''"/>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th class="bg-light">FROM \\ TO</th>
                            <t t-foreach="region_codes" t-as="rc">
                                <th class="bg-light small text-center" t-esc="rc"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="region_codes" t-as="row_code">
                            <tr>
                                <th class="bg-light small" t-esc="row_code"/>
                                <t t-foreach="region_codes" t-as="col_code">
                                    <t t-set="cell" t-value="matrix.get(row_code, {}).get(col_code, {})"/>
                                    <t t-if="row_code == col_code">
                                        <td class="text-center text-muted bg-light">—</td>
                                    </t>
                                    <t t-elif="cell and cell.get('active')">
                                        <td class="text-center p-1"
                                            t-att-bgcolor="'#d4edda' if cell.get('phase_ok') else '#fff3cd'">
                                            <a t-attf-href="/web#model=logistics.rate.plan&amp;view_type=list&amp;domain=[('service_offering_id.lane_id.origin_region_id.code','=','#{row_code}'),('service_offering_id.lane_id.destination_region_id.code','=','#{col_code}')]"
                                               class="text-decoration-none" target="_blank">
                                                <small t-esc="cell.get('schedule_day','')"/>
                                                <br/><strong t-esc="'$%.0f' % cell.get('target',0)"/>
                                            </a>
                                        </td>
                                    </t>
                                    <t t-elif="cell">
                                        <td class="text-center text-muted small p-1">
                                            <t t-esc="'$%.0f' % cell.get('target',0)"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td class="text-center text-muted small p-1">—</td>
                                    </t>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="mt-3 small text-muted">
                <span class="badge bg-success">GREEN</span> = Bookable current phase
                <span class="badge bg-warning text-dark">YELLOW</span> = Configured / future phase
                <span class="badge bg-light">GREY</span> = Not configured
            </div>
            <p class="mt-2">
                <a t-attf-href="/web#model=logistics.rate.plan&amp;view_type=list" class="btn btn-sm btn-outline-primary" target="_blank">
                    View All Rate Plans
                </a>
            </p>
        </div>
    </t>
</template>

</odoo>
