<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_fsa_zone_list" model="ir.ui.view">
        <field name="name">logistics.fsa.zone.list</field>
        <field name="model">logistics.fsa.zone</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_logistics_fsa_zone" model="ir.actions.act_window">
        <field name="name">FSA Zones</field>
        <field name="res_model">logistics.fsa.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
