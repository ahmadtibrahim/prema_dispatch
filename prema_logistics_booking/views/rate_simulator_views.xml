<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_rate_simulator_form" model="ir.ui.view">
        <field name="name">logistics.rate.simulator.form</field>
        <field name="model">logistics.rate.simulator</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="pickup_postal_code"/>
                        <field name="delivery_postal_code"/>
                        <field name="pallets"/>
                        <field name="weight_lbs"/>
                    </group>
                    <group>
                        <field name="shipment_type"/>
                        <field name="temperature_mode"/>
                        <field name="liftgate_pickup"/>
                        <field name="liftgate_delivery"/>
                        <field name="appointment"/>
                        <field name="residential"/>
                        <field name="same_day_requested"/>
                        <field name="partner_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_simulate" type="object" string="Simulate" class="btn-primary"/>
                </footer>
                <field name="result_text" widget="text" readonly="1" invisible="not result_text"/>
            </form>
        </field>
    </record>
    <record id="action_logistics_rate_simulator" model="ir.actions.act_window">
        <field name="name">Rate Simulator</field>
        <field name="res_model">logistics.rate.simulator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_logistics_schedule_simulator_form" model="ir.ui.view">
        <field name="name">logistics.schedule.simulator.form</field>
        <field name="model">logistics.schedule.simulator</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="pickup_postal_code"/>
                    <field name="delivery_postal_code"/>
                    <field name="temperature_mode"/>
                    <field name="shipment_type"/>
                    <field name="reference_datetime"/>
                </group>
                <footer>
                    <button name="action_simulate" type="object" string="Simulate" class="btn-primary"/>
                </footer>
                <field name="result_text" widget="text" readonly="1" invisible="not result_text"/>
            </form>
        </field>
    </record>
    <record id="action_logistics_schedule_simulator" model="ir.actions.act_window">
        <field name="name">Schedule Simulator</field>
        <field name="res_model">logistics.schedule.simulator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
