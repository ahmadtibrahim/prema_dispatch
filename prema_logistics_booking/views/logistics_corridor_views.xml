<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_corridor_list" model="ir.ui.view">
        <field name="name">logistics.corridor.list</field>
        <field name="model">logistics.corridor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="direction"/>
                <field name="operating_days_display" string="Every Week"/>
                <field name="start_time" widget="float_time"/>
                <field name="default_vehicle_id"/>
                <field name="equipment_type"/>
                <field name="rate_per_km" string="$ / km"/>
                <field name="planned_pallets"/>
                <field name="full_distance_km"/>
                <field name="full_revenue_target" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_corridor_form" model="ir.ui.view">
        <field name="name">logistics.corridor.form</field>
        <field name="model">logistics.corridor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculate_route_distance" string="Calculate Route Distance" type="object" class="btn-secondary"/>
                    <button name="action_refresh_departures" string="Refresh Next 8 Weeks" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="equipment_type"/>
                            <field name="default_vehicle_id" string="Default Truck"/>
                            <field name="active"/>
                        </group>
                        <group string="Weekly Departure">
                            <field name="operating_days_display" readonly="1"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="destination_hub_arrival_time" widget="float_time"
                                   invisible="not same_day_return and not destination_hub_id"/>
                            <field name="overnight"/>
                            <field name="departure_horizon_weeks" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route">
                            <group>
                                <group string="Hub &amp; Direction">
                                    <field name="origin_hub_id" options="{'no_create': True}"/>
                                    <field name="destination_hub_id" options="{'no_create': True}"/>
                                    <field name="transfer_hub_id" options="{'no_create': True}"/>
                                    <field name="same_day_return"/>
                                    <field name="paired_return_service_id" domain="[('id','!=',id)]"/>
                                    <field name="is_two_way" readonly="1"/>
                                </group>
                                <group string="Every Week">
                                    <field name="operate_monday"/>
                                    <field name="operate_tuesday"/>
                                    <field name="operate_wednesday"/>
                                    <field name="operate_thursday"/>
                                    <field name="operate_friday"/>
                                    <field name="operate_saturday"/>
                                    <field name="operate_sunday" readonly="1"/>
                                    <field name="holiday_calendar_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Two-Way Service is derived from an exact paired reverse corridor. It does not make this record operate both directions.
                            </div>
                        </page>
                        <page string="Ordered Regions">
                            <div class="alert alert-info" role="alert">
                                Origin and Destination Hubs are automatic route endpoints. List only the approved customer-facing regions here, in actual driving order.
                            </div>
                            <field name="stop_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="region_id" domain="[('is_official_ltl_region','=',True)]"/>
                                    <field name="name" optional="hide"/>
                                    <field name="saved_location_id" optional="show"/>
                                    <field name="pickup_allowed"/>
                                    <field name="delivery_allowed"/>
                                    <field name="distance_from_origin_km" string="Distance from Start (km)"/>
                                    <field name="day_offset"/>
                                    <field name="planned_arrival_time" widget="float_time" optional="show"/>
                                    <field name="planned_departure_time" widget="float_time" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Departures">
                            <div class="alert alert-info" role="alert">
                                New departures inherit the Default Truck. Open any date to override only that departure; all LTL Planner jobs update automatically.
                            </div>
                            <field name="departure_ids" domain="[('departure_date', '>=', context_today())]" context="{'default_vehicle_assignment_source': 'corridor_default'}">
                                <list create="0" delete="0" default_order="departure_date,departure_time">
                                    <field name="departure_date"/>
                                    <field name="departure_time" widget="float_time"/>
                                    <field name="vehicle_id" string="Truck"/>
                                    <field name="vehicle_assignment_source"/>
                                    <field name="status"/>
                                    <field name="max_capacity" string="Truck Capacity" readonly="1"/>
                                    <field name="computed_peak_pallets" readonly="1"/>
                                    <field name="computed_peak_weight" readonly="1"/>
                                    <field name="cutoff_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer Pricing">
                            <!-- LTL Base Pricing -->
                            <group string="LTL Base Pricing">
                                <group string="Inputs">
                                    <field name="rate_per_km" string="$ / km"/>
                                    <field name="planned_pallets"/>
                                    <field name="included_weight_per_pallet"/>
                                    <field name="minimum_booking_charge" widget="monetary"/>
                                    <field name="ltl_additional_stop_charge" widget="monetary"/>
                                    <field name="excess_weight_rate_per_lb" string="Excess Weight $ / lb"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Calculated">
                                    <field name="pallet_rate_per_km" string="$ / km per Pallet" readonly="1"/>
                                    <field name="full_distance_km" readonly="1"/>
                                    <div class="text-muted" colspan="2">
                                        Full Corridor Revenue Target is informational only — not used for customer pricing.
                                    </div>
                                    <field name="full_revenue_target" widget="monetary" readonly="1"/>
                                </group>
                            </group>

                            <!-- Pallet Volume Discounts -->
                            <group string="Pallet Volume Discounts">
                                <field name="enable_volume_discounts" widget="boolean_toggle"/>
                                <field name="pallet_volume_tier_ids" invisible="enable_volume_discounts == False">
                                    <list editable="bottom" string="Pallet Tiers">
                                        <field name="min_pallets"/>
                                        <field name="max_pallets"/>
                                        <field name="discount_pct" string="Discount %"/>
                                        <field name="pricing_type"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Full Truckload -->
                            <group string="Full Truckload">
                                <field name="enable_ftl" string="Enable Full Truckload" widget="boolean_toggle"/>
                                <group invisible="enable_ftl == False">
                                    <group>
                                        <field name="ftl_threshold_pallets"/>
                                        <field name="ftl_rate_per_km" string="FTL $ / km"/>
                                    </group>
                                    <group>
                                        <field name="ftl_reserve_entire_truck"/>
                                        <field name="ftl_behavior" string="When threshold reached"/>
                                    </group>
                                </group>
                            </group>

                            <!-- FTL Regional Pricing — page-level group, same
                                 full-width pattern as Pallet Volume Discounts
                                 (a single-child inner group spans both grid
                                 tracks; the list never sits in a nested cell) -->
                            <div class="text-muted" invisible="enable_ftl == False">
                                Optional FTL lane overrides. Leave blank to use the corridor's default FTL $/km.
                            </div>
                            <group string="FTL Regional Pricing" invisible="enable_ftl == False">
                                <field name="ftl_regional_minimum_ids" nolabel="1">
                                    <list editable="bottom" string="FTL Regional Pricing">
                                        <field name="sequence" widget="handle"/>
                                        <field name="origin_region_id" options="{'no_create': True}"/>
                                        <field name="destination_region_id" options="{'no_create': True}"/>
                                        <field name="pricing_type"/>
                                        <!-- Both columns stay visible: Odoo 18 evaluates
                                             column_invisible without a row context inside
                                             embedded one2many lists and crashes the form.
                                             Backend validation enforces per-type values. -->
                                        <field name="flat_rate" widget="monetary"/>
                                        <field name="ftl_rate_per_km_override"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Transit / Feeder Pricing -->
                            <group string="Transit / Feeder Pricing">
                                <field name="enable_transit_pricing" widget="boolean_toggle"/>
                                <group invisible="enable_transit_pricing == False">
                                    <group>
                                        <field name="feeder_pricing_method" string="Pricing Method"/>
                                        <field name="feeder_discount_pct" string="Feeder Discount %" invisible="feeder_pricing_method != 'percentage'"/>
                                        <field name="feeder_rate_per_km" string="Feeder $/km Override" invisible="feeder_pricing_method != 'dedicated_km'"/>
                                        <field name="feeder_minimum_charge" widget="monetary"/>
                                    </group>
                                    <group string="Allowed Feeder Regions">
                                        <field name="allowed_feeder_region_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_corridor_departure_form" model="ir.ui.view">
        <field name="name">logistics.corridor.departure.form</field>
        <field name="model">logistics.corridor.departure</field>
        <field name="arch" type="xml">
            <form string="Open: Departure">
                <sheet>
                    <group>
                        <group>
                            <field name="corridor_id" readonly="1"/>
                            <field name="departure_date" readonly="status != 'scheduled'"/>
                            <field name="vehicle_id" string="Truck" readonly="status != 'scheduled'"/>
                            <field name="vehicle_assignment_source" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="departure_time" widget="float_time" readonly="status != 'scheduled'"/>
                            <field name="status"/>
                            <field name="cutoff_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Vehicle Capacity" col="4">
                        <field name="max_capacity" readonly="1"/>
                        <field name="computed_peak_pallets" readonly="1"/>
                        <field name="computed_total_handled" readonly="1"/>
                        <field name="computed_peak_weight" readonly="1"/>
                    </group>
                    <group string="Pallet Capacity &amp; Layout" col="6">
                        <field name="capacity_layout_code" readonly="1"/>
                        <field name="capacity_layout_name" readonly="1"/>
                        <field name="capacity_max_pallets" readonly="1"/>
                        <field name="capacity_reserved_pallets" readonly="1"/>
                        <field name="capacity_remaining_pallets" readonly="1"/>
                        <field name="capacity_layout_override_id"
                               domain="[('vehicle_id', '=', vehicle_id), ('active', '=', True)]"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Sellable Capacity (Shared LTL + FTL Exclusivity)" col="6">
                        <div class="alert alert-warning" role="alert"
                             invisible="not exclusive_vehicle_reserved">
                            <i class="fa fa-lock me-1"/>
                            <b>Truck exclusively reserved</b> — Full Truckload /
                            dedicated booking <field name="exclusive_booking_ref"
                                                     nolabel="1" readonly="1" class="d-inline"/>
                            owns the entire vehicle; no other booking may join.
                        </div>
                        <field name="exclusive_vehicle_reserved" readonly="1"/>
                        <field name="exclusive_booking_ref" readonly="1"/>
                        <field name="reserved_ltl_positions" readonly="1"/>
                        <field name="planned_peak_onboard" readonly="1"/>
                        <field name="vehicle_max_bookable_positions" readonly="1"/>
                        <field name="remaining_sellable_capacity" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_logistics_corridor" model="ir.actions.act_window">
        <field name="name">Corridors</field>
        <field name="res_model">logistics.corridor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
