<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_corridor_list" model="ir.ui.view">
        <field name="name">logistics.corridor.list</field>
        <field name="model">logistics.corridor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="direction"/>
                <field name="operating_days_display" string="Every Week"/>
                <field name="start_time" widget="float_time"/>
                <field name="default_vehicle_id"/>
                <field name="equipment_type"/>
                <field name="rate_per_km" string="$ / km"/>
                <field name="planned_pallets"/>
                <field name="full_distance_km"/>
                <field name="full_revenue_target" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_corridor_form" model="ir.ui.view">
        <field name="name">logistics.corridor.form</field>
        <field name="model">logistics.corridor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculate_route_distance" string="Calculate Route Distance" type="object" class="btn-secondary"/>
                    <button name="action_refresh_departures" string="Refresh Next 8 Weeks" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="equipment_type"/>
                            <field name="default_vehicle_id" string="Default Truck"/>
                            <field name="active"/>
                        </group>
                        <group string="Weekly Departure">
                            <field name="operating_days_display" readonly="1"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="destination_hub_arrival_time" widget="float_time"
                                   invisible="not same_day_return and not destination_hub_id"/>
                            <field name="overnight"/>
                            <field name="departure_horizon_weeks" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route">
                            <group>
                                <group string="Hub &amp; Direction">
                                    <field name="origin_hub_id" options="{'no_create': True}"/>
                                    <field name="destination_hub_id" options="{'no_create': True}"/>
                                    <field name="transfer_hub_id" options="{'no_create': True}"/>
                                    <field name="same_day_return"/>
                                    <field name="paired_return_service_id" domain="[('id','!=',id)]"/>
                                    <field name="is_two_way" readonly="1"/>
                                </group>
                                <group string="Every Week">
                                    <field name="operate_monday"/>
                                    <field name="operate_tuesday"/>
                                    <field name="operate_wednesday"/>
                                    <field name="operate_thursday"/>
                                    <field name="operate_friday"/>
                                    <field name="operate_saturday"/>
                                    <field name="operate_sunday" readonly="1"/>
                                    <field name="holiday_calendar_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Two-Way Service is derived from an exact paired reverse corridor. It does not make this record operate both directions.
                            </div>
                        </page>
                        <page string="Ordered Regions">
                            <div class="alert alert-info" role="alert">
                                Origin and Destination Hubs are automatic route endpoints. List only the approved customer-facing regions here, in actual driving order.
                            </div>
                            <field name="stop_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="region_id" domain="[('is_official_ltl_region','=',True)]"/>
                                    <field name="name" optional="hide"/>
                                    <field name="saved_location_id" optional="show"/>
                                    <field name="pickup_allowed"/>
                                    <field name="delivery_allowed"/>
                                    <field name="distance_from_origin_km" string="Distance from Start (km)"/>
                                    <field name="day_offset"/>
                                    <field name="planned_arrival_time" widget="float_time" optional="show"/>
                                    <field name="planned_departure_time" widget="float_time" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Departures">
                            <div class="alert alert-info" role="alert">
                                New departures inherit the Default Truck. Open any date to override only that departure; all LTL Planner jobs update automatically.
                            </div>
                            <field name="departure_ids" domain="[('departure_date', '>=', context_today())]" context="{'default_vehicle_assignment_source': 'corridor_default'}">
                                <list create="0" delete="0" default_order="departure_date,departure_time">
                                    <field name="departure_date"/>
                                    <field name="departure_time" widget="float_time"/>
                                    <field name="vehicle_id" string="Truck"/>
                                    <field name="vehicle_assignment_source"/>
                                    <field name="status"/>
                                    <field name="max_capacity" string="Truck Capacity" readonly="1"/>
                                    <field name="computed_peak_pallets" readonly="1"/>
                                    <field name="computed_peak_weight" readonly="1"/>
                                    <field name="cutoff_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer Pricing">
                            <div class="alert alert-info" role="alert">
                                Corridor pricing is the only active LTL pricing source. The $150 minimum is applied once per complete booking, including hub transfers.
                            </div>
                            <group>
                                <group string="Inputs">
                                    <field name="rate_per_km" string="$ / km"/>
                                    <field name="planned_pallets"/>
                                    <field name="included_weight_per_pallet"/>
                                    <field name="minimum_booking_charge" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Calculated">
                                    <field name="pallet_rate_per_km" string="$ / km per Pallet" readonly="1"/>
                                    <field name="full_distance_km" readonly="1"/>
                                    <field name="destination_hub_distance_km" readonly="1" invisible="not destination_hub_id"/>
                                    <field name="full_revenue_target" widget="monetary" readonly="1"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Customer leg price = distance × booked pallets × ($/km ÷ planned pallets), plus excess weight when applicable.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_corridor_departure_form" model="ir.ui.view">
        <field name="name">logistics.corridor.departure.form</field>
        <field name="model">logistics.corridor.departure</field>
        <field name="arch" type="xml">
            <form string="Open: Departure">
                <sheet>
                    <group>
                        <group>
                            <field name="corridor_id" readonly="1"/>
                            <field name="departure_date" readonly="status != 'scheduled'"/>
                            <field name="vehicle_id" string="Truck" readonly="status != 'scheduled'"/>
                            <field name="vehicle_assignment_source" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="departure_time" widget="float_time" readonly="status != 'scheduled'"/>
                            <field name="status"/>
                            <field name="cutoff_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Vehicle Capacity" col="4">
                        <field name="max_capacity" readonly="1"/>
                        <field name="computed_peak_pallets" readonly="1"/>
                        <field name="computed_total_handled" readonly="1"/>
                        <field name="computed_peak_weight" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_logistics_corridor" model="ir.actions.act_window">
        <field name="name">Corridors</field>
        <field name="res_model">logistics.corridor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
