<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.logistics.tax</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Prema Logistics" string="Prema Logistics" data-key="prema_logistics_booking">
                    <h2>Freight Tax Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_ontario_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_ontario_id"/>
                                <div class="text-muted">HST applied to freight delivered in Ontario</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_quebec_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_quebec_id"/>
                                <div class="text-muted">GST for interprovincial freight delivered in Quebec</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_quebec_gst_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_quebec_gst_id"/>
                                <div class="text-muted">GST portion for Quebec-only shipments</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_quebec_qst_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_quebec_qst_id"/>
                                <div class="text-muted">QST portion for Quebec-only shipments</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_ns_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_ns_id"/>
                                <div class="text-muted">HST applied to freight delivered in Nova Scotia</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_nb_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_nb_id"/>
                                <div class="text-muted">HST applied to freight delivered in New Brunswick</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_pei_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_pei_id"/>
                                <div class="text-muted">HST applied to freight delivered in PEI</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_nl_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_nl_id"/>
                                <div class="text-muted">HST applied to freight delivered in Newfoundland &amp; Labrador</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_gst_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_gst_id"/>
                                <div class="text-muted">GST (5%) for AB, BC, MB, SK, NT, YT, NU</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_zero_interlining_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_zero_interlining_id"/>
                                <div class="text-muted">Zero-rated tax for interlining/subcontract carriers</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_zero_international_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_zero_international_id"/>
                                <div class="text-muted">Zero-rated tax for qualifying international freight</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_freight_tax_buy_interlining_id"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_freight_tax_buy_interlining_id"/>
                                <div class="text-muted">
                                    PURCHASE-side 0% interlining tax on subcontract carrier
                                    POs / Rate Confirmations. Separate from customer SELL tax.
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Pricing Defaults</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_default_excess_weight_rate"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_default_excess_weight_rate"/>
                                <div class="text-muted">
                                    Default charge per pound over included weight.
                                    Individual corridors can override on their Customer Pricing tab.
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Night-Before Finalization</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_route_finalization_hour"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_route_finalization_hour"/>
                                <div class="text-muted">
                                    Hour at which tomorrow's departures get their
                                    itinerary finalized (stop order vs facility
                                    hours, appointments and windows). Not hardcoded.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="logistics_customer_eta_notification_hour"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="logistics_customer_eta_notification_hour"/>
                                <div class="text-muted">
                                    Hour at which customers receive their email with
                                    CONFIRMED pickup / delivery windows. Not hardcoded.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
