<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manager-only post-confirmation customer sell-price adjustment
         (logistics.booking._apply_sell_price_change is the authority).
         MUST load before the booking form view — the form's Adjust button
         references action_logistics_booking_price_adjust by %()ref. -->
    <record id="view_logistics_booking_price_adjust_form" model="ir.ui.view">
        <field name="name">logistics.booking.price.adjust.form</field>
        <field name="model">logistics.booking.price.adjust</field>
        <field name="arch" type="xml">
            <form string="Adjust Customer Sell Price">
                <group>
                    <field name="booking_id" readonly="1"/>
                    <field name="new_price"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_logistics_booking_price_adjust" model="ir.actions.act_window">
        <field name="name">Adjust Customer Sell Price</field>
        <field name="res_model">logistics.booking.price.adjust</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('prema_logistics_booking.group_logistics_booking_manager'))]"/>
    </record>

    <record id="view_logistics_booking_list" model="ir.ui.view">
        <field name="name">logistics.booking.list</field>
        <field name="model">logistics.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="booking_number"/>
                <field name="partner_id"/>
                <field name="pickup_fsa_id"/>
                <field name="delivery_fsa_id"/>
                <field name="pickup_date"/>
                <field name="estimated_delivery_date"/>
                <field name="calculated_price"/>
                <field name="state"/>
                <field name="dispatch_job_id"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_booking_form" model="ir.ui.view">
        <field name="name">logistics.booking.form</field>
        <field name="model">logistics.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Tax Review Required Banner -->
                    <field name="tax_review_required" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="not tax_review_required">
                        <strong>⚠ Tax Review Required</strong><br/>
                        <field name="tax_reason" readonly="1" nolabel="1"/>
                        <div class="mt-2">
                            Freight tax configuration is missing or incomplete.
                            This invoice cannot be posted until tax is resolved.
                            Go to <em>Settings → Prema Logistics → Freight Tax Configuration</em>
                            to configure the required tax mapping.
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="booking_number" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="movement_route_summary" readonly="1"
                                   invisible="route_model_version != 'movement_v1'"/>
                            <field name="state"/>
                            <field name="dispatch_job_id" readonly="1"/>
                            <field name="booking_channel" readonly="1"/>
                        </group>
                        <group>
                            <button name="%(action_logistics_booking_price_adjust)d" string="Adjust Customer Price"
                                    type="action" class="btn-secondary"
                                    groups="prema_logistics_booking.group_logistics_booking_manager"
                                    context="{'default_booking_id': id}"
                                    invisible="state in ('cancelled', 'completed')"/>
                            <field name="corridor_id" readonly="1"/>
                            <field name="departure_id" readonly="1"/>
                            <field name="pickup_date" readonly="1"/>
                            <field name="estimated_delivery_date" readonly="1"/>
                            <field name="calculated_price" readonly="1"/>
                            <field name="final_quoted_price" readonly="1" invisible="not manual_price_override"/>
                            <field name="system_calculated_price" readonly="1" invisible="not manual_price_override"/>
                            <field name="manual_price_adjustment" readonly="1" invisible="not manual_price_override"/>
                            <field name="manual_price_reason" readonly="1" invisible="not manual_price_override"/>
                            <field name="manual_price_changed_by" readonly="1" invisible="not manual_price_override"/>
                            <field name="manual_price_changed_at" readonly="1" invisible="not manual_price_override"/>
                            <field name="original_confirmed_price" readonly="1" invisible="not original_confirmed_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Legacy Pickup Summary"
                              invisible="route_model_version == 'movement_v1'">
                            <group>
                                <field name="pickup_fsa_id" readonly="1"/>
                                <field name="pickup_company" readonly="1"/>
                                <field name="pickup_address" readonly="1"/>
                                <field name="pickup_contact_name" readonly="1"/>
                                <field name="pickup_phone" readonly="1"/>
                                <field name="pickup_instructions" readonly="1"/>
                            </group>
                        </page>
                        <page string="Legacy Delivery Summary"
                              invisible="route_model_version == 'movement_v1'">
                            <group>
                                <field name="delivery_fsa_id" readonly="1"/>
                                <field name="delivery_company" readonly="1"/>
                                <field name="delivery_address" readonly="1"/>
                                <field name="delivery_contact_name" readonly="1"/>
                                <field name="delivery_phone" readonly="1"/>
                                <field name="delivery_instructions" readonly="1"/>
                            </group>
                        </page>
                        <page string="Shipment">
                            <group>
                                <field name="service_mode" readonly="1"/>
                                <field name="load_type" readonly="1"/>
                                <field name="equipment_requirement" readonly="1"/>
                                <field name="shipment_type" readonly="1" string="Type (Legacy)"/>
                                <field name="temperature_mode" readonly="1" string="Temp (Legacy)"/>
                                <field name="temperature_display" readonly="1"
                                       string="Temperature (dual-unit)"
                                       invisible="not temperature_supplied"/>
                                <field name="temperature_range_display" readonly="1"
                                       string="Safe Range (dual-unit)"
                                       invisible="not temperature_supplied"/>
                                <field name="temperature_supplied" readonly="1"/>
                                <field name="target_temperature_c" string="Target (°C)"
                                       invisible="not temperature_supplied"/>
                                <field name="minimum_temperature_c" string="Min (°C)"
                                       invisible="not minimum_temperature_supplied"/>
                                <field name="maximum_temperature_c" string="Max (°C)"
                                       invisible="not maximum_temperature_supplied"/>
                                <field name="temperature_tolerance_c" string="Tolerance (±°C)"
                                       invisible="not temperature_supplied"/>
                                <field name="submitted_temperature_unit" string="Submitted In"/>
                                <field name="temperature_requirement_source"/>
                                <field name="pallets" readonly="1"/>
                                <field name="weight_lbs" readonly="1"/>
                                <field name="liftgate_pickup" readonly="1"/>
                                <field name="liftgate_delivery" readonly="1"/>
                                <field name="appointment" readonly="1"/>
                            </group>
                        </page>
                        <page string="Stops &amp; Pallets" name="movement_v1_stops"
                              invisible="route_model_version != 'movement_v1'">
                            <group>
                                <field name="route_model_version" readonly="1"/>
                                <field name="movement_route_summary" readonly="1"/>
                            </group>
                            <separator string="Pickups &amp; Deliveries"/>
                            <field name="stop_ids" readonly="1" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="stop_key"/>
                                    <field name="stop_type"/>
                                    <field name="location_name"/>
                                    <field name="city"/>
                                    <field name="movement_pallet_labels"/>
                                    <field name="movement_pallet_count"/>
                                    <field name="movement_weight_lbs"/>
                                    <field name="timing_type"/>
                                    <field name="liftgate_required"/>
                                    <field name="appointment_required"/>
                                </list>
                            </field>
                            <separator string="Pallet Movements"/>
                            <field name="pallet_ids" readonly="1" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="label"/>
                                    <field name="pickup_origin_display"/>
                                    <field name="delivery_destinations_display"/>
                                    <field name="weight_lbs"/>
                                    <field name="reference"/>
                                    <field name="shared"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Route &amp; Dispatch Planner" name="route_planner">
                            <group>
                                <field name="is_multi_leg" readonly="1"/>
                                <field name="corridor_id" readonly="1"/>
                                <field name="departure_id" readonly="1"/>
                            </group>
                            <field name="leg_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="leg_type"/>
                                    <field name="origin_region_id"/>
                                    <field name="destination_region_id"/>
                                    <field name="departure_id"/>
                                    <field name="pickup_date"/>
                                    <field name="delivery_date"/>
                                    <field name="reservation_state"/>
                                    <field name="frozen_leg_price"/>
                                </list>
                            </field>
                            <separator string="Planner Day Cards"/>
                            <field name="dispatch_job_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="operation_role"/>
                                    <field name="operation_date"/>
                                    <field name="vehicle_id"/>
                                    <field name="corridor_departure_id"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tax &amp; Invoice">
                            <group>
                                <field name="tax_review_required" widget="boolean_toggle"/>
                                <field name="tax_reason" readonly="1"/>
                                <field name="billing_relationship" readonly="1"/>
                                <field name="tax_treatment" readonly="1"/>
                                <field name="tax_rule_id" readonly="1"/>
                                <field name="tax_rule_name" readonly="1"/>
                                <field name="fiscal_position_id" readonly="1"/>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="invoice_id">
                                Customer Invoice: Not created yet — created after operational completion.
                            </div>
                            <group string="Invoice Totals" invisible="not invoice_id">
                                <field name="amount_untaxed" readonly="1"/>
                                <field name="amount_tax" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                                <field name="invoice_created_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Price Snapshot (immutable)">
                            <field name="price_snapshot_display" readonly="1" widget="text"/>
                        </page>
                        <page string="Price Adjustments">
                            <field name="price_adjustment_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="old_price"/>
                                    <field name="new_price"/>
                                    <field name="adjustment_amount"/>
                                    <field name="reason"/>
                                    <field name="changed_by"/>
                                    <field name="changed_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_logistics_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">logistics.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
