<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="where_we_go_map" name="Where We Go Map">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Where We Go — Prema Dispatch</title>
                <meta name="viewport" content="width=device-width,initial-scale=1"/>
                <t t-set="google_api_key" t-value="request.env['ir.config_parameter'].sudo().get_param('google_maps_api_key','')"/>
                <script t-attf-src="https://maps.googleapis.com/maps/api/js?key=#{google_api_key}&amp;libraries=drawing" async="" defer=""/>
                <script type="text/javascript" src="/prema_logistics_booking/static/src/js/where_we_go.js"/>
            </t>
            <div style="display:flex;height:calc(100vh - 46px)">
                <div style="width:380px;min-width:380px;background:#fff;overflow-y:auto;border-right:1px solid #ddd">
                    <div style="padding:16px 20px;background:#1a73e8;color:#fff">
                        <h2 style="margin:0;font-size:20px">Where We Go</h2>
                        <p style="margin:4px 0 0;font-size:13px;opacity:.9">Select pickup and delivery regions to view available routes and schedule.</p>
                    </div>
                    <div style="padding:16px 20px">
                        <label style="font-weight:600;font-size:13px">Pickup Region</label>
                        <select id="wwg_origin" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;margin:4px 0 12px">
                            <option value="">— Select —</option>
                        </select>
                        <label style="font-weight:600;font-size:13px">Delivery Region</label>
                        <select id="wwg_dest" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;margin:4px 0 12px">
                            <option value="">— First select pickup —</option>
                        </select>
                        <button id="wwg_reset" style="padding:8px 16px;background:#eee;border:1px solid #ccc;border-radius:4px;cursor:pointer">Reset</button>
                    </div>
                    <div id="wwg_result" style="padding:16px 20px;border-top:1px solid #eee">
                        <p style="color:#999;font-size:13px">Select origin and destination to see route details.</p>
                    </div>
                </div>
                <div id="wwg_map" style="flex:1"/>
            </div>
        </t>
    </template>
</odoo>
