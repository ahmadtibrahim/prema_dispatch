<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_daily_local_list" model="ir.ui.view">
        <field name="name">logistics.daily.local.list</field>
        <field name="model">logistics.daily.local.operation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="revenue_target" widget="monetary"/>
                <field name="booked_revenue" widget="monetary"/>
                <field name="total_pallets"/>
                <field name="job_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_daily_local_form" model="ir.ui.view">
        <field name="name">logistics.daily.local.form</field>
        <field name="model">logistics.daily.local.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="corridor_id"/>
                            <field name="feeds_corridor_id"/>
                            <field name="revenue_target" widget="monetary"/>
                            <field name="booked_revenue" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="job_count"/>
                        <field name="total_stops"/>
                        <field name="total_pallets"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_logistics_daily_local" model="ir.actions.act_window">
        <field name="name">Daily Local Operations</field>
        <field name="res_model">logistics.daily.local.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
