<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ====================================================================
     Portal — My Contacts (private, per portal user)
     ==================================================================== -->

<template id="portal_my_contacts" name="Portal: My Contacts">
    <t t-call="portal.portal_layout">
        <div class="container">
            <t t-if="msg == 'created'">
                <div class="alert alert-success mt-3" role="alert">Contact saved.</div>
            </t>
            <t t-if="msg == 'saved'">
                <div class="alert alert-success mt-3" role="alert">Contact updated.</div>
            </t>
            <t t-if="msg == 'archived'">
                <div class="alert alert-info mt-3" role="alert">Contact archived. Past collections keep the details they were made with.</div>
            </t>
            <t t-if="msg == 'name_required'">
                <div class="alert alert-danger mt-3" role="alert">A name is required.</div>
            </t>
            <div class="d-flex justify-content-between align-items-center my-4">
                <h3 class="mb-0">My Contacts</h3>
                <a href="/my/contacts/new" class="btn btn-primary">Add Contact</a>
            </div>
            <div t-if="contacts" class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th><th>Type</th><th>Contact Person</th>
                            <th>Phone</th><th>Email</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="contacts" t-as="c">
                            <tr>
                                <td><a t-att-href="'/my/contacts/%s/edit' % c.id"><span t-field="c.name"/></a></td>
                                <td><span t-field="c.contact_type"/></td>
                                <td><span t-field="c.contact_person_name"/></td>
                                <td><span t-field="c.phone"/></td>
                                <td><span t-field="c.email"/></td>
                                <td class="text-end">
                                    <a t-att-href="'/my/contacts/%s/edit' % c.id" class="btn btn-sm btn-link">Edit</a>
                                    <form t-att-action="'/my/contacts/%s/archive' % c.id" method="post" class="d-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-link text-danger">Archive</button>
                                    </form>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div t-if="not contacts" class="text-center text-muted my-5">
                <p>You have no saved contacts yet.</p>
                <p class="small">Contacts you save here are private to you and can be reused on your bookings.</p>
            </div>
        </div>
    </t>
</template>

<template id="portal_my_contact_form" name="Portal: Contact Form">
    <t t-call="portal.portal_layout">
        <div class="container">
            <h3 class="my-4"><t t-if="contact">Edit Contact</t><t t-else="">Add Contact</t></h3>
            <form action="/my/contacts/save" method="post" class="col-lg-8">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input t-if="contact" type="hidden" name="contact_id" t-att-value="contact.id"/>
                <div class="mb-3">
                    <label class="form-label" for="contact_type">Type</label>
                    <select class="form-select" id="contact_type" name="contact_type">
                        <option value="company" t-att-selected="contact.contact_type == 'company'">Company / Carrier</option>
                        <option value="owner_operator" t-att-selected="contact.contact_type == 'owner_operator'">Owner-Operator</option>
                        <option value="individual" t-att-selected="contact.contact_type == 'individual'">Individual</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="name">Company / Individual Name</label>
                    <input type="text" class="form-control" id="name" name="name" required="required"
                           t-att-value="contact.name or ''"/>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contact_person_name">Contact Person</label>
                        <input type="text" class="form-control" id="contact_person_name"
                               name="contact_person_name" t-att-value="contact.contact_person_name or ''"/>
                        <div class="form-text">Optional — for a company, who to ask for.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contact_person_phone">Contact Person Phone</label>
                        <input type="text" class="form-control" id="contact_person_phone"
                               name="contact_person_phone" t-att-value="contact.contact_person_phone or ''"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="phone">Phone</label>
                        <input type="text" class="form-control" id="phone" name="phone"
                               t-att-value="contact.phone or ''"/>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" class="form-control" id="email" name="email"
                               t-att-value="contact.email or ''"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="street">Address</label>
                    <input type="text" class="form-control" id="street" name="street"
                           t-att-value="contact.street or ''"/>
                    <div class="form-text">Optional — only needed when relevant.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="city">City</label>
                    <input type="text" class="form-control" id="city" name="city"
                           t-att-value="contact.city or ''"/>
                </div>
                <div class="mb-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/my/contacts" class="btn btn-link">Cancel</a>
                </div>
            </form>
        </div>
    </t>
</template>

<template id="portal_my_home_contacts" name="Portal My Home: Contacts tile"
          inherit_id="portal.portal_my_home" priority="32">
    <xpath expr="//div[@id='portal_common_category']" position="before">
        <div class="o_portal_index_card col-md-6 order-2">
            <a href="/my/contacts" title="My Contacts" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                <div class="d-block align-self-start"><img src="/prema_logistics_booking/static/src/img/portal-saved-locations.svg" alt=""/></div>
                <div><div class="mt-0 mb-1 fs-5 fw-normal lh-1">My Contacts</div><div class="opacity-75">Your private carriers, drivers and recipients</div></div>
            </a>
        </div>
    </xpath>
</template>

</odoo>
