<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_fsa_list" model="ir.ui.view">
        <field name="name">logistics.fsa.list</field>
        <field name="model">logistics.fsa</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="fsa"/>
                <field name="province"/>
                <field name="display_city"/>
                <field name="region_id"/>
                <field name="zone_id"/>
                <field name="pickup_supported"/>
                <field name="delivery_supported"/>
                <field name="remote"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_fsa_form" model="ir.ui.view">
        <field name="name">logistics.fsa.form</field>
        <field name="model">logistics.fsa</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="fsa"/>
                        <field name="province"/>
                        <field name="display_city"/>
                        <field name="region_id"/>
                        <field name="pickup_supported"/>
                        <field name="delivery_supported"/>
                        <field name="remote"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_logistics_fsa_search" model="ir.ui.view">
        <field name="name">logistics.fsa.search</field>
        <field name="model">logistics.fsa</field>
        <field name="arch" type="xml">
            <search>
                <field name="fsa"/>
                <field name="display_city"/>
                <field name="region_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="remote" string="Remote" domain="[('remote','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_region" string="Region" context="{'group_by':'region_id'}"/>
                    <filter name="group_province" string="Province" context="{'group_by':'province'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_logistics_fsa" model="ir.actions.act_window">
        <field name="name">FSAs</field>
        <field name="res_model">logistics.fsa</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
