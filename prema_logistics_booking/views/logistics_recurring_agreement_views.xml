<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_recurring_agreement_list" model="ir.ui.view">
        <field name="name">logistics.recurring.agreement.list</field>
        <field name="model">logistics.recurring.agreement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agreement_reference"/>
                <field name="job_count" string="Recurring Jobs"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="booking_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_recurring_agreement_form" model="ir.ui.view">
        <field name="name">logistics.recurring.agreement.form</field>
        <field name="model">logistics.recurring.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state not in ('draft','quoted','paused')"/>
                    <button name="action_pause" string="Pause" type="object" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled','expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quoted,active,paused,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="agreement_reference"/>
                            <field name="account_manager_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="contract_months" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recurring Jobs" name="recurring_jobs">
                            <div class="alert alert-info" role="alert">
                                Add up to 10 routes for this customer. Region entries are useful for planning;
                                automatic bookings require Google-verified pickup and delivery addresses.
                            </div>
                            <field name="job_ids" context="{'default_agreement_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="pickup_kind"/>
                                    <field name="pickup_location_id" optional="show"/>
                                    <field name="pickup_region_id" domain="[('is_official_ltl_region','=',True)]" optional="show"/>
                                    <field name="delivery_kind"/>
                                    <field name="delivery_location_id" optional="show"/>
                                    <field name="delivery_region_id" domain="[('is_official_ltl_region','=',True)]" optional="show"/>
                                    <field name="frequency"/>
                                    <field name="preferred_weekday"/>
                                    <field name="pallets"/>
                                    <field name="auto_generate"/>
                                    <field name="next_shipment_date" readonly="1"/>
                                    <field name="active" column_invisible="True"/>
                                </list>
                                <form string="Recurring Job">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="sequence"/>
                                                <field name="auto_generate"/>
                                                <field name="next_shipment_date" readonly="1"/>
                                            </group>
                                            <group string="Schedule">
                                                <field name="frequency"/>
                                                <field name="preferred_weekday"/>
                                                <field name="monthly_week" invisible="frequency != 'monthly'"/>
                                                <field name="pickup_time_from" widget="float_time"/>
                                                <field name="pickup_time_to" widget="float_time"/>
                                                <field name="delivery_time_from" widget="float_time"/>
                                                <field name="delivery_time_to" widget="float_time"/>
                                            </group>
                                        </group>
                                        <group>
                                            <group string="Pickup">
                                                <field name="pickup_kind"/>
                                                <field name="pickup_location_id" invisible="pickup_kind != 'location'"/>
                                                <field name="pickup_region_id" domain="[('is_official_ltl_region','=',True)]" invisible="pickup_kind != 'region'"/>
                                                <field name="liftgate_pickup"/>
                                            </group>
                                            <group string="Delivery">
                                                <field name="delivery_kind"/>
                                                <field name="delivery_location_id" invisible="delivery_kind != 'location'"/>
                                                <field name="delivery_region_id" domain="[('is_official_ltl_region','=',True)]" invisible="delivery_kind != 'region'"/>
                                                <field name="liftgate_delivery"/>
                                                <field name="appointment"/>
                                                <field name="residential"/>
                                            </group>
                                        </group>
                                        <group string="Freight">
                                            <group>
                                                <field name="load_type"/>
                                                <field name="pallets"/>
                                                <field name="weight_lbs"/>
                                                <field name="commodity"/>
                                            </group>
                                            <group>
                                                <field name="temperature_mode"/>
                                                <field name="required_temperature_c" invisible="temperature_mode != 'reefer'"/>
                                                <field name="temperature_confirmed" invisible="temperature_mode != 'reefer'"/>
                                                <field name="stackable"/>
                                                <field name="hazmat"/>
                                                <field name="food_grade"/>
                                            </group>
                                        </group>
                                        <group string="References &amp; Instructions">
                                            <field name="po_number"/>
                                            <field name="customer_reference"/>
                                            <field name="instructions"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids" readonly="1">
                                <list>
                                    <field name="booking_number"/>
                                    <field name="recurring_job_id"/>
                                    <field name="pickup_date"/>
                                    <field name="estimated_delivery_date"/>
                                    <field name="pallets"/>
                                    <field name="calculated_price"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Agreement Notes">
                            <group>
                                <field name="billing_notes"/>
                                <field name="service_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_logistics_recurring_agreement" model="ir.actions.act_window">
        <field name="name">Recurring Agreements</field>
        <field name="res_model">logistics.recurring.agreement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
