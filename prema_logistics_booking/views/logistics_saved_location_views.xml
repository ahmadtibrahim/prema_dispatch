<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Saved Locations List View -->
    <record id="view_logistics_saved_location_list" model="ir.ui.view">
        <field name="name">logistics.saved.location.list</field>
        <field name="model">logistics.saved.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="commercial_partner_id"/>
                <field name="location_type"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="detected_region_id"/>
                <field name="region_match_result"/>
                <field name="is_default_pickup"/>
                <field name="is_default_delivery"/>
                <field name="google_verified"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Saved Locations Form View -->
    <record id="view_logistics_saved_location_form" model="ir.ui.view">
        <field name="name">logistics.saved.location.form</field>
        <field name="model">logistics.saved.location</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve_region_with_google"
                            string="Re-run Region Detection" type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="region_match_result" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="region_match_result not in ('MANUAL_QUOTE','NETWORK_DISABLED','AMBIGUOUS')">
                        <field name="region_match_result"/> —
                        <span invisible="region_match_result != 'MANUAL_QUOTE'">
                            Outside Scheduled Corridor — Manual Quote Required
                        </span>
                        <span invisible="region_match_result != 'NETWORK_DISABLED'">
                            Not Available for Automatic Online Booking
                        </span>
                        <span invisible="region_match_result != 'AMBIGUOUS'">
                            Manual Region Review Required
                        </span>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="name"/>
                            <field name="commercial_partner_id"/>
                            <field name="location_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Contact">
                            <field name="company_name"/>
                            <field name="contact_name"/>
                            <field name="contact_phone"/>
                            <field name="contact_email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="unit"/>
                            <field name="city"/>
                            <field name="postal_code"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="formatted_address" readonly="1"/>
                            <field name="google_place_id" readonly="1"/>
                            <field name="latitude" readonly="1"/>
                            <field name="longitude" readonly="1"/>
                            <field name="google_verified"/>
                        </group>
                        <group string="Region Detection">
                            <field name="region_match_result" readonly="1"/>
                            <field name="detected_region_id" readonly="1"/>
                            <field name="region_match_method" readonly="1"/>
                            <field name="region_match_timestamp" readonly="1"/>
                            <field name="manual_quote_required" readonly="1"/>
                            <field name="override_region_id"/>
                            <field name="override_user_id" readonly="1"/>
                            <field name="override_date" readonly="1"/>
                            <field name="override_reason"/>
                            <field name="candidate_regions" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operational Details">
                            <group>
                                <field name="dock_info"/>
                                <field name="opening_hours"/>
                                <field name="receiving_hours"/>
                                <field name="shipping_hours"/>
                                <field name="appointment_required"/>
                                <field name="appointment_contact"/>
                                <field name="appointment_phone"/>
                                <field name="liftgate_required"/>
                                <field name="forklift_available"/>
                            </group>
                        </page>
                        <page string="Instructions">
                            <group>
                                <field name="pickup_instructions"/>
                                <field name="delivery_instructions"/>
                            </group>
                        </page>
                        <page string="Defaults">
                            <group>
                                <field name="is_default_pickup"/>
                                <field name="is_default_delivery"/>
                                <field name="last_used_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_logistics_saved_location_search" model="ir.ui.view">
        <field name="name">logistics.saved.location.search</field>
        <field name="model">logistics.saved.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="commercial_partner_id"/>
                <field name="city"/>
                <filter name="type_pickup" string="Pickup"
                        domain="[('location_type', 'in', ('pickup','both'))]"/>
                <filter name="type_delivery" string="Delivery"
                        domain="[('location_type', 'in', ('delivery','both'))]"/>
                <filter name="type_both" string="Both"
                        domain="[('location_type', '=', 'both')]"/>
                <separator/>
                <filter name="scheduled" string="Scheduled Network"
                        domain="[('region_match_result', '=', 'SCHEDULED_MATCH')]"/>
                <filter name="manual_quote" string="Manual Quote"
                        domain="[('region_match_result', '=', 'MANUAL_QUOTE')]"/>
                <filter name="disabled" string="Network Disabled"
                        domain="[('region_match_result', '=', 'NETWORK_DISABLED')]"/>
                <filter name="ambiguous" string="Ambiguous"
                        domain="[('region_match_result', '=', 'AMBIGUOUS')]"/>
                <separator/>
                <filter name="default_pickup" string="Default Pickup"
                        domain="[('is_default_pickup', '=', True)]"/>
                <filter name="default_delivery" string="Default Delivery"
                        domain="[('is_default_delivery', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_logistics_saved_location" model="ir.actions.act_window">
        <field name="name">Saved Locations</field>
        <field name="res_model">logistics.saved.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_saved_locations"
              name="Saved Locations"
              parent="prema_logistics_booking.menu_v4_bookings"
              action="action_logistics_saved_location"
              sequence="25"/>
</odoo>
