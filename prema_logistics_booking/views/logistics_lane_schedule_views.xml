<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_lane_schedule_list" model="ir.ui.view">
        <field name="name">logistics.lane.schedule.list</field>
        <field name="model">logistics.lane.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="service_offering_id"/>
                <field name="cutoff_time" widget="float_time"/>
                <field name="delivery_offset_type"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_lane_schedule_form" model="ir.ui.view">
        <field name="name">logistics.lane.schedule.form</field>
        <field name="model">logistics.lane.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="service_offering_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Pickup Weekdays">
                        <field name="pickup_monday"/>
                        <field name="pickup_tuesday"/>
                        <field name="pickup_wednesday"/>
                        <field name="pickup_thursday"/>
                        <field name="pickup_friday"/>
                        <field name="pickup_saturday"/>
                        <field name="pickup_sunday"/>
                    </group>
                    <group string="Cutoff / Windows">
                        <field name="cutoff_time" widget="float_time"/>
                        <field name="pickup_window_start" widget="float_time"/>
                        <field name="pickup_window_end" widget="float_time"/>
                        <field name="delivery_window_start" widget="float_time"/>
                        <field name="delivery_window_end" widget="float_time"/>
                    </group>
                    <group string="Delivery Offset">
                        <field name="delivery_offset_type"/>
                        <field name="delivery_offset_days" invisible="delivery_offset_type != 'scheduled_days'"/>
                    </group>
                    <group string="Calendars / Effective Dates">
                        <field name="holiday_calendar_ids" widget="many2many_tags"/>
                        <field name="effective_from"/>
                        <field name="effective_to"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_logistics_lane_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">logistics.lane.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
