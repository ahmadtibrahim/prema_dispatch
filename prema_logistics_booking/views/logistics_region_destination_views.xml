<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_region_destination_list" model="ir.ui.view">
        <field name="name">logistics.region.destination.list</field>
        <field name="model">logistics.region.destination</field>
        <field name="arch" type="xml">
            <list>
                <field name="origin_region_id"/>
                <field name="destination_region_id"/>
                <field name="transit_region_id"/>
                <field name="pickup_day_label"/>
                <field name="delivery_day_label"/>
                <field name="requires_transit"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_logistics_region_destination_form" model="ir.ui.view">
        <field name="name">logistics.region.destination.form</field>
        <field name="model">logistics.region.destination</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="origin_region_id"/>
                        <field name="destination_region_id"/>
                        <field name="transit_region_id"/>
                        <field name="requires_transit"/>
                    </group>
                    <group string="Portal Display">
                        <field name="pickup_day_label"/>
                        <field name="delivery_day_label"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_logistics_region_destination" model="ir.actions.act_window">
        <field name="name">Region Destinations</field>
        <field name="res_model">logistics.region.destination</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
