<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- City List View -->
    <record id="view_logistics_city_list" model="ir.ui.view">
        <field name="name">logistics.city.list</field>
        <field name="model">logistics.city</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="province_state"/>
                <field name="region_id"/>
                <field name="primary_fsa_id"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- City Form View -->
    <record id="view_logistics_city_form" model="ir.ui.view">
        <field name="name">logistics.city.form</field>
        <field name="model">logistics.city</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="province_state"/>
                            <field name="region_id"/>
                            <field name="primary_fsa_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="google_place_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- City Search View -->
    <record id="view_logistics_city_search" model="ir.ui.view">
        <field name="name">logistics.city.search</field>
        <field name="model">logistics.city</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="province_state"/>
                <field name="region_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_province" string="Province" context="{'group_by':'province_state'}"/>
                    <filter name="by_region" string="Region" context="{'group_by':'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_logistics_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">logistics.city</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
