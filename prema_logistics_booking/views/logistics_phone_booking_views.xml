<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_phone_booking_form" model="ir.ui.view">
        <field name="name">logistics.phone.booking.form</field>
        <field name="model">logistics.phone.booking</field>
        <field name="arch" type="xml">
            <form string="Phone Quote / Booking">
                <header>
                    <button name="action_get_price" string="Get Price" type="object"
                            class="btn-primary" invisible="price &gt; 0"/>
                    <button name="action_get_price" string="Recalculate Price" type="object"
                            class="btn-primary" invisible="price == 0"/>
                    <button name="action_open_quote" string="Open Quotation" type="object"
                            class="btn-secondary" invisible="not quote_id"/>
                    <button name="action_confirm_booking" string="Accept Quote &amp; Book" type="object"
                            class="btn-success" invisible="price == 0 or booking_id"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h2>Phone Quote</h2>
                        <p class="text-muted mb-2">
                            Staff quoting uses the same routing, pricing, schedule and capacity engine as the customer portal.
                        </p>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id" required="1"/>
                            <field name="requested_pickup_date"/>
                            <field name="available_pickup_dates" readonly="1"
                                   invisible="not available_pickup_dates"/>
                        </group>
                        <group string="Shipment">
                            <field name="shipment_type"/>
                            <field name="temperature_mode"/>
                            <field name="required_temperature_c" invisible="temperature_mode != 'reefer'"/>
                        </group>
                    </group>

                    <separator string="Pickup"/>
                    <div class="alert alert-info py-2" role="alert">
                        Select an existing facility when possible. If this is a new one-off address, enter it below; quoting does not create a Saved Location or Master Facility.
                    </div>
                    <group>
                        <group>
                            <field name="pickup_location_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="pickup_postal_code" required="1"/>
                        </group>
                        <group>
                            <field name="pickup_address"/>
                            <field name="pickup_instructions"/>
                        </group>
                    </group>

                    <separator string="Delivery"/>
                    <div class="alert alert-info py-2" role="alert">
                        Existing facilities reuse the canonical physical address. Customer-specific contacts and instructions are shown only for the selected customer.
                    </div>
                    <group>
                        <group>
                            <field name="delivery_location_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="delivery_postal_code" required="1"/>
                        </group>
                        <group>
                            <field name="delivery_address"/>
                            <field name="delivery_instructions"/>
                        </group>
                    </group>

                    <separator string="Freight"/>
                    <group>
                        <group>
                            <field name="pallets"/>
                            <field name="weight_lbs"/>
                        </group>
                        <group string="Service Options">
                            <field name="liftgate_pickup"/>
                            <field name="liftgate_delivery"/>
                            <field name="appointment"/>
                            <field name="residential"/>
                            <field name="same_day_requested"/>
                        </group>
                    </group>

                    <group string="Quote Result" invisible="price == 0">
                        <group>
                            <field name="system_calculated_price" readonly="1"/>
                            <field name="customer_quoted_price"/>
                            <field name="manual_price_adjustment" readonly="1"/>
                            <field name="manual_price_reason"
                                   placeholder="Required when the quoted price differs from the system price"/>
                            <button name="action_reset_price" string="Reset to System Price" type="object"
                                    class="btn-secondary"/>
                        </group>
                        <group>
                            <field name="pickup_date" readonly="1"/>
                            <field name="delivery_date" readonly="1"/>
                            <field name="quote_id" readonly="1"/>
                            <field name="booking_id" readonly="1" invisible="not booking_id"/>
                        </group>
                    </group>

                    <field name="result_text" readonly="1" widget="text"
                           invisible="not result_text"/>
                    <field name="quote_token" invisible="1"/>
                    <field name="temperature_confirmed" invisible="1"/>
                </sheet>

                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_logistics_phone_booking" model="ir.actions.act_window">
        <field name="name">Phone Booking</field>
        <field name="res_model">logistics.phone.booking</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
