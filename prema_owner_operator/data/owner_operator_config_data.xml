        <record id="work_pref_regional" model="prema.owner.operator.work.preference">
            <field name="name">Regional</field>
            <field name="code">regional</field>
            <field name="sequence">20</field>
        </record>
        <record id="work_pref_longhaul" model="prema.owner.operator.work.preference">
            <field name="name">Long haul</field>
            <field name="code">longhaul</field>
            <field name="sequence">30</field>
        </record>
        <record id="work_pref_flexible" model="prema.owner.operator.work.preference">
            <field name="name">Flexible</field>
            <field name="code">flexible</field>
            <field name="sequence">40</field>
        </record>

        <record id="param_coi_min_auto_liability" model="ir.config_parameter">
            <field name="key">prema_owner_operator.coi_min_auto_liability</field>
            <field name="value">0</field>
        </record>
        <record id="param_coi_min_cargo" model="ir.config_parameter">
            <field name="key">prema_owner_operator.coi_min_cargo</field>
            <field name="value">0</field>
        </record>
        <record id="param_coi_min_ai_confidence" model="ir.config_parameter">
            <field name="key">prema_owner_operator.coi_min_ai_confidence</field>
            <field name="value">0</field>
        </record>
        <record id="param_coi_holder_name" model="ir.config_parameter">
            <field name="key">prema_owner_operator.coi_certificate_holder_name</field>
            <field name="value">PremaFirm Inc.</field>
        </record>
        <record id="param_coi_holder_address" model="ir.config_parameter">
            <field name="key">prema_owner_operator.coi_certificate_holder_address</field>
            <field name="value">994 Westport Cres, Unit 7A, Mississauga, ON L5T 1G1, Canada</field>
        </record>
        <record id="param_trusted_insurer_domains" model="ir.config_parameter">
            <field name="key">prema_owner_operator.trusted_insurer_domains</field>
