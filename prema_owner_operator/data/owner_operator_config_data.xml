<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Display names match the legacy Selection labels so historical
             single-value answers can be migrated without translation loss. -->
        <record id="service_area_toronto_gta" model="prema.owner.operator.service.area">
            <field name="name">Toronto / GTA</field>
            <field name="code">toronto_gta</field>
            <field name="sequence">10</field>
        </record>
        <record id="service_area_ontario_wide" model="prema.owner.operator.service.area">
            <field name="name">Ontario wide</field>
            <field name="code">ontario_wide</field>
            <field name="sequence">20</field>
        </record>
        <record id="service_area_quebec" model="prema.owner.operator.service.area">
            <field name="name">Quebec</field>
            <field name="code">quebec</field>
            <field name="sequence">30</field>
        </record>
        <record id="service_area_ontario_quebec" model="prema.owner.operator.service.area">
            <field name="name">Ontario and Quebec</field>
            <field name="code">ontario_quebec</field>
            <field name="sequence">40</field>
        </record>
        <record id="service_area_canada_wide" model="prema.owner.operator.service.area">
            <field name="name">Canada wide</field>
            <field name="code">canada_wide</field>
            <field name="sequence">50</field>
        </record>
        <record id="service_area_selected_provinces" model="prema.owner.operator.service.area">
            <field name="name">Selected provinces</field>
            <field name="code">selected_provinces</field>
            <field name="sequence">60</field>
        </record>

