<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_verification_list" model="ir.ui.view">
        <field name="name">prema.owner.operator.verification.list</field>
        <field name="model">prema.owner.operator.verification</field>
        <field name="arch" type="xml">
            <list string="Verification Mail" create="false">
                <field name="received_date"/>
                <field name="subject"/>
                <field name="sender_email"/>
                <field name="matched_application_id"/>
                <field name="state" widget="badge"/>
                <field name="attachment_count"/>
                <field name="match_reason" optional="show"/>
                <field name="message_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_verification_form" model="ir.ui.view">
        <field name="name">prema.owner.operator.verification.form</field>
        <field name="model">prema.owner.operator.verification</field>
        <field name="arch" type="xml">
            <form string="Verification Email" create="false" edit="true">
                <header>
                    <button name="action_manual_attach" type="object"
                            string="Attach certificate to application"
                            class="btn-primary"
                            invisible="not matched_application_id or state == 'manual'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,matched,auto_advanced,manual,unmatched,ambiguous,conflict,applicant_forwarded,no_certificate"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Match">
                            <field name="matched_application_id"/>
                            <field name="match_reason" readonly="1"/>
                            <field name="certificate_attachment_id"
                                   domain="[('mimetype','in',['application/pdf','image/jpeg','image/png','image/webp'])]"/>
                            <field name="advance_to_final"/>
                        </group>
                        <group string="Original email">
                            <field name="received_date" readonly="1"/>
                            <field name="sender_email" readonly="1"/>
                            <field name="message_id" readonly="1"/>
                            <field name="in_reply_to" readonly="1"/>
                            <field name="attachment_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Headers">
                        <field name="to_headers" readonly="1"/>
                        <field name="cc_headers" readonly="1"/>
                        <field name="references_header" readonly="1"/>
                        <field name="raw_headers" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body" readonly="1" widget="html"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_verification" model="ir.actions.act_window">
        <field name="name">Verification Mail</field>
        <field name="res_model">prema.owner.operator.verification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_verification" name="Verification Mail"
              parent="menu_owner_operator_root"
              action="action_verification" sequence="20"
              groups="prema_owner_operator.group_owner_operator,hr_recruitment.group_hr_recruitment_manager"/>
</odoo>
