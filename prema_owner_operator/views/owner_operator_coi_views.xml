<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coi_version_form" model="ir.ui.view">
        <field name="name">prema.owner.operator.coi.version.form</field>
        <field name="model">prema.owner.operator.coi.version</field>
        <field name="arch" type="xml">
            <form string="Certificate of Insurance Version" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Document">
                            <field name="application_id" readonly="1"/>
                            <field name="document_id" readonly="1"/>
                            <field name="file_name" readonly="1"/>
                            <field name="mimetype" readonly="1"/>
                            <field name="can_preview"
                                   widget="owner_operator_document_view"
                                   options="{'route': 'coi_version'}"
                                   readonly="1"/>
                            <field name="sha256" readonly="1"/>
                        </group>
                        <group string="Source">
                            <field name="received_date" readonly="1"/>
                            <field name="sender" readonly="1"/>
                            <field name="message_id" readonly="1"/>
                            <field name="verification_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="is_direct" readonly="1"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Coverage">
                        <group>
                            <field name="insurer_name" readonly="1"/>
                            <field name="broker_name" readonly="1"/>
                            <field name="policy_number" readonly="1"/>
                            <field name="effective_date" readonly="1"/>
                            <field name="expiry_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="auto_liability_limit" readonly="1"/>
                            <field name="cargo_limit" readonly="1"/>
                            <field name="other_coverage" readonly="1"/>
                        </group>
                    </group>
                    <group string="Verification">
                        <group>
                            <field name="extraction_state" readonly="1"/>
                            <field name="extraction_method" readonly="1"/>
                            <field name="extraction_confidence" readonly="1"/>
                            <field name="extraction_error" readonly="1"/>
                        </group>
                        <group>
                            <field name="verification_status" readonly="1"/>
                            <field name="verified_on" readonly="1"/>
                            <field name="verified_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
