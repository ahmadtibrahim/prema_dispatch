<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_application_form" model="ir.ui.view">
        <field name="name">prema.owner.operator.application.form</field>
        <field name="model">prema.owner.operator.application</field>
        <field name="arch" type="xml">
            <form string="Owner-Operator Application">
                <header>
                    <button name="action_advance" type="object"
                            string="Advance stage" class="btn-primary"
                            invisible="state in ('approved','rejected')"/>
                    <button name="action_resend_coi_request" type="object"
                            string="Resend COI request"
                            invisible="not coi_request_sent_at"/>
                    <button name="action_prepare_operator" type="object"
                            string="Operator profile"
                            invisible="operator_id"/>
                    <button name="action_send_contract" type="object"
                            string="Send agreement" invisible="sign_request_id"/>
                    <button name="action_approve" type="object"
                            string="Approve → Fleet" class="btn-success"
                            invisible="not can_approve"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,qualifying,authority_review,contract,signed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Applicant">
                            <field name="contact_name" readonly="1"/>
                            <field name="email" widget="email" readonly="1"/>
                            <field name="phone" widget="phone" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="hr_applicant_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                        </group>
                        <group string="Review status">
                            <field name="can_approve"/>
                            <field name="licence_current"/>
                            <field name="equipment_complete"/>
                            <field name="equipment_missing"/>
                            <field name="missing_initial"/>
                            <field name="missing_qualification"/>
                            <field name="missing_verification"/>
                            <field name="missing_contract"/>
                            <field name="home_base_tag_issue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business &amp; Driver" name="business_driver">
                            <group>
                                <group string="Business">
                                    <field name="business_name"/>
                                    <field name="business_structure"/>
                                    <field name="is_sole_proprietor"/>
                                    <field name="home_city"/>
                                    <field name="home_province"/>
                                    <field name="service_province_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Driver licence">
                                    <field name="licence_class"/>
                                    <field name="licence_jurisdiction"/>
                                    <field name="licence_expiry"/>
                                    <field name="licence_suspension"/>
                                </group>
                            </group>
                            <group>
                                <group string="Experience">
                                    <field name="commercial_driving_experience"/>
                                    <field name="owner_operator_experience"/>
                                    <field name="tdg_training"/>
                                </group>
                                <group string="History">
                                    <field name="recent_collisions"/>
                                    <field name="recent_convictions"/>
                                    <field name="recent_driving_work"/>
                                </group>
                            </group>
                        </page>

                        <page string="Vehicle &amp; Equipment" name="vehicle_equipment">
                            <group>
                                <group string="Vehicle">
                                    <field name="vehicle_type"/>
                                    <field name="equipment_model"/>
                                    <field name="truck_year"/>
                                    <field name="unit_number"/>
                                    <field name="vehicle_ownership"/>
                                    <field name="transmission"/>
                                    <field name="odometer_km"/>
                                    <field name="truck_plate_jurisdiction"/>
                                    <field name="license_plate"/>
                                    <field name="plate_jurisdiction"/>
                                </group>
                                <group string="Derived for Fleet">
                                    <field name="equipment_type" readonly="1"/>
                                    <field name="has_reefer" readonly="1"/>
                                    <field name="has_liftgate" readonly="1"/>
                                    <field name="has_air_ride" readonly="1"/>
                                </group>
                            </group>
                            <group string="Cargo body (van / straight truck; trailer specs when an owned trailer is supplied)">
                                <group>
                                    <field name="cargo_body_type"/>
                                    <field name="payload_lbs"/>
                                    <field name="pallet_capacity"/>
                                    <field name="box_length_ft"/>
                                    <field name="cargo_width_in"/>
                                    <field name="cargo_height_in"/>
                                    <field name="door_width_in"/>
                                    <field name="door_clearance_in"/>
                                </group>
                                <group>
                                    <field name="liftgate"/>
                                    <field name="liftgate_capacity_lb"/>
                                    <field name="liftgate_platform_length_in"/>
                                    <field name="liftgate_platform_width_in"/>
                                    <field name="dock_height_capable"/>
                                    <field name="air_ride"/>
                                    <field name="reefer_temperature_range"/>
                                </group>
                            </group>
                            <group string="Trailer (tractor / power unit)">
                                <group>
                                    <field name="trailer_ownership"/>
                                    <field name="trailer_type"
                                           invisible="vehicle_type != 'tractor'"/>
                                    <field name="trailer_length_ft"
                                           invisible="vehicle_type != 'tractor'"/>
                                    <field name="trailer_unit"
                                           invisible="vehicle_type != 'tractor'"/>
                                </group>
                                <group string="Dispatch completeness">
                                    <field name="equipment_complete" readonly="1"/>
                                    <field name="equipment_missing" readonly="1"/>
                                    <field name="equipment_data_confirmed"/>
                                    <field name="equipment_provided" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Service &amp; Availability" name="service_availability">
                            <group>
                                <group string="Coverage">
                                    <field name="preferred_service_area_ids"
                                           widget="many2many_tags"/>
                                    <field name="service_province_ids"
                                           widget="many2many_tags"/>
                                    <field name="work_preference_ids"
                                           widget="many2many_tags"/>
                                    <field name="available_start_date"/>
                                    <field name="application_declaration"/>
                                </group>
                                <group string="Legacy single answers">
                                    <field name="preferred_service_area" readonly="1"/>
                                    <field name="work_preference" readonly="1"/>
                                    <field name="whatsapp_consent" readonly="1"/>
                                </group>
                            </group>
                            <group string="Load-notification contact">
                                <group>
                                    <field name="load_notification_channel"/>
                                    <field name="load_notification_email"/>
                                    <field name="whatsapp_number"/>
                                    <field name="load_notification_opt_out"/>
                                    <field name="load_notification_opt_out_at" readonly="1"/>
                                </group>
                                <group string="WhatsApp consent">
                                    <field name="whatsapp_consent_granted"/>
                                    <field name="whatsapp_consent_at" readonly="1"/>
                                    <field name="whatsapp_consent_version" readonly="1"/>
                                    <field name="whatsapp_consent_text" readonly="1"/>
                                </group>
                            </group>
                            <group string="Additional notes">
                                <field name="additional_notes" readonly="1"/>
                            </group>
                            <group string="Notification preference history">
                                <field name="notification_preference_log_ids"
                                       readonly="1">
                                    <list>
                                        <field name="create_date"/>
                                        <field name="user_id"/>
                                        <field name="channel"/>
                                        <field name="whatsapp_number"/>
                                        <field name="email"/>
                                        <field name="consent_given"/>
                                        <field name="opt_out"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Documents &amp; Compliance" name="documents_compliance">
                            <group>
                                <group string="CVOR (manual review)">
                                    <field name="cvor_number"/>
                                    <field name="cvor_verification_status"/>
                                    <button name="action_verify_cvor" type="object"
                                            string="Mark CVOR verified"
                                            class="btn-link"
                                            invisible="cvor_verification_status == 'verified' or not cvor_number"/>
                                    <button name="action_reject_cvor" type="object"
                                            string="Reject CVOR"
                                            class="btn-link"
                                            invisible="cvor_verification_status == 'rejected' or not cvor_number"/>
                                </group>
                                <group string="Insurance agent (legacy — not collected on the public form)">
                                    <field name="insurance_agent_name" readonly="1"/>
                                    <field name="insurance_agent_email" widget="email" readonly="1"/>
                                    <field name="authority_state"/>
                                </group>
                            </group>
                            <group string="Insurer-direct COI request">
                                <group>
                                    <field name="coi_request_sent_at" readonly="1"/>
                                    <field name="coi_request_sent_by" readonly="1"/>
                                    <field name="coi_request_count" readonly="1"/>
                                    <field name="coi_request_last_subject" readonly="1"/>
                                    <field name="coi_request_message_id" readonly="1"/>
                                </group>
                                <group string="Review thresholds (settings)">
                                    <field name="coi_min_auto_liability" readonly="1"/>
                                    <field name="coi_min_cargo" readonly="1"/>
                                </group>
                            </group>
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="required_stage"/>
                                    <field name="source"/>
                                    <field name="status" widget="badge"/>
                                    <field name="attachment_id"/>
                                    <field name="file_name" readonly="1"/>
                                    <field name="mimetype" column_invisible="1"/>
                                    <field name="can_preview"
                                           widget="owner_operator_document_view"
                                           readonly="1"/>
                                    <field name="expiry_date"/>
                                    <field name="verified_by" readonly="1"/>
                                    <field name="verified_on" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group string="Agreement / signature">
                                <group>
                                    <field name="sign_request_id" readonly="1"/>
                                    <field name="sign_template_id" readonly="1"/>
                                    <field name="contract_sent_on" readonly="1"/>
                                    <field name="contract_signed_on" readonly="1"/>
                                    <field name="contract_completed_on" readonly="1"/>
                                    <field name="setup_email_sent_at" readonly="1"/>
                                    <field name="setup_email_message_id" readonly="1"/>
                                </group>
                                <group string="Fleet hand-off">
                                    <field name="operator_id" readonly="1"/>
                                    <field name="fleet_vehicle_id" readonly="1"/>
                                    <field name="approved_on" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="home_base_tag_issue" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_application_list" model="ir.ui.view">
        <field name="name">prema.owner.operator.application.list</field>
        <field name="model">prema.owner.operator.application</field>
        <field name="arch" type="xml">
            <list string="Applications">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="business_name"/>
                <field name="home_city"/>
                <field name="home_province"/>
                <field name="vehicle_type"/>
                <field name="preferred_service_area_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
                <field name="missing_verification" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_application" model="ir.actions.act_window">
        <field name="name">Owner-Operator Applications</field>
        <field name="res_model">prema.owner.operator.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_application" name="Applications"
              parent="menu_owner_operator_root" action="action_application"
              sequence="5"/>
</odoo>
