<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_application_form" model="ir.ui.view">
        <field name="name">prema.owner.operator.application.form</field>
        <field name="model">prema.owner.operator.application</field>
        <field name="arch" type="xml">
            <form string="Owner-Operator Application">
                <header>
                    <button name="action_advance" type="object"
                            string="Advance stage" class="btn-primary"
                            invisible="state in ('approved','rejected')"/>
                    <button name="action_resend_coi_request" type="object"
                            string="Resend COI Instructions"
                            invisible="not coi_request_sent_at"/>
                    <button name="action_approve_verification" type="object"
                            string="Approve Verification" class="btn-success"
                            invisible="verification_status == 'verified'"/>
                    <button name="action_reject_coi" type="object"
                            string="Reject COI"
                            invisible="verification_status == 'verified'"/>
                    <button name="action_request_updated_coi" type="object"
                            string="Request Updated COI"
                            invisible="verification_status == 'verified'"/>
                    <button name="action_open_coi_emails" type="object"
                            string="Insurance Email" icon="fa-envelope"
                            invisible="not coi_email_count"/>
                    <button name="action_prepare_operator" type="object"
                            string="Operator profile"
                            invisible="operator_id"/>
                    <button name="action_send_contract" type="object"
                            string="Send agreement" invisible="sign_request_id"/>
                    <button name="action_approve" type="object"
                            string="Approve → Fleet" class="btn-success"
                            invisible="not can_approve"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,qualifying,authority_review,verified,contract,signed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Applicant">
                            <field name="contact_name" readonly="1"/>
                            <field name="email" widget="email" readonly="1"/>
                            <field name="phone" widget="phone" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="hr_applicant_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                        </group>
                        <group string="Review status">
                            <field name="can_approve"/>
                            <field name="licence_current"/>
                            <field name="equipment_complete"/>
                            <field name="equipment_missing"/>
                            <field name="missing_initial"/>
                            <field name="missing_qualification"/>
                            <field name="missing_verification"/>
                            <field name="missing_contract"/>
                            <field name="home_base_tag_issue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business &amp; Driver" name="business_driver">
                            <group>
                                <group string="Business">
                                    <field name="business_name"/>
                                    <field name="business_structure"/>
                                    <field name="is_sole_proprietor"/>
                                    <field name="home_city"/>
                                    <field name="home_province"/>
                                    <field name="home_province_code"/>
                                    <field name="home_city_place_id"/>
                                    <field name="home_latitude"/>
                                    <field name="home_longitude"/>
                                    <field name="home_location_verified"/>
                                    <field name="home_location_review"/>
                                    <field name="home_location_review_reason"/>
                                    <field name="service_province_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Driver licence">
                                    <field name="licence_class"/>
                                    <field name="licence_jurisdiction"/>
                                    <field name="licence_province"/>
                                    <field name="licence_expiry"/>
                                    <field name="licence_suspension"/>
                                </group>
                            </group>
                            <group>
                                <group string="Experience">
                                    <field name="commercial_driving_experience"/>
                                    <field name="owner_operator_experience"/>
                                    <field name="tdg_status"/>
                                    <field name="tdg_class_ids"
                                           widget="many2many_tags"/>
                                    <field name="tdg_special_training"/>
                                    <field name="tdg_training" readonly="1"/>
                                </group>
                                <group string="History">
                                    <field name="recent_collisions"/>
                                    <field name="recent_convictions"/>
                                    <field name="recent_driving_work"/>
                                </group>
                            </group>
                        </page>

                        <page string="Vehicle &amp; Equipment" name="vehicle_equipment">
                            <group>
                                <group string="Vehicle">
                                    <field name="vehicle_type"/>
                                    <field name="cab_type"/>
                                    <field name="truck_make"/>
                                    <field name="truck_model"/>
                                    <field name="equipment_model"
                                           invisible="truck_make and truck_model"/>
                                    <field name="truck_year"/>
                                    <field name="unit_number"/>
                                    <field name="vehicle_ownership"/>
                                    <field name="transmission"/>
                                    <field name="odometer_km"/>
                                    <field name="gvwr_lbs"/>
                                    <field name="truck_plate_jurisdiction"
                                           invisible="license_plate and plate_province"/>
                                    <field name="license_plate"/>
                                    <field name="plate_jurisdiction"
                                           invisible="plate_province"/>
                                    <field name="plate_province"/>
                                </group>
                                <group string="Derived for Fleet">
                                    <field name="equipment_type" readonly="1"/>
                                    <field name="has_reefer" readonly="1"/>
                                    <field name="has_liftgate" readonly="1"/>
                                    <field name="has_air_ride" readonly="1"/>
                                </group>
                            </group>
                            <group string="Cargo body (van / straight truck; trailer specs when an owned trailer is supplied)">
                                <group>
                                    <field name="cargo_body_type"/>
                                    <field name="payload_lbs"/>
                                    <field name="pallet_capacity"/>
                                    <field name="box_length_ft"/>
                                    <field name="cargo_width_in"/>
                                    <field name="cargo_height_in"/>
                                    <field name="door_width_in"/>
                                    <field name="door_clearance_in"/>
                                </group>
                                <group>
                                    <field name="liftgate"/>
                                    <field name="liftgate_capacity_lb"/>
                                    <field name="liftgate_platform_length_in"/>
                                    <field name="liftgate_platform_width_in"/>
                                    <field name="dock_height_capable"/>
                                    <field name="air_ride"/>
                                    <field name="reefer_applicable"/>
                                    <field name="reefer_temperature_range"/>
                                </group>
                            </group>
                            <group string="Trailer (Semi-Truck)">
                                <group>
                                    <field name="trailer_ownership"/>
                                    <field name="trailer_type"
                                           invisible="vehicle_type not in ('tractor', 'semi')"/>
                                    <field name="trailer_year"
                                           invisible="vehicle_type != 'semi'"/>
                                    <field name="trailer_length_ft"
                                           invisible="vehicle_type not in ('tractor', 'semi')"/>
                                    <field name="trailer_unit"
                                           invisible="vehicle_type not in ('tractor', 'semi')"/>
                                </group>
                                <group string="Dispatch completeness">
                                    <field name="equipment_complete" readonly="1"/>
                                    <field name="equipment_missing" readonly="1"/>
                                    <field name="equipment_data_confirmed"/>
                                    <field name="equipment_provided" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Service &amp; Availability" name="service_availability">
                            <group>
                                <group string="Coverage">
                                    <field name="preferred_service_area_ids"
                                           widget="many2many_tags"/>
                                    <field name="service_province_ids"
                                           widget="many2many_tags"/>
                                    <field name="work_preference_ids"
                                           widget="many2many_tags"/>
                                    <field name="available_start_date"/>
                                    <field name="application_declaration"/>
                                </group>
                                <group string="Legacy single answers">
                                    <field name="preferred_service_area" readonly="1"/>
                                    <field name="work_preference" readonly="1"/>
                                    <field name="whatsapp_consent" readonly="1"/>
                                </group>
                            </group>
                            <group string="Load-notification contact">
                                <group>
                                    <field name="load_notification_channel"/>
                                    <field name="load_notification_email"/>
                                    <field name="whatsapp_number"/>
                                    <field name="use_contact_phone_for_whatsapp"/>
                                    <field name="load_notification_opt_out"/>
                                    <field name="load_notification_opt_out_at" readonly="1"/>
                                </group>
                                <group string="WhatsApp consent">
                                    <field name="whatsapp_consent_granted"/>
                                    <field name="whatsapp_consent_at" readonly="1"/>
                                    <field name="whatsapp_consent_version" readonly="1"/>
                                    <field name="whatsapp_consent_text" readonly="1"/>
                                </group>
                            </group>
                            <group string="Additional notes">
                                <field name="additional_notes" readonly="1"/>
                            </group>
                            <group string="Notification preference history">
                                <field name="notification_preference_log_ids"
                                       readonly="1">
                                    <list>
                                        <field name="create_date"/>
                                        <field name="user_id"/>
                                        <field name="channel"/>
                                        <field name="whatsapp_number"/>
                                        <field name="email"/>
                                        <field name="consent_given"/>
                                        <field name="opt_out"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Documents &amp; Compliance" name="documents_compliance">
                            <group>
                                <group string="CVOR (manual review)">
                                    <field name="cvor_number"/>
                                    <field name="cvor_verification_status"/>
                                    <button name="action_verify_cvor" type="object"
                                            string="Mark CVOR verified"
                                            class="btn-link"
                                            invisible="cvor_verification_status == 'verified' or not cvor_number"/>
                                    <button name="action_reject_cvor" type="object"
                                            string="Reject CVOR"
                                            class="btn-link"
                                            invisible="cvor_verification_status == 'rejected' or not cvor_number"/>
                                </group>
                                <group string="CVOR extraction (proposal only — not verification)">
                                    <field name="cvor_extraction_status"/>
                                    <field name="cvor_proposed_number" readonly="1"/>
                                    <field name="cvor_extraction_confidence" readonly="1"/>
                                    <field name="cvor_extraction_method" readonly="1"/>
                                    <field name="cvor_extraction_mismatch" readonly="1"/>
                                    <field name="cvor_extraction_reason" readonly="1"/>
                                    <field name="cvor_extraction_candidates" readonly="1"/>
                                    <field name="cvor_extraction_source_document_id"
                                           readonly="1"/>
                                    <field name="cvor_extraction_checked_on" readonly="1"/>
                                    <button name="action_extract_cvor" type="object"
                                            string="Extract CVOR number"
                                            class="btn-link"/>
                                    <button name="action_preview_cvor_source"
                                            type="object" string="Preview source"
                                            class="btn-link"
                                            invisible="not cvor_extraction_source_document_id"/>
                                    <button name="action_confirm_cvor_extraction"
                                            type="object" string="Confirm proposed number"
                                            class="btn-link"
                                            invisible="not cvor_proposed_number or cvor_extraction_status == 'confirmed'"/>
                                    <button name="action_reject_cvor_extraction"
                                            type="object" string="Reject proposal"
                                            class="btn-link"
                                            invisible="not cvor_proposed_number or cvor_extraction_status == 'rejected'"/>
                                </group>
                                <group string="Canadian TDG certificate (reviewer)">
                                    <field name="tdg_certificate_result"
                                           widget="badge"
                                           decoration-success="tdg_certificate_result == 'verified'"
                                           decoration-danger="tdg_certificate_result == 'rejected'"
                                           decoration-secondary="tdg_certificate_result == 'pending'"/>
                                    <field name="tdg_certificate_issuer"/>
                                    <field name="tdg_certificate_issue_date"/>
                                    <field name="tdg_certificate_expiry_date"/>
                                    <field name="tdg_certificate_activities"/>
                                    <field name="tdg_certificate_verified_on" readonly="1"/>
                                    <field name="tdg_certificate_verified_by" readonly="1"/>
                                    <button name="action_open_tdg_certificate" type="object"
                                            string="Open / upload TDG certificate"
                                            class="btn-link"/>
                                    <button name="action_verify_tdg_certificate" type="object"
                                            string="Verify TDG certificate"
                                            class="btn-link"
                                            invisible="tdg_certificate_result == 'verified' or tdg_status != 'current'"/>
                                    <button name="action_reject_tdg_certificate" type="object"
                                            string="Reject TDG certificate"
                                            class="btn-link"
                                            invisible="tdg_certificate_result == 'rejected'"/>
                                </group>
                                <group string="Insurance agent (legacy — not collected on the public form)">
                                    <field name="insurance_agent_name" readonly="1"/>
                                    <field name="insurance_agent_email" widget="email" readonly="1"/>
                                    <field name="authority_state"/>
                                </group>
                                <group string="Driver licence verification (reviewer)">
                                    <field name="licence_class"/>
                                    <field name="licence_province"/>
                                    <field name="licence_jurisdiction" readonly="1"/>
                                    <field name="licence_number"
                                           placeholder="Enter from the uploaded licence"/>
                                    <field name="licence_expiry"/>
                                    <field name="licence_verification_status"
                                           widget="badge"
                                           decoration-success="licence_verification_status == 'verified'"
                                           decoration-secondary="licence_verification_status != 'verified'"/>
                                    <field name="licence_verified_on" readonly="1"/>
                                    <field name="licence_verified_by" readonly="1"/>
                                    <button name="action_verify_licence" type="object"
                                            string="Verify driver licence"
                                            class="btn-link"
                                            invisible="licence_verification_status == 'verified'"/>
                                    <button name="action_reset_licence_verification"
                                            type="object"
                                            string="Reset verification"
                                            class="btn-link"
                                            invisible="licence_verification_status != 'verified'"/>
                                </group>
                                <group string="Approval links">
                                    <field name="driver_partner_id" readonly="1"/>
                                    <field name="documents_folder_id" readonly="1"/>
                                    <field name="generated_tag_ids"
                                           widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>
                            <group string="Insurance verification">
                                <group>
                                    <field name="verification_status" widget="badge"
                                           decoration-success="verification_status == 'verified'"
                                           decoration-danger="verification_status == 'review'"
                                           decoration-secondary="verification_status == 'pending'"/>
                                    <field name="verification_reasons" readonly="1"/>
                                    <field name="verification_date" readonly="1"/>
                                    <field name="verification_method" readonly="1"/>
                                    <field name="verification_confidence" readonly="1"/>
                                    <field name="verification_reviewer_id" readonly="1"/>
                                    <field name="verification_reviewed_on" readonly="1"/>
                                </group>
                                <group>
                                    <field name="verification_review_reason"
                                           placeholder="Reason for approval / rejection / updated COI request"/>
                                    <field name="coi_current_version_id" readonly="1"/>
                                    <field name="coi_email_count" readonly="1"/>
                                    <button name="action_open_coi_emails" type="object"
                                            string="Insurance Email" class="btn-link"/>
                                </group>
                            </group>
                            <group string="Insurer-direct COI request">
                                <group>
                                    <field name="coi_request_sent_at" readonly="1"/>
                                    <field name="coi_request_sent_by" readonly="1"/>
                                    <field name="coi_request_count" readonly="1"/>
                                    <field name="coi_request_last_subject" readonly="1"/>
                                    <field name="coi_request_message_id" readonly="1"/>
                                </group>
                                <group string="Review thresholds (settings)">
                                    <field name="coi_min_auto_liability" readonly="1"/>
                                    <field name="coi_min_cargo" readonly="1"/>
                                </group>
                            </group>
                            <group string="COI versions (original documents)">
                                <field name="coi_version_ids" readonly="1">
                                    <list>
                                        <field name="received_date"/>
                                        <field name="is_current"/>
                                        <field name="effective_date"/>
                                        <field name="expiry_date"/>
                                        <field name="insurer_name"/>
                                        <field name="policy_number"/>
                                        <field name="source"/>
                                        <field name="extraction_state"/>
                                        <field name="verification_status"/>
                                        <field name="file_name"/>
                                        <field name="mimetype" column_invisible="1"/>
                                        <field name="can_preview"
                                               widget="owner_operator_document_view"
                                               options="{'route': 'coi_version'}"
                                               readonly="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="COI emails">
                                <field name="coi_email_ids" readonly="1">
                                    <list>
                                        <field name="received_date"/>
                                        <field name="sender_email"/>
                                        <field name="subject"/>
                                        <field name="state" widget="badge"/>
                                        <field name="match_reason"/>
                                    </list>
                                </field>
                            </group>
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="required_stage"/>
                                    <field name="source"/>
                                    <field name="status" widget="badge"/>
                                    <field name="attachment_id"/>
                                    <field name="file_name" readonly="1"/>
                                    <field name="mimetype" column_invisible="1"/>
                                    <field name="can_preview"
                                           widget="owner_operator_document_view"
                                           readonly="1"/>
                                    <field name="expiry_date"/>
                                    <field name="verified_by" readonly="1"/>
                                    <field name="verified_on" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group string="Agreement / signature">
                                <group>
                                    <field name="sign_request_id" readonly="1"/>
                                    <field name="sign_template_id" readonly="1"/>
                                    <field name="contract_sent_on" readonly="1"/>
                                    <field name="contract_signed_on" readonly="1"/>
                                    <field name="contract_completed_on" readonly="1"/>
                                    <field name="setup_email_sent_at" readonly="1"/>
                                    <field name="setup_email_message_id" readonly="1"/>
                                </group>
                                <group string="Fleet hand-off">
                                    <field name="operator_id" readonly="1"/>
                                    <field name="fleet_vehicle_id" readonly="1"/>
                                    <field name="approved_on" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="home_base_tag_issue" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_application_list" model="ir.ui.view">
        <field name="name">prema.owner.operator.application.list</field>
        <field name="model">prema.owner.operator.application</field>
        <field name="arch" type="xml">
            <list string="Applications">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="business_name"/>
                <field name="home_city"/>
                <field name="home_province"/>
                <field name="vehicle_type"/>
                <field name="cab_type"/>
                <field name="preferred_service_area_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
                <field name="missing_verification" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_application_search" model="ir.ui.view">
        <field name="name">prema.owner.operator.application.search</field>
        <field name="model">prema.owner.operator.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="vehicle_type"/>
                <field name="cab_type"/>
                <filter string="Day Cab" name="cab_day"
                        domain="[('cab_type', '=', 'day')]"/>
                <filter string="Night Cab" name="cab_night"
                        domain="[('cab_type', '=', 'night')]"/>
                <filter string="Not Applicable" name="cab_not_applicable"
                        domain="[('cab_type', '=', 'not_applicable')]"/>
                <group expand="0" string="Group By">
                    <filter string="Cab" name="groupby_cab"
                            context="{'group_by': 'cab_type'}"/>
                    <filter string="Vehicle type" name="groupby_vehicle_type"
                            context="{'group_by': 'vehicle_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_application" model="ir.actions.act_window">
        <field name="name">Owner-Operator Applications</field>
        <field name="res_model">prema.owner.operator.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_application_search"/>
    </record>

    <menuitem id="menu_application" name="Applications"
              parent="menu_owner_operator_root" action="action_application"
              sequence="5"/>
</odoo>
