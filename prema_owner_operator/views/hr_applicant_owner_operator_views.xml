<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Recruitment record is the primary owner-operator review workspace.
         Everything below is read-only and appears ONLY when an owner-operator
         application is linked. Every other recruitment job keeps the stock
         form untouched. -->
    <record id="view_hr_applicant_form_owner_operator" model="ir.ui.view">
        <field name="name">hr.applicant.form.owner_operator</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="owner_operator_application_id" invisible="1"/>
                <button name="action_open_owner_operator_application"
                        type="object" string="Full Application (admin)"
                        class="btn-secondary"
                        invisible="not owner_operator_application_id"/>
                <button name="action_open_coi_emails" type="object"
                        string="Insurance Email" icon="fa-envelope"
                        invisible="not owner_operator_application_id"/>
            </xpath>

            <xpath expr="//field[@name='linkedin_profile']" position="attributes">
                <attribute name="invisible">job_id == 5</attribute>
            </xpath>

            <!-- The stock Details tab is HR metadata (salary, sourcing,
                 application type). Job 5 keeps only the fields that matter
                 and shows them under Advanced. -->
            <xpath expr="//page[@name='application_details']" position="attributes">
                <attribute name="invisible">job_id == 5</attribute>
            </xpath>
            <xpath expr="//page[@name='application_note']" position="attributes">
                <attribute name="invisible">job_id == 5</attribute>
            </xpath>
            <xpath expr="//field[@name='candidate_skill_ids']/ancestor::page"
                   position="attributes">
                <attribute name="invisible">job_id == 5</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Review" name="oo_review"
                      invisible="not owner_operator_application_id">
                    <field name="owner_operator_application_id" invisible="1"/>
                    <div class="alert alert-info" role="status">
                        <strong>Next action:</strong>
                        <field name="oo_review_next_action" readonly="1"
                               class="oe_inline"/>
                    </div>

                    <group>
                        <group string="Driver &amp; contact">
                            <field name="partner_name" readonly="1"/>
                            <field name="oo_business_name" readonly="1"
                                   invisible="not oo_business_name"/>
                            <field name="oo_business_structure" readonly="1"
                                   invisible="not oo_business_structure"/>
                            <field name="email_from" widget="email" readonly="1"/>
                            <field name="partner_phone" widget="phone" readonly="1"/>
                            <field name="oo_home_city" readonly="1"
                                   invisible="not oo_home_city"/>
                            <field name="oo_home_province" readonly="1"
                                   invisible="not oo_home_province"/>
                        </group>
                        <group string="Insurance status">
                            <field name="oo_verification_status" widget="badge"
                                   decoration-success="oo_verification_status == 'verified'"
                                   decoration-danger="oo_verification_status == 'review'"
                                   decoration-secondary="oo_verification_status == 'pending'"/>
                            <field name="oo_verification_reasons" readonly="1"
                                   invisible="not oo_verification_reasons"/>
                            <field name="oo_coi_request_sent_at" readonly="1"
                                   invisible="not oo_coi_request_sent_at"/>
                            <field name="oo_coi_email_count" readonly="1"/>
                            <button name="action_open_coi_emails" type="object"
                                    string="Open insurance emails"
                                    class="btn-link"
                                    invisible="not oo_coi_email_count"/>
                        </group>
                    </group>

                    <group>
                        <group string="Vehicle">
                            <field name="oo_vehicle_type" readonly="1"
                                   invisible="not oo_vehicle_type"/>
                            <field name="oo_cab_type" readonly="1"
                                   invisible="not oo_vehicle_type"/>
                            <field name="oo_truck_make" readonly="1"
                                   invisible="not oo_truck_make"/>
                            <field name="oo_truck_model" readonly="1"
                                   invisible="not oo_truck_model"/>
                            <field name="oo_equipment_model" readonly="1"
                                   invisible="oo_truck_make and oo_truck_model or not oo_equipment_model"/>
                            <field name="oo_unit_number" readonly="1"
                                   invisible="not oo_unit_number"/>
                            <field name="oo_license_plate" readonly="1"
                                   invisible="not oo_license_plate"/>
                            <field name="oo_plate_province" readonly="1"
                                   invisible="not oo_plate_province"/>
                            <field name="oo_truck_plate_jurisdiction" readonly="1"
                                   invisible="oo_plate_province or not oo_truck_plate_jurisdiction"/>
                        </group>
                        <group string="Operating area">
                            <field name="oo_service_provinces" readonly="1"
                                   invisible="not oo_service_provinces"/>
                            <field name="oo_preferred_service_areas"
                                   widget="many2many_tags" readonly="1"
                                   invisible="not oo_preferred_service_areas"/>
                            <field name="oo_work_preferences"
                                   widget="many2many_tags" readonly="1"
                                   invisible="not oo_work_preferences"/>
                            <field name="oo_available_start_date" readonly="1"
                                   invisible="not oo_available_start_date"/>
                        </group>
                    </group>

                    <group string="Operating authority / registration">
                        <field name="owner_operator_authority_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="owner_operator_authority_count">
                            No authority entries.
                        </div>
                        <field name="owner_operator_authority_ids" readonly="1"
                               nolabel="1"
                               invisible="not owner_operator_authority_count">
                            <list create="false" edit="false" delete="false">
                                <field name="authority_type"/>
                                <field name="jurisdiction_label"/>
                                <field name="number"/>
                                <field name="expiry_date" optional="show"/>
                                <field name="review_status" widget="badge"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"
                                       options="{'route': 'authority'}"/>
                                <button name="action_verify" type="object"
                                        icon="fa-check" title="Verify authority"
                                        invisible="review_status == 'verified'"/>
                                <button name="action_reject" type="object"
                                        icon="fa-times" title="Reject authority"
                                        invisible="review_status == 'rejected'"/>
                            </list>
                        </field>
                    </group>

                    <group string="What is missing or needs review">
                        <field name="oo_missing_initial" readonly="1"
                               invisible="not oo_missing_initial"/>
                        <field name="oo_missing_qualification" readonly="1"
                               invisible="not oo_missing_qualification"/>
                        <field name="oo_missing_verification" readonly="1"
                               invisible="not oo_missing_verification"/>
                        <field name="oo_missing_contract" readonly="1"
                               invisible="not oo_missing_contract"/>
                        <field name="oo_equipment_missing" readonly="1"
                               invisible="not oo_equipment_missing"/>
                        <field name="oo_home_base_tag_issue" readonly="1"
                               invisible="not oo_home_base_tag_issue"/>
                        <field name="oo_licence_current" readonly="1"
                               invisible="oo_licence_current"/>
                    </group>

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button name="action_owner_operator_advance"
                                type="object" string="Advance stage"
                                class="btn-primary"
                                invisible="oo_application_state in ('approved', 'rejected')"/>
                        <button name="action_owner_operator_resend_coi"
                                type="object" string="Resend COI Instructions"
                                class="btn-secondary"
                                invisible="not oo_coi_request_sent_at"/>
                        <button name="action_owner_operator_approve_verification"
                                type="object" string="Approve Verification"
                                class="btn-success"
                                invisible="oo_verification_status == 'verified'"/>
                        <button name="action_owner_operator_prepare_operator"
                                type="object" string="Operator profile"
                                class="btn-secondary"
                                invisible="oo_operator_id"/>
                        <button name="action_owner_operator_send_contract"
                                type="object" string="Send agreement"
                                class="btn-secondary"
                                invisible="oo_sign_request_id"/>
                        <button name="action_owner_operator_approve"
                                type="object" string="Approve → Fleet"
                                class="btn-success"
                                invisible="not oo_can_approve"/>
                    </div>
                    <p class="text-muted" invisible="oo_can_approve">
                        Approval becomes available when every required document
                        is verified, the licence is current, the agreement is
                        signed and an operator profile exists.
                    </p>

                    <separator string="Documents"/>
                    <p class="text-muted">
                        A received file is not a reviewed document. Verify each
                        file before approval.
                    </p>

                    <group string="Needs upload">
                        <field name="oo_document_needs_upload_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_needs_upload_count">
                            No documents need upload.
                        </div>
                        <field name="oo_document_needs_upload_ids" readonly="1"
                               invisible="not oo_document_needs_upload_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false"
                                  decoration-danger="status == 'rejected'">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <group string="Received — needs review">
                        <field name="oo_document_received_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_received_count">
                            No received files are waiting for review.
                        </div>
                        <field name="oo_document_received_ids" readonly="1"
                               invisible="not oo_document_received_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false"
                                  decoration-danger="status == 'rejected'">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <group string="Verified">
                        <field name="oo_document_verified_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_verified_count">
                            No documents verified yet.
                        </div>
                        <field name="oo_document_verified_ids" readonly="1"
                               invisible="not oo_document_verified_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false"
                                  decoration-success="status == 'verified'">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="verified_on" optional="hide"/>
                                <field name="verified_by" optional="hide"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <group string="Required later (contract)">
                        <field name="oo_document_later_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_later_count">
                            Nothing is required at the contract stage yet.
                        </div>
                        <field name="oo_document_later_ids" readonly="1"
                               invisible="not oo_document_later_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <separator string="Certificates of insurance"/>
                    <div class="alert alert-warning" role="note">
                        A received COI copy is not verified insurer coverage.
                        The insurer-direct certificate is tracked separately.
                    </div>

                    <group string="Applicant / forwarded COI copy">
                        <field name="oo_document_coi_applicant_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_coi_applicant_count">
                            No applicant COI copy on file.
                        </div>
                        <field name="oo_document_coi_applicant_ids" readonly="1"
                               invisible="not oo_document_coi_applicant_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <group string="Insurer-direct COI (requested)">
                        <field name="oo_document_coi_insurer_count" invisible="1"/>
                        <div class="text-muted"
                             invisible="oo_document_coi_insurer_count">
                            No insurer-direct COI on file.
                        </div>
                        <field name="oo_document_coi_insurer_ids" readonly="1"
                               invisible="not oo_document_coi_insurer_count"
                               nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="document_type"/>
                                <field name="status" widget="badge"/>
                                <field name="source"/>
                                <field name="received_on" optional="show"/>
                                <field name="file_name" optional="show"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"/>
                            </list>
                        </field>
                    </group>

                    <group string="Received COI versions (original files)">
                        <field name="oo_coi_version_count" invisible="1"/>
                        <div class="text-muted" invisible="oo_coi_version_count">
                            No received COI versions yet.
                        </div>
                        <field name="oo_coi_version_ids" readonly="1"
                               invisible="not oo_coi_version_count" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="received_date"/>
                                <field name="is_current"/>
                                <field name="expiry_date"/>
                                <field name="insurer_name"/>
                                <field name="policy_number"/>
                                <field name="source"/>
                                <field name="extraction_state"/>
                                <field name="verification_status"/>
                                <field name="file_name"/>
                                <field name="mimetype" column_invisible="1"/>
                                <field name="can_preview"
                                       widget="owner_operator_document_view"
                                       options="{'route': 'coi_version'}"/>
                            </list>
                        </field>
                    </group>
                </page>

                <page string="Driver &amp; Vehicle" name="oo_details"
                      invisible="not owner_operator_application_id">
                    <field name="owner_operator_application_id" invisible="1"/>
                    <group>
                        <group string="Driver licence">
                            <field name="oo_licence_class" readonly="1"
                                   invisible="not oo_licence_class"/>
                            <field name="oo_licence_expiry" readonly="1"
                                   invisible="not oo_licence_expiry"/>
                            <field name="oo_licence_suspension" readonly="1"
                                   invisible="not oo_licence_suspension"/>
                            <field name="oo_licence_current" readonly="1"/>
                        </group>
                        <group string="Experience &amp; TDG">
                            <field name="oo_commercial_driving_experience" readonly="1"
                                   invisible="not oo_commercial_driving_experience"/>
                            <field name="oo_owner_operator_experience" readonly="1"
                                   invisible="not oo_owner_operator_experience"/>
                            <field name="oo_tdg_status" readonly="1"
                                   invisible="not oo_tdg_status"/>
                            <field name="oo_tdg_class_ids"
                                   widget="many2many_tags" readonly="1"
                                   invisible="not oo_tdg_class_ids"/>
                            <field name="oo_tdg_special_training" readonly="1"
                                   invisible="not oo_tdg_special_training"/>
                        </group>
                    </group>
                    <group>
                        <group string="Driving history">
                            <field name="oo_recent_collisions" readonly="1"
                                   invisible="not oo_recent_collisions"/>
                            <field name="oo_recent_convictions" readonly="1"
                                   invisible="not oo_recent_convictions"/>
                            <field name="oo_recent_driving_work" readonly="1"
                                   invisible="not oo_recent_driving_work"/>
                        </group>
                        <group string="Load notifications (one preference)">
                            <field name="oo_load_notification_channel" readonly="1"
                                   invisible="not oo_load_notification_channel"/>
                            <field name="oo_load_notification_email" readonly="1"
                                   invisible="not oo_load_notification_email"/>
                            <field name="oo_whatsapp_number" readonly="1"
                                   invisible="not oo_whatsapp_number"/>
                            <field name="oo_whatsapp_consent_granted" readonly="1"
                                   invisible="oo_load_notification_channel not in ('whatsapp', 'both')"/>
                            <field name="oo_load_notification_opt_out" readonly="1"
                                   invisible="not oo_load_notification_opt_out"/>
                        </group>
                    </group>

                    <separator string="Vehicle &amp; equipment"/>
                    <group>
                        <group string="Vehicle">
                            <field name="oo_vehicle_ownership" readonly="1"
                                   invisible="not oo_vehicle_ownership"/>
                            <field name="oo_transmission" readonly="1"
                                   invisible="not oo_transmission"/>
                            <field name="oo_odometer_km" readonly="1"
                                   invisible="not oo_odometer_km"/>
                            <field name="oo_gvwr_lbs" readonly="1"
                                   invisible="not oo_gvwr_lbs"/>
                            <field name="oo_air_ride" readonly="1"
                                   invisible="not oo_air_ride"/>
                            <field name="oo_dock_height_capable" readonly="1"
                                   invisible="not oo_dock_height_capable"/>
                            <field name="oo_reefer_applicable" readonly="1"
                                   invisible="not oo_reefer_applicable"/>
                            <field name="oo_reefer_temperature_range" readonly="1"
                                   invisible="not oo_reefer_temperature_range"/>
                        </group>
                        <group string="Cargo body">
                            <field name="oo_cargo_body_type" readonly="1"
                                   invisible="not oo_cargo_body_type"/>
                            <field name="oo_cargo_door_style" readonly="1"
                                   invisible="not oo_cargo_door_style"/>
                            <field name="oo_payload_lbs" readonly="1"
                                   invisible="not oo_payload_lbs"/>
                            <field name="oo_pallet_capacity" readonly="1"
                                   invisible="not oo_pallet_capacity"/>
                            <field name="oo_box_length_ft" readonly="1"
                                   invisible="not oo_box_length_ft"/>
                            <field name="oo_cargo_height_in" readonly="1"
                                   invisible="not oo_cargo_height_in"/>
                            <field name="oo_door_clearance_in" readonly="1"
                                   invisible="not oo_door_clearance_in"/>
                        </group>
                    </group>
                    <group>
                        <group string="Liftgate">
                            <field name="oo_liftgate" readonly="1"
                                   invisible="not oo_liftgate"/>
                            <field name="oo_liftgate_capacity_lb" readonly="1"
                                   invisible="not oo_liftgate_capacity_lb"/>
                            <field name="oo_liftgate_platform_length_in" readonly="1"
                                   invisible="not oo_liftgate_platform_length_in"/>
                            <field name="oo_liftgate_platform_width_in" readonly="1"
                                   invisible="not oo_liftgate_platform_width_in"/>
                        </group>
                        <group string="Trailer (Semi-Truck)"
                               invisible="not oo_trailer_type and not oo_trailer_unit">
                            <field name="oo_trailer_ownership" readonly="1"
                                   invisible="not oo_trailer_ownership"/>
                            <field name="oo_trailer_type" readonly="1"
                                   invisible="not oo_trailer_type"/>
                            <field name="oo_trailer_door_style" readonly="1"
                                   invisible="not oo_trailer_door_style"/>
                            <field name="oo_trailer_year" readonly="1"
                                   invisible="not oo_trailer_year"/>
                            <field name="oo_trailer_length_ft" readonly="1"
                                   invisible="not oo_trailer_length_ft"/>
                            <field name="oo_trailer_unit" readonly="1"
                                   invisible="not oo_trailer_unit"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="applicant_notes" nolabel="1" readonly="1"/>
                        <field name="oo_additional_notes" nolabel="1" readonly="1"
                               invisible="not oo_additional_notes"/>
                    </group>
                </page>

                <page string="Advanced" name="oo_advanced"
                      invisible="not owner_operator_application_id">
                    <field name="owner_operator_application_id" invisible="1"/>
                    <group>
                        <group string="Location diagnostics">
                            <field name="oo_home_city_place_id" readonly="1"/>
                            <field name="oo_home_latitude" readonly="1"/>
                            <field name="oo_home_longitude" readonly="1"/>
                            <field name="oo_home_location_verified" readonly="1"/>
                            <field name="oo_home_location_review" readonly="1"/>
                            <field name="oo_home_location_review_reason" readonly="1"/>
                        </group>
                        <group string="CVOR diagnostics">
                            <field name="oo_cvor_number" readonly="1"/>
                            <field name="oo_cvor_verification_status" readonly="1"/>
                            <field name="oo_cvor_extraction_status" readonly="1"/>
                            <field name="oo_cvor_proposed_number" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="COI request diagnostics">
                            <field name="oo_coi_request_count" readonly="1"/>
                            <field name="oo_coi_request_sent_at" readonly="1"/>
                            <field name="oo_coi_email_count" readonly="1"/>
                            <field name="oo_setup_email_sent_at" readonly="1"/>
                        </group>
                        <group string="Legacy insurance agent">
                            <field name="oo_insurance_agent_name" readonly="1"/>
                            <field name="oo_insurance_agent_email" readonly="1"/>
                        </group>
                    </group>
                    <group string="COI emails (raw queue)">
                        <field name="oo_coi_email_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="received_date"/>
                                <field name="sender_email"/>
                                <field name="subject"/>
                                <field name="state" widget="badge"/>
                                <field name="match_reason"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group string="Agreement / Fleet audit">
                            <field name="oo_sign_request_id" readonly="1"/>
                            <field name="oo_contract_signed_on" readonly="1"/>
                            <field name="oo_operator_id" readonly="1"/>
                            <field name="oo_fleet_vehicle_id" readonly="1"/>
                            <field name="oo_approved_on" readonly="1"/>
                        </group>
                        <group string="Declaration &amp; consent">
                            <field name="oo_application_declaration" readonly="1"/>
                            <field name="oo_whatsapp_consent_at" readonly="1"/>
                            <field name="oo_whatsapp_consent_version" readonly="1"/>
                        </group>
                    </group>
                    <group string="HR metadata (stock fields)">
                        <field name="department_id" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="source_id" readonly="1"/>
                        <field name="medium_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Owner-operator verification badge on the applicant kanban card. -->
    <record id="view_hr_applicant_kanban_owner_operator" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.owner_operator</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="decoration-danger">oo_verification_status == 'review'</attribute>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="oo_verification_status"/>
                <field name="oo_verification_reasons"/>
                <field name="oo_coi_email_count"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.oo_verification_status.raw_value == 'review'"
                     class="border border-danger border-2 rounded p-1 mb-1">
                    <field name="oo_verification_status" widget="badge"
                           decoration-danger="True"/>
                    <div class="small text-danger mt-1"
                         t-esc="record.oo_verification_reasons.raw_value"/>
                </div>
                <div t-elif="record.oo_verification_status.raw_value == 'verified'"
                     class="mb-1">
                    <field name="oo_verification_status" widget="badge"
                           decoration-success="True"/>
                </div>
                <div t-elif="record.oo_verification_status.raw_value == 'pending'"
                     class="mb-1">
                    <field name="oo_verification_status" widget="badge"
                           decoration-secondary="True"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
