<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone page: no website navigation and no footer. This is an
         application reached directly from Indeed, not a browsing
         destination. The field names are the LIVE website names (view
         5600), so the same answers and the saved "Other Information" notes
         map without translation loss. -->
    <template id="apply_form" name="Owner-Operator Application">
        <html t-att-data-website-id="request.website.id"
              t-att-data-main-object="repr(job) if job else None">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Owner-Operator Application — PremaFirm Logistics</title>
                <t t-call-assets="web.assets_frontend"/>
            </head>
            <body class="o_oo_apply">
                <main class="o_oo_apply_shell">
                    <header class="o_oo_apply_head">
                        <h1>Owner-Operator Application</h1>
                        <p class="o_oo_apply_sub">
                            Canada-only opportunities. Independent operators
                            offering their own equipment.
                        </p>
                    </header>

                    <div t-if="errors" class="o_oo_apply_errors" role="alert">
                        <p><strong>Please correct the following:</strong></p>
                        <ul><li t-foreach="errors" t-as="e" t-esc="e"/></ul>
                    </div>
                    <div t-if="not job" class="o_oo_apply_errors">
                        This position is not currently open.
                    </div>

                    <form t-if="job" method="post" enctype="multipart/form-data"
                          action="/owner-operator/apply"
                          class="o_oo_apply_form" id="oo_apply_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <fieldset>
                            <legend>Your details</legend>
                            <div class="o_oo_row">
                                <label>Your name <span class="o_oo_req">*</span>
                                    <input type="text" name="partner_name" required="required"
                                           maxlength="120" t-att-value="post.get('partner_name', '')"/></label>
                                <label>Your email <span class="o_oo_req">*</span>
                                    <input type="email" name="email_from" required="required"
                                           maxlength="160" t-att-value="post.get('email_from', '')"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Your phone number <span class="o_oo_req">*</span>
                                    <input type="tel" name="partner_phone" required="required"
                                           maxlength="40" t-att-value="post.get('partner_phone', '')"/></label>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>1. Business &amp; home base</legend>
                            <p class="o_oo_hint">Enter the city and province
                                where your truck normally parks or returns
                                between jobs. We use this home base to identify
                                nearby load opportunities. No street address is
                                required at this stage.</p>
                            <div class="o_oo_row">
                                <label>Legal business / owner name <span class="o_oo_req">*</span>
                                    <input type="text" name="LegalBusinessName" required="required"
                                           maxlength="200" t-att-value="post.get('LegalBusinessName', '')"/></label>
                                <label>Business structure <span class="o_oo_req">*</span>
                                    <select name="BusinessStructure" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="[('sole','Sole proprietor'),('corporation','Corporation'),('partnership','Partnership')]"
                                                t-as="opt" t-att-value="opt[0]"
                                                t-att-selected="post.get('BusinessStructure') == opt[0]"
                                                t-esc="opt[1]"/>
                                    </select></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Truck home city <span class="o_oo_req">*</span>
                                    <input type="text" name="HomeCity" required="required"
                                           maxlength="120" t-att-value="post.get('HomeCity', '')"/></label>
                                <label>Home province / territory <span class="o_oo_req">*</span>
                                    <select name="HomeProvince" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="[('ON','Ontario'),('QC','Quebec'),('AB','Alberta'),('BC','British Columbia'),('MB','Manitoba'),('NB','New Brunswick'),('NL','Newfoundland and Labrador'),('NS','Nova Scotia'),('NT','Northwest Territories'),('NU','Nunavut'),('PE','Prince Edward Island'),('SK','Saskatchewan'),('YT','Yukon'),('other','Other — explain in notes')]"
                                                t-as="opt" t-att-value="opt[0]"
                                                t-att-selected="post.get('HomeProvince') == opt[0]"
                                                t-esc="opt[1]"/>
                                    </select></label>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>2. Driving experience</legend>
                            <div class="o_oo_row">
                                <label>Commercial driving experience <span class="o_oo_req">*</span>
                                    <select name="CommercialDrivingYears" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="['Less than 1 year','1–2 years','3–5 years','6–10 years','11–15 years','16+ years']"
                                                t-as="opt" t-att-value="opt"
                                                t-att-selected="post.get('CommercialDrivingYears') == opt"
                                                t-esc="opt"/>
                                    </select></label>
                                <label>Driver licence class <span class="o_oo_req">*</span>
                                    <select name="DriverLicenceClass" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="[('AZ','AZ / Class 1'),('DZ','DZ / Class 3'),('G','G / Class 5'),('other','Other — explain in notes')]"
                                                t-as="opt" t-att-value="opt[0]"
                                                t-att-selected="post.get('DriverLicenceClass') == opt[0]"
                                                t-esc="opt[1]"/>
                                    </select></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Licence issuing province / territory <span class="o_oo_req">*</span>
                                    <input type="text" name="LicenceJurisdiction" required="required"
                                           maxlength="80" t-att-value="post.get('LicenceJurisdiction', '')"/></label>
                                <label>Owner-operator experience
                                    <select name="OwnerOperatorYears">
                                        <option value="">Please select</option>
                                        <option t-foreach="['New owner-operator','Less than 1 year','1–2 years','3–5 years','6–10 years','11–15 years','16+ years']"
                                                t-as="opt" t-att-value="opt"
                                                t-att-selected="post.get('OwnerOperatorYears') == opt"
                                                t-esc="opt"/>
                                    </select></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Licence ever suspended / revoked? <span class="o_oo_req">*</span>
                                    <select name="LicenceSuspension" required="required">
                                        <option value="">Please select</option>
                                        <option value="No" t-att-selected="post.get('LicenceSuspension') == 'No'">No</option>
                                        <option value="Yes" t-att-selected="post.get('LicenceSuspension') == 'Yes'">Yes — explain in notes</option>
                                    </select></label>
                                <label>Collisions in the past 3 years <span class="o_oo_req">*</span>
                                    <select name="RecentCollisions" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="['None','1','2','3+']" t-as="opt"
                                                t-att-value="opt" t-att-selected="post.get('RecentCollisions') == opt"
                                                t-esc="opt"/>
                                    </select></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Driving convictions in the past 3 years <span class="o_oo_req">*</span>
                                    <select name="RecentConvictions" required="required">
                                        <option value="">Please select</option>
                                        <option t-foreach="['None','1','2','3+']" t-as="opt"
                                                t-att-value="opt" t-att-selected="post.get('RecentConvictions') == opt"
                                                t-esc="opt"/>
                                    </select></label>
                                <label>Current dangerous goods training
                                    <select name="TDGTraining">
                                        <option value="">Please select</option>
                                        <option value="Yes" t-att-selected="post.get('TDGTraining') == 'Yes'">Yes — current certificate</option>
                                        <option value="No" t-att-selected="post.get('TDGTraining') == 'No'">No</option>
                                        <option value="Expired" t-att-selected="post.get('TDGTraining') == 'Expired'">Expired / renewal needed</option>
                                    </select></label>
                            </div>
                            <label>Recent driving work / client history (optional)
                                <input type="text" name="RecentDrivingWork" maxlength="255"
                                       placeholder="Most recent company/client, dates and equipment operated"
                                       t-att-value="post.get('RecentDrivingWork', '')"/></label>
                            <p class="o_oo_hint">Driver licence copies and expiry are requested privately at Initial Qualification. Do not upload licence copies in the initial application.</p>
                        </fieldset>

                        <fieldset>
                            <legend>3. Your vehicle</legend>
                            <div class="o_oo_row">
                                <label>Vehicle type <span class="o_oo_req">*</span>
                                    <select name="VehicleType" id="oo_VehicleType" required="required"
                                            onchange="ooSyncVehicle(this.value);">
                                        <option value="">Please select</option>
                                        <option value="cargo_van" t-att-selected="post.get('VehicleType') == 'cargo_van'">Cargo Van</option>
                                        <option value="straight" t-att-selected="post.get('VehicleType') == 'straight'">Straight Truck</option>
                                        <option value="tractor" t-att-selected="post.get('VehicleType') == 'tractor'">Tractor / Power Unit</option>
                                    </select></label>
                                <label>Truck make and model <span class="o_oo_req">*</span>
                                    <input type="text" name="TruckMakeModel" required="required"
                                           maxlength="120" t-att-value="post.get('TruckMakeModel', '')"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Model year
                                    <select name="TruckYear">
                                        <option value="">Please select</option>
                                        <option t-foreach="['2027','2026','2025','2024','2023','2022','2021','2020','2019','2018','2017','2016','2015','2014','2013','2012','2011','2010','2009','2008','2007','2006','2005','2004','2003','2002','2001','2000 or earlier']"
                                                t-as="opt" t-att-value="opt"
                                                t-att-selected="post.get('TruckYear') == opt"
                                                t-esc="opt"/>
                                    </select></label>
                                <label>Unit number
                                    <input type="text" name="UnitNumber" maxlength="40"
                                           t-att-value="post.get('UnitNumber', '')"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Do you own or lease this vehicle? <span class="o_oo_req">*</span>
                                    <select name="VehicleOwnership" required="required">
                                        <option value="">Please select</option>
                                        <option value="Own" t-att-selected="post.get('VehicleOwnership') == 'Own'">Own</option>
                                        <option value="Lease" t-att-selected="post.get('VehicleOwnership') == 'Lease'">Lease</option>
                                        <option value="Financed" t-att-selected="post.get('VehicleOwnership') == 'Financed'">Financed</option>
                                    </select></label>
                                <label>Transmission
                                    <select name="Transmission">
                                        <option value="">Please select</option>
                                        <option value="Automatic" t-att-selected="post.get('Transmission') == 'Automatic'">Automatic</option>
                                        <option value="Manual" t-att-selected="post.get('Transmission') == 'Manual'">Manual / standard</option>
                                        <option value="Automated manual" t-att-selected="post.get('Transmission') == 'Automated manual'">Automated manual</option>
                                    </select></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Current odometer reading (km) <span class="o_oo_req">*</span>
                                    <input type="number" name="OdometerKm" required="required"
                                           min="0" max="9999999" step="1" placeholder="e.g. 350000"
                                           t-att-value="post.get('OdometerKm', '')"/></label>
                                <label>Licence plate and province / territory <span class="o_oo_req">*</span>
                                    <input type="text" name="TruckPlateJurisdiction" required="required"
                                           maxlength="80" placeholder="e.g. ABC 123 / Ontario"
                                           t-att-value="post.get('TruckPlateJurisdiction', '')"/></label>
                            </div>

                            <div class="oo-cargo-field">
                                <p class="o_oo_hint" id="oo-cargo-note">Enter the
                                    cargo specifications of the truck. For a
                                    tractor with your own/leased trailer, enter
                                    the trailer’s specifications here. For
                                    power-only work, leave these blank — the
                                    assigned trailer supplies them.</p>
                                <div class="o_oo_row">
                                    <label>Cargo body type (van / straight truck / owned trailer) <span class="o_oo_req">*</span>
                                        <select name="CargoBodyType" required="required">
                                            <option value="">Please select</option>
                                            <option value="dry" t-att-selected="post.get('CargoBodyType') == 'dry'">Dry freight</option>
                                            <option value="reefer" t-att-selected="post.get('CargoBodyType') == 'reefer'">Refrigerated / reefer</option>
                                            <option value="both" t-att-selected="post.get('CargoBodyType') == 'both'">Reefer and dry capable</option>
                                            <option value="other" t-att-selected="post.get('CargoBodyType') == 'other'">Other / not applicable</option>
                                        </select></label>
                                    <label>Legal cargo payload (lb) <span class="o_oo_req">*</span>
                                        <input type="number" name="LegalPayloadLb" min="0" max="150000"
                                               required="required"
                                               t-att-value="post.get('LegalPayloadLb', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Pallet capacity <span class="o_oo_req">*</span>
                                        <input type="number" name="PalletCapacity" min="0" max="60" step="1"
                                               required="required"
                                               t-att-value="post.get('PalletCapacity', '')"/></label>
                                    <label>Cargo interior length (ft) <span class="o_oo_req">*</span>
                                        <input type="number" name="CargoLengthFt" min="0" max="60" step="0.1"
                                               required="required"
                                               t-att-value="post.get('CargoLengthFt', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Cargo interior width (in) <span class="o_oo_req">*</span>
                                        <input type="number" name="CargoWidthIn" min="0" max="120" step="0.1"
                                               required="required"
                                               t-att-value="post.get('CargoWidthIn', '')"/></label>
                                    <label>Cargo interior height (in) <span class="o_oo_req">*</span>
                                        <input type="number" name="CargoHeightIn" min="0" max="150" step="0.1"
                                               required="required"
                                               t-att-value="post.get('CargoHeightIn', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Rear door opening width (in) <span class="o_oo_req">*</span>
                                        <input type="number" name="DoorWidthIn" min="0" max="150" step="0.1"
                                               required="required"
                                               t-att-value="post.get('DoorWidthIn', '')"/></label>
                                    <label>Rear door opening height (in) <span class="o_oo_req">*</span>
                                        <input type="number" name="DoorHeightIn" min="0" max="150" step="0.1"
                                               required="required"
                                               t-att-value="post.get('DoorHeightIn', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Liftgate <span class="o_oo_req">*</span>
                                        <select name="Liftgate" required="required">
                                            <option value="">Please select</option>
                                            <option value="yes" t-att-selected="post.get('Liftgate') == 'yes'">Yes</option>
                                            <option value="no" t-att-selected="post.get('Liftgate') == 'no'">No</option>
                                        </select></label>
                                    <label>Liftgate capacity (lb), if equipped
                                        <input type="number" name="LiftgateCapacityLb" min="0" max="20000"
                                               t-att-value="post.get('LiftgateCapacityLb', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Liftgate usable platform length (in), if equipped
                                        <input type="number" name="LiftgatePlatformLengthIn" min="0" max="150" step="0.1"
                                               t-att-value="post.get('LiftgatePlatformLengthIn', '')"/></label>
                                    <label>Liftgate usable platform width (in), if equipped
                                        <input type="number" name="LiftgatePlatformWidthIn" min="0" max="150" step="0.1"
                                               t-att-value="post.get('LiftgatePlatformWidthIn', '')"/></label>
                                </div>
                                <div class="o_oo_row">
                                    <label>Dock-height capable
                                        <select name="DockHeightCapable">
                                            <option value="">Please select</option>
                                            <option value="yes" t-att-selected="post.get('DockHeightCapable') == 'yes'">Yes</option>
                                            <option value="no" t-att-selected="post.get('DockHeightCapable') == 'no'">No</option>
                                        </select></label>
                                    <label>Reefer temperature range, if equipped
                                        <input type="text" name="ReeferTemperatureRange" maxlength="80"
                                               t-att-value="post.get('ReeferTemperatureRange', '')"/></label>
                                </div>
                            </div>

                            <div id="oo-trailer-group" hidden="hidden">
                                <div class="o_oo_row">
                                    <label>Do you have your own trailer? <span class="o_oo_req">*</span>
                                        <select name="TrailerOwnership" id="oo_TrailerOwnership" disabled="disabled"
                                                onchange="ooSyncTrailer(this.value);">
                                            <option value="">Please select</option>
                                            <option value="own" t-att-selected="post.get('TrailerOwnership') == 'own'">Yes — my own / leased trailer</option>
                                            <option value="power_only" t-att-selected="post.get('TrailerOwnership') == 'power_only'">No — power-only work</option>
                                        </select></label>
                                </div>
                                <div id="oo-trailer-details" hidden="hidden">
                                    <div class="o_oo_row">
                                        <label>Trailer type <span class="o_oo_req">*</span>
                                            <select name="TrailerType" id="oo_TrailerType" disabled="disabled">
                                                <option value="">Please select</option>
                                                <option value="dry" t-att-selected="post.get('TrailerType') == 'dry'">Dry Van</option>
                                                <option value="reefer" t-att-selected="post.get('TrailerType') == 'reefer'">Reefer</option>
                                                <option value="flatbed" t-att-selected="post.get('TrailerType') == 'flatbed'">Flatbed</option>
                                                <option value="other" t-att-selected="post.get('TrailerType') == 'other'">Other — explain in notes</option>
                                            </select></label>
                                        <label>Trailer length (ft)
                                            <input type="number" name="TrailerLengthFt" min="1" max="60" step="0.5"
                                                   disabled="disabled" t-att-value="post.get('TrailerLengthFt', '')"/></label>
                                    </div>
                                    <div class="o_oo_row">
                                        <label>Trailer unit / identification
                                            <input type="text" name="TrailerUnit" disabled="disabled"
                                                   maxlength="60" t-att-value="post.get('TrailerUnit', '')"/></label>
                                    </div>
                                </div>
                            </div>

                            <div class="o_oo_row">
                                <label>Air ride suspension
                                    <select name="AirRide">
                                        <option value="">Please select</option>
                                        <option value="yes" t-att-selected="post.get('AirRide') == 'yes'">Yes</option>
                                        <option value="no" t-att-selected="post.get('AirRide') == 'no'">No</option>
                                    </select></label>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>4. Authority &amp; insurance</legend>
                            <p class="o_oo_hint">Authority lookup is not connected yet. All credentials require manual review.</p>
                            <div class="o_oo_row">
                                <label>Ontario CVOR number, if applicable
                                    <input type="text" name="CVORNumber" inputmode="numeric" maxlength="11"
                                           placeholder="123-456-789" pattern="[0-9]{3}-[0-9]{3}-[0-9]{3}"
                                           title="Enter your 9-digit CVOR number, for example 123-456-789."
                                           oninput="ooFormatCvor(this);"
                                           t-att-value="post.get('CVORNumber', '')"/>
                                    <span class="o_oo_hint">Enter your 9-digit Ontario CVOR number. Hyphens are added automatically. Leave blank if not applicable.</span></label>
                            </div>
                            <p class="o_oo_hint"><strong>Where in Canada will you operate?</strong> Select all provinces / territories you are willing to serve.</p>
                            <div class="o_oo_checks">
                                <label class="o_oo_check" t-foreach="[('ON','Ontario'),('QC','Quebec'),('AB','Alberta'),('BC','British Columbia'),('MB','Manitoba'),('NB','New Brunswick'),('NL','Newfoundland and Labrador'),('NS','Nova Scotia'),('PE','Prince Edward Island'),('SK','Saskatchewan'),('NT','Northwest Territories'),('NU','Nunavut'),('YT','Yukon')]"
                                       t-as="prov">
                                    <input type="checkbox" t-att-name="'ServiceProvince' + prov[0]"
                                           t-att-value="prov[1]"
                                           t-att-checked="bool(post.get('ServiceProvince' + prov[0]))"/>
                                    <span t-esc="prov[1]"/>
                                </label>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>5. Documents &amp; truck photos</legend>
                            <p class="o_oo_hint">Upload PDF, JPG or PNG. Applicant COI is preliminary; an insurer-direct COI is requested at qualification. Corporate documents apply to incorporated businesses.</p>
                            <div class="o_oo_row">
                                <label>CVOR / provincial certificate
                                    <input type="file" name="CVORCertificate" accept=".pdf,.jpg,.jpeg,.png"/></label>
                                <label>Current Certificate of Insurance
                                    <input type="file" name="InsuranceCertificate" accept=".pdf,.jpg,.jpeg,.png"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Business / corporate registration
                                    <input type="file" name="BusinessRegistration" accept=".pdf,.jpg,.jpeg,.png"/></label>
                                <label>Vehicle registration / inspection
                                    <input type="file" name="VehicleRegistrationInspection" accept=".pdf,.jpg,.jpeg,.png"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Truck front photo
                                    <input type="file" name="TruckFront" accept=".jpg,.jpeg,.png"/></label>
                                <label>Truck rear photo
                                    <input type="file" name="TruckRear" accept=".jpg,.jpeg,.png"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Driver-side photo
                                    <input type="file" name="TruckDriverSide" accept=".jpg,.jpeg,.png"/></label>
                                <label>Passenger-side photo
                                    <input type="file" name="TruckPassengerSide" accept=".jpg,.jpeg,.png"/></label>
                            </div>
                            <div class="o_oo_row">
                                <label>Cargo interior / trailer photo
                                    <input type="file" name="CargoInterior" accept=".jpg,.jpeg,.png"/></label>
                            </div>
                            <p class="o_oo_hint">PDF, JPG, PNG or WEBP · 10 MB max each. Files are stored privately.</p>
                        </fieldset>

                        <fieldset>
                            <legend>6. Availability &amp; preferences</legend>
                            <p class="o_oo_hint"><strong>Preferred service areas</strong> — select all that apply.</p>
                            <div class="o_oo_checks">
                                <label class="o_oo_check" t-foreach="[('PreferredAreaTorontoGTA','Toronto / GTA'),('PreferredAreaOntarioWide','Ontario wide'),('PreferredAreaQuebec','Quebec'),('PreferredAreaOntarioQuebec','Ontario and Quebec'),('PreferredAreaCanadaWide','Canada wide'),('PreferredAreaSelectedProvinces','Selected provinces')]"
                                       t-as="area">
                                    <input type="checkbox" t-att-name="area[0]"
                                           value="1"
                                           t-att-checked="bool(post.get(area[0]))"/>
                                    <span t-esc="area[1]"/>
                                </label>
                            </div>
                            <div class="o_oo_row">
                                <label>Available start date
                                    <input type="date" name="AvailabilityDate"
                                           t-att-value="post.get('AvailabilityDate', '')"/></label>
                            </div>
                            <p class="o_oo_hint"><strong>Work preference</strong> — select all that apply.</p>
                            <div class="o_oo_checks">
                                <label class="o_oo_check" t-foreach="[('WorkPreferenceLocal','Local'),('WorkPreferenceRegional','Regional'),('WorkPreferenceLonghaul','Long haul'),('WorkPreferenceFlexible','Flexible')]"
                                       t-as="pref">
                                    <input type="checkbox" t-att-name="pref[0]"
                                           value="1"
                                           t-att-checked="bool(post.get(pref[0]))"/>
                                    <span t-esc="pref[1]"/>
                                </label>
                            </div>
                            <div class="o_oo_row">
                                <label>How should we send load quote requests? <span class="o_oo_req">*</span>
                                    <select name="LoadNotificationChannel" id="oo_LoadNotificationChannel"
                                            required="required"
                                            onchange="ooSyncNotification(this.value);">
                                        <option value="">Please select</option>
                                        <option value="whatsapp" t-att-selected="post.get('LoadNotificationChannel') == 'whatsapp'">WhatsApp</option>
                                        <option value="email" t-att-selected="post.get('LoadNotificationChannel') == 'email'">Email</option>
                                    </select></label>
                                <label class="o_oo_check">
                                    <input type="checkbox" name="LoadNotificationOptOut" value="1"
                                           t-att-checked="bool(post.get('LoadNotificationOptOut'))"/>
                                    Do not send me load-notification messages.
                                </label>
                            </div>
                            <div id="oo-notify-whatsapp" hidden="hidden">
                                <div class="o_oo_row">
                                    <label>WhatsApp number including country code <span class="o_oo_req">*</span>
                                        <input type="tel" name="WhatsAppNumber" id="oo_WhatsAppNumber"
                                               placeholder="+1 416 555 0199"
                                               t-att-value="post.get('WhatsAppNumber', '')"/></label>
                                    <label class="o_oo_check">
                                        <input type="checkbox" name="UseContactPhoneForWhatsApp" value="1"
                                               t-att-checked="bool(post.get('UseContactPhoneForWhatsApp'))"
                                               onchange="ooSyncNotification(document.getElementById('oo_LoadNotificationChannel').value);"/>
                                        Use my contact phone number
                                    </label>
                                </div>
                                <label class="o_oo_check">
                                    <input type="checkbox" name="WhatsAppConsentGranted" id="oo_WhatsAppConsentGranted"
                                           value="1"
                                           t-att-checked="bool(post.get('WhatsAppConsentGranted'))"/>
                                    I agree to receive load quote requests and load offers by WhatsApp at the number I provided. I may change this preference or opt out at any time. <span class="o_oo_req">*</span>
                                </label>
                            </div>
                            <div id="oo-notify-email" hidden="hidden">
                                <div class="o_oo_row">
                                    <label>Load-notification email <span class="o_oo_req">*</span>
                                        <input type="email" name="LoadNotificationEmail" id="oo_LoadNotificationEmail"
                                               maxlength="160"
                                               t-att-value="post.get('LoadNotificationEmail', '')"/></label>
                                    <label class="o_oo_check">
                                        <input type="checkbox" name="UseApplicationEmailForNotifications" value="1"
                                               t-att-checked="bool(post.get('UseApplicationEmailForNotifications'))"
                                               onchange="ooSyncNotification(document.getElementById('oo_LoadNotificationChannel').value);"/>
                                        Use my application email
                                    </label>
                                </div>
                            </div>
                            <label>Additional information / equipment notes
                                <textarea name="applicant_notes" rows="4"
                                          placeholder="Tell us about your equipment, availability or questions."
                                          t-esc="post.get('applicant_notes', '')"/></label>
                            <label class="o_oo_check">
                                <input type="checkbox" name="ApplicationDeclaration" value="Confirmed"
                                       required="required"
                                       t-att-checked="bool(post.get('ApplicationDeclaration'))"/>
                                I confirm this is my application and the information is accurate. I have read the privacy notice. <span class="o_oo_req">*</span>
                            </label>
                        </fieldset>

                        <button type="submit" class="o_oo_submit">Submit Application</button>
                        <p class="o_oo_hint">
                            Your documents are stored privately and are visible
                            only to the PremaFirm onboarding team.
                        </p>
                    </form>
                </main>
                <script><![CDATA[
                    function ooFormatCvor(input) {
                        var digits = input.value.replace(/[^0-9]/g, "").slice(0, 9);
                        input.value = (digits.match(/.{1,3}/g) || []).join("-");
                    }
                    function ooSyncCargo() {
                        var vehicle = document.getElementById("oo_VehicleType");
                        var own = document.getElementById("oo_TrailerOwnership");
                        var tractor = vehicle && vehicle.value === "tractor";
                        var showCargo = !tractor || (own && own.value === "own");
                        document.querySelectorAll(".oo-cargo-field").forEach(function (group) {
                            group.hidden = !showCargo;
                            group.querySelectorAll("input,select").forEach(function (el) {
                                el.disabled = !showCargo;
                            });
                        });
                        var note = document.getElementById("oo-cargo-note");
                        if (note) {
                            note.textContent = tractor
                                ? "Enter the specifications of your actual trailer. For power-only work, leave these blank — the assigned trailer supplies them."
                                : "Enter the cargo specifications of the truck. Do not estimate them from a nominal truck length.";
                        }
                    }
                    function ooSyncVehicle(value) {
                        var tractor = value === "tractor";
                        var trailer = document.getElementById("oo-trailer-group");
                        if (trailer) {
                            trailer.hidden = !tractor;
                            trailer.querySelectorAll("select,input").forEach(function (el) {
                                el.disabled = !tractor;
                            });
                            var own = document.getElementById("oo_TrailerOwnership");
                            if (own) { own.required = tractor; }
                        }
                        var details = document.getElementById("oo-trailer-details");
                        if (details) {
                            details.hidden = true;
                            details.querySelectorAll("select,input").forEach(function (el) {
                                el.disabled = true;
                            });
                        }
                        ooSyncCargo();
                    }
                    function ooSyncTrailer(value) {
                        var details = document.getElementById("oo-trailer-details");
                        if (!details) { return; }
                        var own = value === "own";
                        details.hidden = !own;
                        details.querySelectorAll("select,input").forEach(function (el) {
                            el.disabled = !own;
                        });
                        var type = document.getElementById("oo_TrailerType");
                        if (type) { type.required = own; }
                        ooSyncCargo();
                    }
                    function ooSyncNotification(value) {
                        var wa = document.getElementById("oo-notify-whatsapp");
                        var em = document.getElementById("oo-notify-email");
                        var whatsapp = value === "whatsapp";
                        var email = value === "email";
                        if (wa) {
                            wa.hidden = !whatsapp;
                            wa.querySelectorAll("input").forEach(function (el) {
                                el.disabled = !whatsapp;
                            });
                        }
                        if (em) {
                            em.hidden = !email;
                            em.querySelectorAll("input").forEach(function (el) {
                                el.disabled = !email;
                            });
                        }
                        var usePhone = document.querySelector(
                            "input[name=UseContactPhoneForWhatsApp]");
                        var useEmail = document.querySelector(
                            "input[name=UseApplicationEmailForNotifications]");
                        var number = document.getElementById("oo_WhatsAppNumber");
                        var consent = document.getElementById("oo_WhatsAppConsentGranted");
                        var emailField = document.getElementById("oo_LoadNotificationEmail");
                        if (number) {
                            number.required = whatsapp && !(usePhone && usePhone.checked);
                        }
                        if (consent) { consent.required = whatsapp; }
                        if (emailField) {
                            emailField.required = email && !(useEmail && useEmail.checked);
                        }
                    }
                    ooSyncVehicle(document.getElementById("oo_VehicleType").value);
                    var own = document.getElementById("oo_TrailerOwnership");
                    if (own && own.value) { ooSyncTrailer(own.value); }
                    ooSyncNotification(document.getElementById("oo_LoadNotificationChannel").value);
                ]]></script>
            </body>
        </html>
    </template>

    <template id="apply_thanks" name="Owner-Operator Application Received">
        <html t-att-data-website-id="request.website.id"
              t-att-data-main-object="repr(job) if job else None">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Application received — PremaFirm Logistics</title>
                <t t-call-assets="web.assets_frontend"/>
            </head>
            <body class="o_oo_apply">
                <main class="o_oo_apply_shell o_oo_apply_thanks">
                    <h1>Thank you</h1>
                    <p>Your owner-operator application has been received. A
                       confirmation is on its way to your email address.</p>
                    <p>Our onboarding team will contact you with the next step.</p>
                    <p class="o_oo_apply_sub">PremaFirm Logistics</p>
                </main>
            </body>
        </html>
    </template>
</odoo>
