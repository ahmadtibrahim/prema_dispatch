<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═════════════════════════════════════════════════════════════════════
         FORM VIEW
         ════════════════════════════════════════════════════════════════════ -->
    <record id="dispatch_location_form" model="ir.ui.view">
        <field name="name">prema.dispatch.location.form</field>
        <field name="model">prema.dispatch.location</field>
        <field name="arch" type="xml">
            <form string="Saved Location">
                <header>
                    <!-- Google Verified badge -->
                    <span class="badge bg-success" invisible="not google_verified">
                        ✓ Google Verified
                    </span>
                    <span class="badge bg-warning text-dark" invisible="google_verified">
                        ⚠ Not Verified
                    </span>
                    <!-- Possible duplicate warning -->
                    <div class="alert alert-warning mb-0 ms-2 d-inline-flex align-items-center"
                         role="alert" invisible="duplicate_status != 'possible'">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Possible duplicate found.
                        <button type="object" name="action_find_possible_matches"
                                class="btn btn-sm btn-outline-warning ms-2"
                                invisible="not duplicate_of_id">
                            View Matches
                        </button>
                        <button type="object" name="action_merge_duplicate"
                                class="btn btn-sm btn-outline-danger ms-1"
                                invisible="not duplicate_of_id"
                                groups="prema_dispatch.group_dispatch_manager">
                            Merge
                        </button>
                    </div>
                    <!-- Scan &amp; merge actions (manager) -->
                    <button type="object" name="action_scan_duplicates"
                            class="btn btn-secondary ms-auto"
                            groups="prema_dispatch.group_dispatch_manager"
                            string="Scan Duplicates" colspan="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" widget="google_places"
                                   placeholder="Search location name with Google Places (e.g. Foodland Picton)…"/></h1>
                        <field name="business_name" widget="google_places"
                               placeholder="Search company name with Google Places (e.g. Foodland Picton)…"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not address_validation_warning">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <field name="address_validation_warning" nolabel="1" readonly="1" class="d-inline"/>
                        <span invisible="not address_formatted">
                            — Google suggests: <field name="address_formatted" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                        </span>
                    </div>
                    <group>
                        <group string="Address">
                            <field name="chain_name" placeholder="e.g. Sobeys"/>
                            <field name="business_name" placeholder="e.g. Healthy Planet"/>
                            <field name="branch_name" placeholder="e.g. Belleville"/>
                            <field name="location_number" placeholder="e.g. 678"/>
                            <field name="address" widget="google_places" placeholder="Search address…"/>
                            <field name="street"/>
                            <field name="unit"/>
                            <field name="city"/>
                            <field name="province_code"/>
                            <field name="postal_code"/>
                            <field name="country_id" invisible="1"/>
                            <field name="partner_id" string="Customer / Warehouse"/>
                            <field name="location_type"/>
                            <field name="operational_classification"/>
                            <field name="manual_service_time_minutes"/>
                            <field name="effective_service_time_minutes" readonly="1"/>
                            <field name="stop_type"/>
                            <field name="usage_type" widget="badge" decoration-success="usage_type == 'both'" decoration-info="usage_type == 'pickup'" decoration-warning="usage_type == 'delivery'" decoration-muted="usage_type == 'unknown'"/>
                            <field name="portal_reusable" widget="boolean_toggle"
                                   help="When enabled, this location appears in portal Saved Location autocomplete for all authenticated customers. Use for shared facilities (chain stores, public warehouses, cross-docks)."/>
                            <field name="allow_cross_dock" widget="boolean_toggle"/>
                            <field name="dock_door" placeholder="e.g. Door 7, Bay 3"/>
                            <field name="google_place_id" invisible="1"/>
                            <field name="google_verified" invisible="1"/>
                            <field name="duplicate_status" invisible="1"/>
                            <field name="duplicate_of_id" invisible="1"/>
                        </group>
                        <group string="Parking Pin">
                            <field name="pin_lat" string="Pin Latitude"/>
                            <field name="pin_lng" string="Pin Longitude"/>
                            <field name="pin_set" string="Pin Manually Set" readonly="1"/>
                            <field name="geofence_radius"/>
                        </group>
                    </group>
                    <group>
                        <group string="Entrances &amp; Access">
                            <field name="receiving_entrance"/>
                            <field name="truck_entrance"/>
                            <field name="gate_code"/>
                        </group>
                        <group string="Equipment / Access Requirements">
                            <field name="liftgate_required" widget="boolean_toggle"/>
                            <field name="dock_height_available" widget="boolean_toggle"/>
                            <field name="pump_truck_required" widget="boolean_toggle"/>
                            <field name="straight_truck_accessible" widget="boolean_toggle"/>
                            <field name="trailer_53ft_accessible" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Parking / Entrance Notes">
                        <field name="parking_notes" placeholder="Entrance side, gate code, dock instructions…"
                               nolabel="1" colspan="2"/>
                    </group>
                    <group string="Driver Instructions">
                        <field name="driver_instructions" nolabel="1" colspan="2"
                               placeholder="Receiving entrance, parking, gate procedure, call-before-arrival, dock info, special access, delivery/pickup notes…"/>
                    </group>
                    <group string="Security Notes">
                        <field name="security_notes" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Photos">
                        <group string="Entrance Photo">
                            <field name="entrance_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Dock Photo">
                            <field name="dock_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Parking Photo">
                            <field name="parking_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Gate Photo">
                            <field name="gate_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Receiving Office Photo">
                            <field name="receiving_office_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Scale Photo">
                            <field name="scale_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                        <group string="Loading Area Photo">
                            <field name="loading_area_photo" widget="image"
                                   string="Photo" nolabel="1"
                                   options="{'size': [400, 300]}"/>
                        </group>
                    </group>
                    <group string="Stats" groups="prema_dispatch.group_dispatch_manager">
                        <field name="use_count" readonly="1"/>
                        <field name="last_visited" readonly="1"/>
                        <field name="stop_count" readonly="1"/>
                    </group>
                    <group string="Performance" groups="prema_dispatch.group_dispatch_manager">
                        <group string="Timing">
                            <field name="average_wait_minutes" readonly="1"/>
                            <field name="average_unload_minutes" readonly="1"/>
                            <field name="average_total_stop_minutes" readonly="1"/>
                            <field name="fastest_stop_minutes" readonly="1"/>
                            <field name="longest_stop_minutes" readonly="1"/>
                        </group>
                        <group string="Historical (Phase 6 — from visit samples)">
                            <field name="median_dwell_minutes" readonly="1"/>
                            <field name="avg_last10_dwell_minutes" readonly="1"/>
                            <field name="avg_loading_minutes" readonly="1"/>
                            <field name="avg_unloading_minutes" readonly="1"/>
                            <field name="visit_sample_ids" readonly="1" nolabel="1"
                                   view_id="location_visit_sample_tree"/>
                        </group>
                        <group string="Reliability">
                            <field name="average_delay_minutes" readonly="1"/>
                            <field name="appointment_compliance_pct" readonly="1"/>
                            <field name="arrival_accuracy_pct" readonly="1"/>
                        </group>
                        <group string="AI / Heuristic Scores">
                            <field name="recommended_service_time_minutes" readonly="1"/>
                            <field name="best_arrival_window_start" readonly="1"/>
                            <field name="best_arrival_window_end" readonly="1"/>
                            <field name="avoid_arrival_window_start" readonly="1"/>
                            <field name="avoid_arrival_window_end" readonly="1"/>
                            <field name="difficulty_score" readonly="1"/>
                            <field name="dock_efficiency_score" readonly="1"/>
                            <field name="traffic_impact_score" readonly="1"/>
                            <field name="ai_confidence_score" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════
         TREE VIEW
         ════════════════════════════════════════════════════════════════════ -->
    <record id="dispatch_location_list" model="ir.ui.view">
        <field name="name">prema.dispatch.location.list</field>
        <field name="model">prema.dispatch.location</field>
        <field name="arch" type="xml">
            <list string="Saved Locations"
                  decoration-warning="duplicate_status == 'possible'"
                  decoration-muted="not pin_set">
                <field name="location_display_label" string="Display Name"/>
                <field name="chain_name" string="Chain / Brand"/>
                <field name="business_name" string="Business"/>
                <field name="location_number" string="Store #"/>
                <field name="branch_name" string="Branch"/>
                <field name="unit" string="Unit"/>
                <field name="address"/>
                <field name="partner_id" string="Customer"/>
                <field name="location_type" string="Type"/>
                <field name="operational_classification" string="Ops Class" optional="show"/>
                <field name="effective_service_time_minutes" string="Service (min)" optional="show"/>
                <field name="stop_type" string="Stop Type"/>
                <field name="usage_type" string="Historical Usage" decoration-success="usage_type == 'both'" decoration-info="usage_type == 'pickup'" decoration-warning="usage_type == 'delivery'" decoration-muted="usage_type == 'unknown'"/>
                <field name="allow_cross_dock" string="Cross-Dock"/>
                <field name="portal_reusable" string="Portal Reusable"/>
                <field name="dock_door" string="Door"/>
                <field name="google_verified" string="Google Verified"/>
                <field name="duplicate_status" string="Possible Duplicate"/>
                <field name="use_count" string="Visits"/>
                <field name="last_visited" string="Last Visit"/>
            </list>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ════════════════════════════════════════════════════════════════════ -->
    <record id="dispatch_location_search" model="ir.ui.view">
        <field name="name">prema.dispatch.location.search</field>
        <field name="model">prema.dispatch.location</field>
        <field name="arch" type="xml">
            <search>
                <!-- First field = what the search box applies on Enter / icon
                     click. location_display_label carries the normalized
                     search-everywhere search method (_search_location_anywhere)
                     and exists in every client's cached field payload (it is
                     also the list's Display Name column), so stale browser
                     sessions can never hit an unknown field here. The specific
                     fields below remain for the autocomplete dropdown and
                     one-field searches. -->
                <field name="location_display_label" string="All Fields"/>
                <field name="name"/>
                <field name="chain_name"/>
                <field name="business_name"/>
                <field name="location_number"/>
                <field name="branch_name"/>
                <field name="address"/>
                <field name="street"/>
                <field name="unit"/>
                <field name="city"/>
                <field name="postal_code"/>
                <field name="partner_id"/>
                <field name="dock_door"/>
                <field name="receiving_entrance"/>
                <field name="truck_entrance"/>
                <field name="gate_code"/>

                <separator/>

                <!-- Verification filters -->
                <filter name="google_verified_filter" string="Google Verified"
                        domain="[('google_verified','=',True)]"/>
                <filter name="needs_verification" string="Needs Verification"
                        domain="[('google_verified','=',False)]"/>

                <!-- Duplicate filters -->
                <filter name="possible_duplicates" string="Possible Duplicates"
                        domain="[('duplicate_status','=','possible')]"/>
                <filter name="clean_locations" string="Clean"
                        domain="[('duplicate_status','=','clean')]"/>

                <separator/>

                <!-- Data-quality filters -->
                <filter name="missing_store_number" string="Missing Store #"
                        domain="[('location_number','=',False)]"/>
                <filter name="missing_brand" string="Missing Brand"
                        domain="[('chain_name','=',False)]"/>
                <filter name="missing_business" string="Missing Business"
                        domain="[('business_name','=',False)]"/>
                <filter name="missing_unit" string="Missing Unit"
                        domain="[('unit','=',False)]"/>

                <separator/>

                <!-- Portal Reusable (UAT-003) -->
                <filter name="portal_reusable_filter" string="Portal Reusable"
                        domain="[('portal_reusable','=',True)]"/>

                <separator/>

                <!-- Stop Type filters (editable, controls booking eligibility) -->
                <filter name="stop_type_pickup" string="Stop: Pickup" domain="[('stop_type','=','pickup')]"/>
                <filter name="stop_type_delivery" string="Stop: Delivery" domain="[('stop_type','=','delivery')]"/>
                <filter name="stop_type_both" string="Stop: Pickup &amp; Delivery" domain="[('stop_type','=','both')]"/>

                <separator/>

                <!-- Historical Usage filters (computed from stop history) -->
                <filter name="usage_pickup" string="History: Pickup" domain="[('usage_type','=','pickup')]"/>
                <filter name="usage_delivery" string="History: Delivery" domain="[('usage_type','=','delivery')]"/>
                <filter name="usage_both" string="History: Both" domain="[('usage_type','=','both')]"/>
                <filter name="usage_unknown" string="History: Unknown" domain="[('usage_type','=','unknown')]"/>

                <separator/>

                <!-- Standard filters -->
                <filter name="pin_set" string="Pin Set" domain="[('pin_set','=',True)]"/>
                <filter name="has_photo" string="Has Photo" domain="[('entrance_photo','!=',False)]"/>
                <filter name="allow_cross_dock" string="Allow Cross-Dock" domain="[('allow_cross_dock','=',True)]"/>

                <separator/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_brand" string="Brand" context="{'group_by':'chain_name'}"/>
                    <filter name="group_business" string="Business" context="{'group_by':'business_name'}"/>
                    <filter name="group_store_number" string="Store #" context="{'group_by':'location_number'}"/>
                    <filter name="group_city" string="City" context="{'group_by':'city'}"/>
                    <filter name="group_postal_code" string="Postal Code" context="{'group_by':'postal_code'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_location_type" string="Location Type" context="{'group_by':'location_type'}"/>
                    <filter name="group_stop_type" string="Stop Type" context="{'group_by':'stop_type'}"/>
                    <filter name="group_usage_type" string="Historical Usage" context="{'group_by':'usage_type'}"/>
                    <filter name="group_duplicate_status" string="Duplicate Status" context="{'group_by':'duplicate_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════
         ACTION
         ════════════════════════════════════════════════════════════════════ -->
    <record id="action_dispatch_locations" model="ir.actions.act_window">
        <field name="name">Saved Locations</field>
        <field name="res_model">prema.dispatch.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No saved locations yet.
            </p>
            <p>
                Saved locations remember the exact parking pin and entrance photo
                for each warehouse or customer site, so drivers always know where to park.
            </p>
        </field>
    </record>

    <!-- Phase 6: read-only raw visit samples (referenced from the form) -->
    <record id="location_visit_sample_tree" model="ir.ui.view">
        <field name="name">prema.dispatch.location.visit.sample.tree</field>
        <field name="model">prema.dispatch.location.visit.sample</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="visited_at"/>
                <field name="stop_type"/>
                <field name="dwell_minutes"/>
                <field name="service_minutes"/>
                <field name="wait_minutes"/>
                <field name="stop_id"/>
            </list>
        </field>
    </record>

</odoo>
