<odoo>
    <record id="view_prema_dispatch_route_visit_list" model="ir.ui.view">
        <field name="name">prema.dispatch.route.visit.list</field>
        <field name="model">prema.dispatch.route.visit</field>
        <field name="arch" type="xml">
            <list string="Route Visits">
                <field name="operating_date"/>
                <field name="sequence"/>
                <field name="saved_location_id"/>
                <field name="visit_type"/>
                <field name="mixed_action_order"/>
                <field name="status"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
            </list>
        </field>
    </record>
</odoo>
