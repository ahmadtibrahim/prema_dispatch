<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dispatch_stage_list" model="ir.ui.view">
        <field name="name">prema.dispatch.stage.list</field>
        <field name="model">prema.dispatch.stage</field>
        <field name="arch" type="xml">
            <list string="Dispatch Stages" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fold"/>
                <field name="is_completed"/>
                <field name="is_cancelled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_stage_form" model="ir.ui.view">
        <field name="name">prema.dispatch.stage.form</field>
        <field name="model">prema.dispatch.stage</field>
        <field name="arch" type="xml">
            <form string="Dispatch Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="is_completed"/>
                            <field name="is_cancelled"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dispatch_stage" model="ir.actions.act_window">
        <field name="name">Dispatch Stages</field>
        <field name="res_model">prema.dispatch.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
