<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Route Adviser wizard -->
    <record id="view_dispatch_route_adviser_form" model="ir.ui.view">
        <field name="name">prema.dispatch.route.adviser.form</field>
        <field name="model">prema.dispatch.route.adviser</field>
        <field name="arch" type="xml">
            <form string="Route Adviser">
                <group string="Current Route">
                    <group>
                        <field name="current_distance_km"/>
                        <field name="current_drive_minutes"/>
                        <field name="current_waiting_minutes"/>
                    </group>
                    <group>
                        <field name="current_finish_eta"/>
                        <field name="current_peak"/>
                        <field name="current_feasible"/>
                    </group>
                </group>
                <group string="Recommended Route">
                    <group>
                        <field name="recommended_distance_km"/>
                        <field name="recommended_drive_minutes"/>
                        <field name="recommended_waiting_minutes"/>
                    </group>
                    <group>
                        <field name="recommended_finish_eta"/>
                        <field name="recommended_peak"/>
                        <field name="feasible"/>
                    </group>
                </group>
                <group string="Recommended Stops" colspan="4">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" string="Recommended Stops">
                            <field name="sequence" widget="handle"/>
                            <field name="stop_name"/>
                            <field name="stop_type"/>
                            <field name="eta"/>
                            <field name="facility_hours"/>
                            <field name="appointment"/>
                            <field name="service_start"/>
                            <field name="service_end"/>
                            <field name="pallet_delta"/>
                            <field name="onboard_after"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </group>
                <group string="Warnings" colspan="4">
                    <field name="warnings_text" nolabel="1"/>
                </group>
                <footer>
                    <button name="apply_recommended" type="object"
                            string="Apply Recommended Route" class="btn-primary"
                            icon="fa-check-square-o" invisible="not feasible"/>
                    <button string="Keep Current Route" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Hours override -->
    <record id="view_dispatch_hours_override_form" model="ir.ui.view">
        <field name="name">prema.dispatch.hours.override.form</field>
        <field name="model">prema.dispatch.hours.override</field>
        <field name="arch" type="xml">
            <form string="Authorize Hours Override">
                <group>
                    <field name="job_id" readonly="1"/>
                    <field name="stop_id"/>
                    <field name="reason" required="1"/>
                    <field name="user_id" readonly="1"/>
                    <field name="authorized_at" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_dispatch_hours_override_list" model="ir.ui.view">
        <field name="name">prema.dispatch.hours.override.list</field>
        <field name="model">prema.dispatch.hours.override</field>
        <field name="arch" type="xml">
            <list string="Hours Overrides">
                <field name="name"/>
                <field name="job_id"/>
                <field name="stop_id"/>
                <field name="user_id"/>
                <field name="authorized_at"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="action_dispatch_hours_override" model="ir.actions.act_window">
        <field name="name">Hours Overrides</field>
        <field name="res_model">prema.dispatch.hours.override</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
