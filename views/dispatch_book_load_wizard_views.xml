<odoo>
    <record id="view_prema_dispatch_book_load_wizard_form" model="ir.ui.view">
        <field name="name">prema.dispatch.book.load.wizard.form</field>
        <field name="model">prema.dispatch.book.load.wizard</field>
        <field name="arch" type="xml">
            <form string="Book Load from Invoice">
                <sheet>
                    <field name="move_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="booking_mode" widget="radio"/>
                            <field name="partner_id"/>
                            <field name="pickup_saved_location_id"/>
                            <field name="delivery_saved_location_id"/>
                            <field name="scheduled_pickup"/>
                        </group>
                        <group string="Freight">
                            <field name="service_type"/>
                            <field name="equipment_type"/>
                            <field name="required_temperature_c" invisible="equipment_type != 'reefer'"/>
                            <field name="submitted_temperature_unit"
                                   invisible="equipment_type != 'reefer'"
                                   string="Temperature Unit"/>
                            <field name="temperature_c_readback" invisible="equipment_type != 'reefer'"/>
                            <field name="temperature_confirmed" invisible="equipment_type != 'reefer'"/>
                            <field name="requires_liftgate"/>
                            <field name="expected_skids"/>
                            <field name="total_weight_lbs"/>
                            <field name="commodity"/>
                        </group>
                    </group>
                    <group string="Timing">
                        <group string="Pickup">
                            <field name="pickup_facility_open_time" widget="float_time"/>
                            <field name="pickup_facility_close_time" widget="float_time"/>
                            <field name="pickup_window_type"/>
                            <field name="pickup_window_start" widget="float_time"
                                   invisible="pickup_window_type in ('flexible', 'facility_hours')"/>
                            <field name="pickup_window_end" widget="float_time"
                                   invisible="pickup_window_type in ('flexible', 'facility_hours', 'earliest_time')"/>
                            <field name="pickup_appointment_required"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_facility_open_time" widget="float_time"/>
                            <field name="delivery_facility_close_time" widget="float_time"/>
                            <field name="delivery_window_type"/>
                            <field name="delivery_window_start" widget="float_time"
                                   invisible="delivery_window_type in ('flexible', 'facility_hours', 'deadline')"/>
                            <field name="delivery_window_end" widget="float_time"
                                   invisible="delivery_window_type in ('flexible', 'facility_hours', 'deadline')"/>
                            <field name="delivery_deadline"
                                   invisible="delivery_window_type != 'deadline'"/>
                            <field name="delivery_appointment_required"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Facility hours are the dock's own open/close; the window is what the
                        document committed to. They are stored separately and both reach the
                        Planner and the driver — an appointment never overwrites the dock's
                        hours. Edit anything above before confirming.
                    </div>
                    <group string="References">
                        <field name="customer_reference"/>
                        <field name="purchase_order"/>
                        <field name="bol_reference"/>
                        <field name="general_notes"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not mapping_summary">
                        <strong>Auto-mapped from the Invoice</strong> (structured
                        columns → stored AI result → line details — review, then edit
                        anything wrong):<br/>
                        <field name="mapping_summary" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="booking_mode != 'scheduled_ltl'">
                        Scheduled LTL uses Corridor pricing, reserves exact departure capacity and assigns Planner jobs to that departure's Truck.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Booking" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
