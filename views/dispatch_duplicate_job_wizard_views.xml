<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_duplicate_job_wizard_form" model="ir.ui.view">
        <field name="name">prema.dispatch.duplicate.job.wizard.form</field>
        <field name="model">prema.dispatch.duplicate.job.wizard</field>
        <field name="arch" type="xml">
            <form string="Dispatch Job Already Exists">
                <div class="alert alert-warning" role="alert">
                    <field name="message"/>
                </div>
                <field name="existing_job_ids" widget="many2many_tags"/>
                <footer>
                    <button name="action_open_existing" type="object"
                            string="Open Existing Job" class="btn-primary"/>
                    <button name="action_create_additional" type="object"
                            string="Create Additional Dispatch Job" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
