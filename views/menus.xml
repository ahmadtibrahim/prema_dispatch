<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Root app menu -->
    <menuitem id="menu_prema_dispatch_root"
              name="Prema Dispatch"
              sequence="50"
              web_icon="prema_dispatch,static/description/icon.png"
              groups="prema_dispatch.group_dispatch_manager,prema_dispatch.group_dispatcher,prema_dispatch.group_dispatch_readonly"/>

    <!--
        V4 MENU REORGANIZATION (2026-08-01):
        Live Map, Booking Board, Dispatch Planner, Driver Worksheets,
        Find Available Truck, and Saved Locations are now children of
        V4 parent menus defined in prema_logistics_booking/views/menus.xml.

        Their original root-level definitions are removed below.
        The V4 logistics menus.xml handles creating them under:
          - Dispatch Operations
          - Network
    -->

    <!-- Reports -->
    <menuitem id="menu_dispatch_reports_parent"
              name="Reports"
              parent="menu_prema_dispatch_root"
              sequence="80"/>

    <menuitem id="menu_dispatch_all_jobs"
              name="All Jobs"
              parent="menu_dispatch_reports_parent"
              action="action_all_jobs_report"
              sequence="10"/>

    <menuitem id="menu_dispatch_completed"
              name="Completed"
              parent="menu_dispatch_reports_parent"
              action="action_dispatch_completed"
              sequence="20"/>

    <menuitem id="menu_dispatch_stops"
              name="Stops"
              parent="menu_dispatch_reports_parent"
              action="action_stop_report_wizard"
              sequence="30"/>

    <menuitem id="menu_dispatch_custody_report"
              name="Custody / Handoff"
              parent="menu_dispatch_reports_parent"
              action="action_custody_report_wizard"
              sequence="32"/>

    <menuitem id="menu_driver_worksheet_history"
              name="Driver Sheets"
              parent="menu_dispatch_reports_parent"
              action="action_driver_worksheet_history"
              sequence="35"/>

    <menuitem id="menu_dispatch_items"
              name="Freight Items"
              parent="menu_dispatch_reports_parent"
              action="action_dispatch_items"
              sequence="40"/>

    <menuitem id="menu_ltl_consolidations"
              name="LTL Consolidations"
              parent="menu_dispatch_reports_parent"
              action="prema_dispatch.action_consolidations"
              sequence="50"
              groups="prema_dispatch.group_dispatch_manager,prema_dispatch.group_dispatcher"/>

    <menuitem id="menu_dispatch_ontime_report"
              name="On-Time %"
              parent="menu_dispatch_reports_parent"
              action="action_ontime_report_wizard"
              sequence="60"/>

    <menuitem id="menu_dispatch_location_dwell_report"
              name="Stop Time by Location"
              parent="menu_dispatch_reports_parent"
              action="action_location_dwell_report_wizard"
              sequence="65"/>

    <menuitem id="menu_dispatch_performance_report"
              name="Driver / Truck Performance"
              parent="menu_dispatch_reports_parent"
              action="action_performance_report_wizard"
              sequence="70"/>

    <menuitem id="menu_dispatch_lane_report"
              name="Lane Profitability"
              parent="menu_dispatch_reports_parent"
              action="action_lane_report_wizard"
              sequence="75"
              groups="prema_dispatch.group_dispatch_manager"/>

    <menuitem id="menu_dispatch_fuel_report"
              name="Fuel Efficiency"
              parent="menu_dispatch_reports_parent"
              action="action_fuel_report_wizard"
              sequence="80"/>

    <menuitem id="menu_dispatch_late_stop_report"
              name="Missed / Late Stops"
              parent="menu_dispatch_reports_parent"
              action="action_late_stop_report_wizard"
              sequence="85"/>

    <menuitem id="menu_dispatch_pod_aging_report"
              name="POD Aging"
              parent="menu_dispatch_reports_parent"
              action="action_pod_aging_report_wizard"
              sequence="90"/>

    <!-- User Manual -->
    <!-- Evidence -->
    <menuitem id="menu_dispatch_evidence"
              name="Evidence"
              parent="menu_prema_dispatch_root"
              action="action_dispatch_evidence"
              sequence="75"
              groups="prema_dispatch.group_dispatch_manager,prema_dispatch.group_dispatcher"/>

    <!-- User Manual -->
    <menuitem id="menu_dispatch_manual"
              name="User Manual"
              parent="menu_prema_dispatch_root"
              action="action_dispatch_manual"
              sequence="95"/>

    <!-- Settings -->
    <menuitem id="menu_dispatch_settings_parent"
              name="Settings"
              parent="menu_prema_dispatch_root"
              sequence="100"
              groups="prema_dispatch.group_dispatch_manager"/>

    <menuitem id="menu_dispatch_stages"
              name="Stages"
              parent="menu_dispatch_settings_parent"
              action="action_dispatch_stage"
              sequence="10"/>

</odoo>
