<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Stops / Driver report generator wizard ──────────────────── -->
    <record id="view_dispatch_stop_report_wizard_form" model="ir.ui.view">
        <field name="name">prema.dispatch.stop.report.wizard.form</field>
        <field name="model">prema.dispatch.stop.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stops / Driver Report">
                <sheet>
                    <group>
                        <group string="Filter by">
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                            <field name="disp_number" placeholder="e.g. DISP/2026/00012"/>
                            <field name="invoice_ref" placeholder="e.g. INV/2026/0042"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <div class="text-center mb-3">
                        <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    </div>
                    <field name="summary_html" nolabel="1" invisible="not summary_html"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stop_report_wizard" model="ir.actions.act_window">
        <field name="name">Stops / Driver Report</field>
        <field name="res_model">prema.dispatch.stop.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

