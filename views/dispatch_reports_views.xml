    <!-- ── Driver Worksheets ────────────────────────────────────────── -->
    <record id="view_dispatch_driver_worksheet_list" model="ir.ui.view">
        <field name="name">prema.dispatch.driver.worksheet.list</field>
        <field name="model">prema.dispatch.driver.worksheet</field>
        <field name="arch" type="xml">
            <list string="Driver Worksheets">
                <field name="name"/>
                <field name="date"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="stop_count" string="Stops"/>
                <field name="total_drive_minutes" string="Drive (min)"/>
                <field name="total_detention_minutes" string="Detention (min)"/>
                <field name="is_active" string="Active"/>
                <field name="generated_at" string="Generated"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_driver_worksheet_form" model="ir.ui.view">
        <field name="name">prema.dispatch.driver.worksheet.form</field>
        <field name="model">prema.dispatch.driver.worksheet</field>
        <field name="arch" type="xml">
            <form string="Driver Worksheet">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="stop_count" readonly="1"/>
                            <field name="total_drive_minutes" readonly="1"/>
                            <field name="total_detention_minutes" readonly="1"/>
                            <field name="is_active" readonly="1"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Worksheet">
                            <field name="worksheet_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Stops">
                            <field name="stop_ids" readonly="1">
                                <list string="Worksheet Stops">
                                    <field name="sequence"/>
                                    <field name="saved_location_id" string="Company"/>
                                    <field name="stop_type"/>
                                    <field name="scheduled_time"/>
                                    <field name="address"/>
                                    <field name="pallets_in"/>
                                    <field name="pallets_out"/>
                                    <field name="onboard_load_after_stop" string="Onboard"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Jobs">
                            <field name="job_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Live list: today's active sheets only -->
    <record id="action_driver_worksheet_live" model="ir.actions.act_window">
        <field name="name">Driver Worksheets</field>
        <field name="res_model">prema.dispatch.driver.worksheet</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_active', '=', True)]</field>
        <field name="help" type="html">
            <p>No active worksheets generated yet — use the "Sheet" button on the Dispatch Planner.</p>
        </field>
    </record>

    <!-- Historical: all sheets, filterable by driver/date -->
    <record id="action_driver_worksheet_history" model="ir.actions.act_window">
        <field name="name">Driver Sheets</field>
        <field name="res_model">prema.dispatch.driver.worksheet</field>
        <field name="view_mode">list,form</field>
    </record>

