<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── Kanban (Dispatch Board) ──────────────────────────────── -->
    <record id="view_dispatch_job_kanban" model="ir.ui.view">
        <field name="name">prema.dispatch.job.kanban</field>
        <field name="model">prema.dispatch.job</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    group_create="false"
                    quick_create="false"
                    on_drag="web_save">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="stop_count"/>
                <field name="total_skids"/>
                <field name="pod_complete"/>
                <field name="color"/>
                <field name="scheduled_pickup"/>
                <field name="source_document_name"/>
                <field name="pickup_city"/>
                <field name="delivery_cities"/>
                <field name="service_type"/>
                <field name="requires_reefer"/>
                <field name="current_stop_id"/>
                <field name="next_stop_id"/>
                <field name="sent_to_driver_at"/>
                <progressbar field="stage_id" colors='{"normal":"success","urgent":"warning","emergency":"danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.value} o_kanban_record_top mb8">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="o_kanban_record_subtitle text-muted ms-1 small">
                                    <field name="source_document_name"/>
                                </span>
                            </div>
                            <div class="float-end d-flex gap-1">
                                <span t-if="record.requires_reefer.value"
                                      class="badge bg-primary" title="Reefer">❄️</span>
                                <span t-if="record.sent_to_driver_at.value"
                                      class="badge bg-success" title="Sent to driver">SENT</span>
                                <span t-if="record.priority.value == 'emergency'"
                                      class="badge bg-danger">EMERG</span>
                                <span t-elif="record.priority.value == 'urgent'"
                                      class="badge bg-warning">URGENT</span>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div t-if="record.partner_id.value" class="mb4">
                                <i class="fa fa-building-o me-1 text-muted" title="Customer"/>
                                <field name="partner_id"/>
                            </div>
                            <!-- Route -->
                            <div t-if="record.pickup_city.value or record.delivery_cities.value"
                                 class="mb4 small text-muted">
                                <i class="fa fa-map-marker me-1" title="Route"/>
                                <t t-esc="record.pickup_city.value"/>
                                <t t-if="record.pickup_city.value and record.delivery_cities.value"> → </t>
                                <t t-esc="record.delivery_cities.value"/>
                            </div>
                            <!-- Truck / driver -->
                            <div t-if="record.vehicle_id.value" class="mb4">
                                <i class="fa fa-truck me-1 text-muted" title="Truck"/>
                                <field name="vehicle_id"/>
                                <span t-if="record.driver_id.value" class="text-muted ms-1">
                                    / <field name="driver_id"/>
                                </span>
                            </div>
                            <div t-else="" class="text-warning mb4">
                                <i class="fa fa-exclamation-triangle me-1"/>Unassigned
                            </div>
                            <!-- Pickup time -->
                            <div t-if="record.scheduled_pickup.value" class="mb4 text-muted small">
                                <i class="fa fa-clock-o me-1" title="Scheduled pickup"/>
                                <field name="scheduled_pickup" widget="datetime"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left small text-muted">
                                <t t-if="record.service_type.value">
                                    <span t-attf-class="badge me-1 #{record.service_type.value == 'ftl' ? 'bg-success' : 'bg-info'}">
                                        <t t-esc="record.service_type.value.toUpperCase()"/>
                                    </span>
                                </t>
                                <t t-esc="record.total_skids.value"/> skids
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <span t-if="record.pod_complete.value" class="badge bg-success">POD ✓</span>
                                <span t-elif="record.stop_count.value > 0" class="badge bg-light text-dark">POD pending</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── List ──────────────────────────────────────────────────── -->
    <record id="view_dispatch_job_list" model="ir.ui.view">
        <field name="name">prema.dispatch.job.list</field>
        <field name="model">prema.dispatch.job</field>
        <field name="arch" type="xml">
            <list string="Dispatch Jobs" decoration-danger="priority == 'emergency'"
                  decoration-warning="priority == 'urgent'">
                <field name="name"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id" string="Truck"/>
                <field name="driver_id" string="Driver"/>
                <field name="scheduled_pickup"/>
                <field name="stop_count" string="Stops"/>
                <field name="total_skids" string="Skids" optional="show"/>
                <field name="pod_complete" optional="show"/>
                <field name="completed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────── -->
    <record id="view_dispatch_job_form" model="ir.ui.view">
        <field name="name">prema.dispatch.job.form</field>
        <field name="model">prema.dispatch.job</field>
        <field name="arch" type="xml">
            <form string="Dispatch Job">
                <header>
                    <button name="action_send_to_driver"
                            string="Send to Driver"
                            type="object"
                            class="btn-primary"
                            invisible="not vehicle_id or sent_to_driver_at or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_mark_completed"
                            string="Mark Completed"
                            type="object"
                            class="btn-success"
                            confirm="Mark this job as completed and attach all documents to the invoice?"
                            invisible="not all_stops_completed"/>
                    <button name="action_reopen_job"
                            string="Reopen Job"
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            groups="prema_dispatch.group_dispatch_manager"
                            confirm="Restart this job? It will go back to an in-progress stage so the driver/dispatcher can work it again."
                            invisible="not stage_id.is_completed"/>
                    <button name="action_delete_unused_job"
                            string="Delete Unused Job"
                            type="object"
                            class="btn-danger"
                            icon="fa-trash"
                            groups="prema_dispatch.group_dispatch_manager"
                            confirm="Permanently delete this archived job? Only allowed when it has no operational history, no POD, no pallet evidence and no accounting records."
                            invisible="active"/>
                    <button name="action_attach_documents_to_invoice"
                            string="Attach Docs to Invoice"
                            type="object"
                            class="btn-secondary"
                            invisible="not invoice_id"/>
                    <button name="action_refresh_geotab_location"
                            string="Refresh GPS"
                            type="object"
                            class="btn-secondary"
                            icon="fa-map-marker"
                            invisible="not vehicle_id"/>
                    <button name="action_estimate_route"
                            string="Estimate Route"
                            type="object"
                            class="btn-secondary"
                            icon="fa-clock-o"
                            title="Compute drive times and ETAs for all stops via Google Maps"
                            invisible="not stop_ids or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_check_feasibility"
                            string="Feasibility Check"
                            type="object"
                            class="btn-secondary"
                            icon="fa-search"
                            title="Check which trucks can meet pickup/delivery time windows"
                            invisible="stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_rank_trucks"
                            string="Rank Trucks"
                            type="object"
                            class="btn-secondary"
                            icon="fa-sort-amount-asc"
                            invisible="not stop_ids or vehicle_id or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_optimize_route"
                            string="Optimize Route"
                            type="object"
                            class="btn-secondary"
                            icon="fa-random"
                            title="Re-order pending stops to minimize drive time"
                            invisible="not stop_ids or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_route_adviser"
                            string="Route Adviser"
                            type="object"
                            class="btn-secondary"
                            icon="fa-compass"
                            title="Time-aware milk-run review: current vs recommended route, hard-window protection, capacity peak"
                            invisible="not stop_ids or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="apply_recommended_route"
                            string="Apply Recommended"
                            type="object"
                            class="btn-secondary"
                            icon="fa-check-square-o"
                            title="Apply the recommended route order (pending stops only)"
                            invisible="not stop_ids or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_get_best_options"
                            string="Best Options"
                            type="object"
                            class="btn-secondary"
                            icon="fa-lightbulb-o"
                            title="Find cheapest day, consolidation opportunities, and best truck"
                            invisible="stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_find_best_truck"
                            string="Find Best Truck"
                            type="object"
                            class="btn-primary"
                            icon="fa-truck"
                            invisible="not stop_ids or stage_id.is_completed or stage_id.is_cancelled"/>
                    <button name="action_open_invoice"
                            string="Open Invoice"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-text-o"
                            invisible="not invoice_id"/>
                    <field name="stage_id" widget="statusbar"
                           statusbar_visible="draft,assigned,sent_to_driver,picked_up,in_transit,delivered,completed"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div name="button_box" class="oe_button_box">
                        <button type="object" class="oe_stat_button"
                                name="action_open_invoice" icon="fa-file-invoice"
                                invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button type="object" class="oe_stat_button"
                                name="action_open_stops" icon="fa-map-marker">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="stop_count"/></span>
                                <span class="o_stat_text">Stops</span>
                            </div>
                        </button>
                        <button type="object" class="oe_stat_button"
                                name="action_open_evidence"
                                icon="fa-camera" string="Evidence">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="evidence_count"/></span>
                                <span class="o_stat_text">Evidence</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="URGENT" bg_color="bg-warning"
                            invisible="priority != 'urgent'"/>
                    <widget name="web_ribbon" title="EMERGENCY" bg_color="bg-danger"
                            invisible="priority != 'emergency'"/>
                    <widget name="web_ribbon" title="⚠ RISKY" bg_color="bg-warning"
                            invisible="risk_level != 'yellow' or priority in ('urgent','emergency')"/>
                    <widget name="web_ribbon" title="🚫 NOT FEASIBLE" bg_color="bg-danger"
                            invisible="risk_level != 'red' or priority == 'emergency'"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Source &amp; Customer">
                            <field name="source_document_name" readonly="1"
                                   invisible="not source_document_name"
                                   string="Source Document"/>
                            <field name="invoice_id" readonly="invoice_id"/>
                            <field name="sale_order_id" readonly="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="dispatcher_id"/>
                        </group>
                        <group string="Service">
                            <field name="service_type"
                                   help="FTL = dedicated truck. LTL = combined with other customers. Rush = higher cost, fastest. Economy = flexible lower-cost consolidation. Backhaul = return-route freight."/>
                            <field name="equipment_type"
                                   help="Choosing Reefer here sets Reefer Required automatically — see the temperature fields below."/>
                            <!-- requires_reefer is derived from equipment_type (onchange
                                 above) instead of shown as its own toggle here: the two
                                 controls used to both mean "this load needs a reefer" and
                                 could be set inconsistently. Kept invisible so the
                                 temp_requirement invisible="not requires_reefer" condition
                                 below and the header ribbon still work. -->
                            <field name="requires_reefer" invisible="1"/>
                            <field name="requires_liftgate" widget="boolean_toggle"
                                   help="Liftgate needed when location has no loading dock."/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>

                    <group>
                        <group string="Booking Details">
                            <field name="requested_delivery_date"
                                   help="Date the customer requested — pulled from the source invoice/order. Used for planning priority."/>
                            <field name="booking_confirmed_at" readonly="1"
                                   invisible="not booking_confirmed_at"/>
                            <field name="tracking_number" readonly="1"
                                   invisible="not tracking_number"/>
                        </group>
                        <group string="Shipment Specs">
                            <field name="approximate_skids"
                                   help="Estimated skid count at booking time. Exact count is computed from freight items."/>
                            <field name="commodity"
                                   help="Description of the freight being shipped."/>
                            <field name="temp_requirement"
                                   string="Temp. Requirement (°C)"
                                   invisible="not requires_reefer"
                                   placeholder="e.g. -18 or 2 to 8"
                                   help="Temperature range in Celsius. e.g. -18 or 2 to 8. Bare numbers are auto-suffixed with °C."/>
                            <field name="bol_number"/>
                            <field name="po_number"/>
                            <field name="ref" placeholder="Internal reference / notes ref"/>
                        </group>
                    </group>

                    <!-- Schedule & Windows — pickup and delivery date/window fields
                         live together here instead of split across a "Schedule"
                         group and separate "Pickup/Delivery Window" groups. -->
                    <group string="Schedule &amp; Windows">
                        <group string="Pickup">
                            <field name="scheduled_pickup" string="Pickup Date" widget="date"/>
                            <field name="pickup_window_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="pickup_earliest"
                                   invisible="pickup_window_type not in ('window',)"/>
                            <field name="pickup_latest"
                                   invisible="pickup_window_type not in ('window',)"/>
                            <field name="pickup_exact_time"
                                   invisible="pickup_window_type != 'exact'"/>
                            <field name="appointment_required" widget="boolean_toggle"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_window_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="delivery_earliest"
                                   invisible="delivery_window_type not in ('window',)"/>
                            <field name="delivery_latest"
                                   invisible="delivery_window_type not in ('window',)"/>
                            <field name="delivery_deadline"
                                   invisible="delivery_window_type not in ('deadline',)"/>
                            <field name="delivery_exact_time"
                                   invisible="delivery_window_type != 'exact'"/>
                            <field name="hard_deadline" widget="boolean_toggle"
                                   invisible="delivery_window_type == 'flexible'"/>
                        </group>
                        <group string="Operational Start">
                            <div class="alert alert-info" role="alert">
                                Backward-calculated practical start from the
                                earliest hard constraint — the corridor's
                                scheduled start is a separate recurring time.
                            </div>
                            <field name="recommended_operational_start" readonly="1"
                                   widget="datetime"
                                   help="Calculated from the first hard window /
                                        appointment, minus drive time and a
                                        small buffer. Uses the truck's live GPS
                                        when fresh."/>
                            <field name="planned_operational_start" widget="datetime"
                                   placeholder="Override the recommended start…"/>
                        </group>
                    </group>

                    <group string="Route (computed from stops)">
                        <field name="pickup_city" readonly="1"/>
                        <field name="delivery_cities" readonly="1"/>
                    </group>

                    <!-- Compatibility warnings banner -->
                    <div class="alert alert-warning mb-3"
                         role="alert"
                         invisible="not assignment_warnings">
                        <strong>Capacity Warning:</strong>
                        <field name="assignment_warnings" readonly="1" nolabel="1" widget="text"/>
                    </div>

                    <!-- Night departure warning -->
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="not is_night_departure">
                        <i class="fa fa-moon-o me-2"/>
                        <strong>Night Departure</strong> — Pickup is scheduled before 5:00 AM or after 10:00 PM.
                        Confirm driver availability and rest hours before dispatching.
                    </div>

                    <!-- Overnight hold warning -->
                    <div class="alert alert-info mb-2"
                         role="alert"
                         invisible="not overnight_hold">
                        <i class="fa fa-bed me-2"/>
                        <strong>Overnight Hold</strong> — Pickup and final delivery are on different calendar dates.
                        Confirm where freight will be stored overnight.
                    </div>

                    <!-- Missing pallet data warning -->
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="not missing_pallet_warning">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <strong>No Pallet Data</strong> — Pallet count is missing from this job and all stops.
                        Capacity cannot be validated. Confirm load before dispatching.
                    </div>

                    <!-- Latest safe dispatch time -->
                    <div class="alert alert-danger mb-2"
                         role="alert"
                         invisible="not latest_safe_dispatch_time">
                        <i class="fa fa-clock-o me-2"/>
                        <strong>Latest Safe Dispatch: </strong>
                        <field name="latest_safe_dispatch_time" readonly="1" nolabel="1" widget="datetime"/>
                        — Must dispatch by this time to meet the delivery deadline.
                    </div>

                    <group>
                        <group string="Truck &amp; Driver">
                            <field name="vehicle_id"
                                   readonly="assignment_locked"/>
                            <field name="driver_id"
                                   domain="[('x_is_driver', '=', True)]"
                                   readonly="assignment_locked"/>
                            <field name="assignment_locked"/>
                            <field name="sent_to_driver_at" readonly="1"
                                   invisible="not sent_to_driver_at"/>
                            <button name="action_manage_chat_members" type="object"
                                    string="Manage Driver Chat" class="btn-link px-0"
                                    invisible="not driver_id"
                                    help="Invite or remove extra people from this driver's chat channel."/>
                        </group>
                        <group string="Live GPS" invisible="not vehicle_id">
                            <field name="vehicle_last_address" readonly="1"
                                   string="Last Location" invisible="not vehicle_last_address"/>
                            <field name="vehicle_last_gps_at" readonly="1"
                                   string="GPS Updated" invisible="not vehicle_last_gps_at"/>
                            <field name="vehicle_speed_kmh" readonly="1"
                                   invisible="not vehicle_speed_kmh"/>
                            <field name="vehicle_moving_state" readonly="1"
                                   widget="badge"
                                   decoration-success="vehicle_moving_state == 'moving'"
                                   decoration-muted="vehicle_moving_state == 'stopped'"
                                   invisible="vehicle_moving_state == 'unknown'"/>
                        </group>
                    </group>

                    <!-- Override section — manager only, shown when override data exists -->
                    <group groups="prema_dispatch.group_dispatch_manager">
                        <group string="Assignment Override">
                            <field name="assignment_override_reason" widget="text"
                                   placeholder="Required to override a truck compatibility block…"/>
                            <field name="assignment_override_by" readonly="1"
                                   invisible="not assignment_override_by"/>
                            <field name="assignment_override_at" readonly="1"
                                   invisible="not assignment_override_at"/>
                        </group>
                        <group/>
                    </group>

                    <group>
                        <group string="Load &amp; Risk Summary">
                            <field name="total_skids" readonly="1"/>
                            <field name="total_weight_lbs" readonly="1"/>
                            <field name="approximate_skids"
                                   help="Booking estimate. Capacity validation uses Max Onboard when stop data is available."/>
                            <field name="max_onboard_pallets" readonly="1"
                                   help="Peak pallets on truck at any point in the route. Used for truck capacity validation."/>
                            <field name="risk_level" readonly="1" widget="badge"
                                   decoration-success="risk_level == 'green'"
                                   decoration-warning="risk_level == 'yellow'"
                                   decoration-danger="risk_level == 'red'"/>
                            <field name="feasibility_status" widget="badge" readonly="1"
                                   decoration-success="feasibility_status == 'feasible'"
                                   decoration-warning="feasibility_status == 'risky'"
                                   decoration-danger="feasibility_status == 'not_feasible'"
                                   decoration-muted="feasibility_status == 'unknown'"/>
                            <field name="recommended_truck_id" readonly="1"
                                   invisible="not recommended_truck_id"/>
                            <field name="feasibility_notes" widget="text" readonly="1"
                                   invisible="not feasibility_notes"
                                   style="font-size:11px; white-space:pre;"/>
                            <field name="all_stops_completed" readonly="1"/>
                            <field name="pod_complete" readonly="1"/>
                            <field name="corridor_tag" readonly="1"
                                   invisible="not corridor_tag"
                                   string="Route Corridor"
                                   help="Computed direction for corridor-based LTL consolidation matching."/>
                        </group>
                        <group string="Route Estimates" invisible="not estimated_duration_minutes and not estimated_distance_km">
                            <field name="estimated_duration_minutes" readonly="1"
                                   string="Est. Duration (min)"/>
                            <field name="estimated_distance_km" readonly="1"
                                   string="Est. Distance (km)"/>
                            <field name="estimated_cost"
                                   string="Est. Cost ($)"/>
                            <field name="route_estimated_at" readonly="1"
                                   string="Last Estimated"
                                   invisible="not route_estimated_at"/>
                        </group>
                        <group string="Completion" invisible="not completed_at">
                            <field name="completed_at" readonly="1"/>
                            <field name="auto_posted_invoice" readonly="1"/>
                            <field name="auto_post_error" readonly="1"
                                   invisible="not auto_post_error"
                                   widget="text"/>
                        </group>
                        <group string="Live Execution">
                            <field name="start_position_override"
                                   string="Start Position"
                                   help="Where the actual route starts. Auto: prior-day end → depot → hub. GPS: enter coordinates manually."/>
                            <field name="start_position_override_lat"
                                   invisible="start_position_override != 'gps'"
                                   string="Start Lat"/>
                            <field name="start_position_override_lng"
                                   invisible="start_position_override != 'gps'"
                                   string="Start Lng"/>
                            <field name="ignore_route_recommendation"
                                   help="Early next-day pickups are recommendations only — never forced travel. Check to dismiss the recommendation."/>
                            <field name="route_recommendation_log" readonly="1"
                                   widget="jsonb" string="Route Recommendation Log"
                                   invisible="not route_recommendation_log"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids" widget="one2many" mode="list">
                                <list string="Stops" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stop_type"/>
                                    <field name="status" widget="badge"
                                           decoration-info="status == 'en_route'"
                                           decoration-warning="status == 'arrived'"
                                           decoration-success="status == 'completed'"
                                           decoration-danger="status in ('issue','cancelled')"
                                           decoration-muted="status == 'cancelled'"/>
                                    <field name="address"/>
                                    <field name="saved_location_id" optional="show" string="Company"
                                           placeholder="Pick a saved location to auto-fill the address..."/>
                                    <field name="transfer_to_vehicle_id" optional="hide" string="Transfer Truck"/>
                                    <field name="transfer_to_driver_id" optional="hide" string="Transfer Driver"/>
                                    <field name="cross_dock_origin_stop_id" optional="hide" string="Origin Pickup"/>
                                    <field name="freight_item_summary" optional="show" string="Freight"/>
                                    <field name="allow_cross_dock" optional="hide" string="Cross-Dock"/>
                                    <field name="service_time_minutes" optional="hide" string="Svc (min)"/>
                                    <field name="drive_time_from_prev_minutes" readonly="1"
                                           optional="show" string="Drive (min)"/>
                                    <field name="estimated_arrival" readonly="1"
                                           optional="show" string="Est. Arrival"/>
                                    <field name="estimated_departure" readonly="1"
                                           optional="hide" string="Est. Depart"/>
                                    <field name="scheduled_time" optional="show"/>
                                    <field name="eta_override" optional="show"
                                           string="ETA Override"
                                           help="Dispatcher override — wins over live ETA propagation for this stop."/>
                                    <field name="eta_live" readonly="1"
                                           optional="show" string="Live ETA"/>
                                    <field name="eta_delay_minutes" readonly="1"
                                           optional="hide" string="Delay (min)"/>
                                    <field name="eta_source" readonly="1"
                                           optional="hide" string="ETA Source"/>
                                    <field name="actual_arrival_time" optional="hide"/>
                                    <field name="pallets_in" optional="show"
                                           string="In"
                                           help="Pallets loaded at this pickup stop."/>
                                    <field name="pallets_out" optional="show"
                                           string="Out"
                                           help="Pallets unloaded at this drop-off stop."/>
                                    <field name="onboard_load_after_stop" readonly="1"
                                           optional="show" string="Onboard"
                                           help="Running pallet count on truck after this stop."/>
                                    <field name="time_window_type" optional="hide" string="Window"/>
                                    <field name="deadline_time" optional="hide" string="Deadline"/>
                                    <field name="hard_deadline" optional="hide" string="Hard"/>
                                    <field name="linked_load_group" optional="hide" string="Group"/>
                                    <field name="pod_required"/>
                                    <field name="pod_uploaded" readonly="1" optional="show"/>
                                    <button name="action_mark_completed"
                                            string="Complete"
                                            type="object"
                                            icon="fa-check"
                                            invisible="status in ('completed','skipped','cancelled')"/>
                                    <button name="action_cancel_stop"
                                            string="Cancel"
                                            type="object"
                                            icon="fa-times"
                                            confirm="Cancel this stop? This cannot be undone."
                                            invisible="status in ('completed','cancelled')"
                                            groups="prema_dispatch.group_dispatch_manager"/>
                                </list>
                            </field>
                        </page>

                        <page string="Freight Items" name="items">
                            <field name="item_ids" widget="one2many">
                                <list string="Items" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_ref" optional="show"/>
                                    <field name="pallet_count"/>
                                    <field name="weight_lbs" optional="show"/>
                                    <field name="pickup_stop_id" optional="show"/>
                                    <field name="delivery_stop_id" optional="show"/>
                                    <field name="current_vehicle_id" optional="hide"/>
                                    <field name="current_location_id" optional="show"/>
                                    <field name="current_custody_type" optional="show" string="Custody"/>
                                    <field name="status" widget="badge"
                                           decoration-info="status == 'loaded'"
                                           decoration-primary="status == 'in_transit'"
                                           decoration-success="status == 'delivered'"
                                           decoration-warning="status in ('cross_docked','held','transferred')"/>
                                    <field name="requires_transfer" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Current / Next Stop" name="progress"
                              invisible="not stop_ids">
                            <group>
                                <group string="Current Stop">
                                    <field name="current_stop_id" readonly="1"/>
                                </group>
                                <group string="Next Stop">
                                    <field name="next_stop_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <group>
                                <field name="driver_instructions" widget="text" nolabel="1"
                                       placeholder="Driver instructions (visible to driver)…"/>
                            </group>
                            <group>
                                <field name="internal_notes" widget="text" nolabel="1"
                                       placeholder="Internal dispatcher notes…"/>
                            </group>
                        </page>

                        <page string="Assignment History" name="history">
                            <field name="assignment_log_ids" readonly="1">
                                <list create="false" edit="false">
                                    <field name="changed_at"/>
                                    <field name="old_vehicle_id" string="Previous Truck"/>
                                    <field name="new_vehicle_id" string="New Truck"/>
                                    <field name="old_driver_id" string="Previous Driver"/>
                                    <field name="new_driver_id" string="New Driver"/>
                                    <field name="changed_by"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>

                        <page string="Timeline" name="timeline">
                            <group invisible="not tracking_number">
                                <field name="tracking_number" readonly="1"/>
                                <field name="tracking_url" readonly="1" widget="url"
                                       string="Tracking Link"
                                       invisible="not tracking_url"/>
                            </group>
                            <field name="timeline_event_ids" readonly="1">
                                <list create="false" edit="false" delete="false"
                                      decoration-success="event_type in ('delivered','all_stops_done','invoice_completed')"
                                      decoration-warning="event_type == 'exception'"
                                      decoration-info="event_type in ('truck_assigned','dispatch_confirmed')"
                                      decoration-muted="event_type == 'stage_changed'">
                                    <field name="occurred_at" string="When"/>
                                    <field name="event_type" column_invisible="1"/>
                                    <field name="event_type_label" string="Event"/>
                                    <field name="stop_id" string="Stop" optional="show"/>
                                    <field name="notes" string="Detail"/>
                                    <field name="user_id" string="By"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────── -->
    <record id="view_dispatch_job_search" model="ir.ui.view">
        <field name="name">prema.dispatch.job.search</field>
        <field name="model">prema.dispatch.job</field>
        <field name="arch" type="xml">
            <search string="Dispatch Jobs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="invoice_id"/>
                <field name="ref"/>
                <filter name="today" string="Today"
                        domain="[('scheduled_pickup','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),('scheduled_pickup','&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="tomorrow" string="Tomorrow"
                        domain="[('scheduled_pickup','&gt;=', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),('scheduled_pickup','&lt;', (context_today() + datetime.timedelta(days=2)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="unassigned" string="Unassigned"
                        domain="[('vehicle_id','=',False)]"/>
                <filter name="urgent" string="Urgent / Emergency"
                        domain="[('priority','in',['urgent','emergency'])]"/>
                <filter name="pod_missing" string="POD Missing"
                        domain="[('pod_complete','=',False),('all_stops_completed','=',True)]"/>
                <filter name="active_jobs" string="Active"
                        domain="[('stage_id.is_completed','=',False),('stage_id.is_cancelled','=',False)]"/>
                <filter name="completed" string="Completed"
                        domain="[('stage_id.is_completed','=',True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active','=',False)]"/>
                <filter name="active_and_archived" string="Active &amp; Archived"
                        domain="[]" context="{'active_test': False}"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by':'stage_id'}"/>
                    <filter name="group_vehicle" string="Truck" context="{'group_by':'vehicle_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by':'driver_id'}"/>
                    <filter name="group_dispatcher" string="Dispatcher" context="{'group_by':'dispatcher_id'}"/>
                    <filter name="group_service" string="Service Type" context="{'group_by':'service_type'}"/>
                    <filter name="group_date" string="Pickup Date" context="{'group_by':'scheduled_pickup:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ───────────────────────────────────────────────── -->
    <record id="action_dispatch_board" model="ir.actions.act_window">
        <field name="name">Dispatch Board</field>
        <field name="res_model">prema.dispatch.job</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{"search_default_active_jobs": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No dispatch jobs yet.
            </p>
            <p>Create dispatch jobs from invoices using the <b>Dispatch</b> button.</p>
        </field>
    </record>

    <record id="action_dispatch_jobs_list" model="ir.actions.act_window">
        <field name="name">Dispatch Jobs</field>
        <field name="res_model">prema.dispatch.job</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="action_dispatch_unassigned" model="ir.actions.act_window">
        <field name="name">Unassigned Jobs</field>
        <field name="res_model">prema.dispatch.job</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('vehicle_id','=',False),('stage_id.is_cancelled','=',False)]</field>
    </record>

    <record id="action_dispatch_active" model="ir.actions.act_window">
        <field name="name">Active Jobs</field>
        <field name="res_model">prema.dispatch.job</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('stage_id.is_completed','=',False),('stage_id.is_cancelled','=',False)]</field>
    </record>

    <record id="action_dispatch_completed" model="ir.actions.act_window">
        <field name="name">Completed Jobs</field>
        <field name="res_model">prema.dispatch.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('stage_id.is_completed','=',True)]</field>
    </record>
</odoo>
