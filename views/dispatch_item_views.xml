<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dispatch_item_list" model="ir.ui.view">
        <field name="name">prema.dispatch.item.list</field>
        <field name="model">prema.dispatch.item</field>
        <field name="arch" type="xml">
            <list string="Freight Items" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="item_ref"/>
                <field name="pallet_count"/>
                <field name="weight_lbs"/>
                <field name="pickup_stop_id"/>
                <field name="delivery_stop_id"/>
                <field name="current_vehicle_id" string="On Truck"/>
                <field name="current_location_id" optional="show"/>
                <field name="current_custody_type" string="Custody" optional="show"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'loaded'"
                       decoration-primary="status == 'in_transit'"
                       decoration-success="status == 'delivered'"
                       decoration-warning="status in ('held','transferred','cross_docked')"
                       decoration-danger="status == 'cancelled'"/>
                <field name="requires_transfer" optional="hide"/>
                <field name="evidence_attachment_ids" optional="hide" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_item_form" model="ir.ui.view">
        <field name="name">prema.dispatch.item.form</field>
        <field name="model">prema.dispatch.item</field>
        <field name="arch" type="xml">
            <form string="Freight Item">
                <sheet>
                    <!-- Smart buttons -->
                    <div name="button_box" class="oe_button_box">
                        <button type="object" class="oe_stat_button"
                                name="action_open_evidence"
                                icon="fa-camera" string="Pallet Evidence">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="evidence_count"/></span>
                                <span class="o_stat_text">Evidence</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="name"/>
                            <field name="item_ref"/>
                            <field name="description"/>
                            <field name="status"/>
                            <field name="requires_transfer"/>
                        </group>
                        <group string="Dimensions">
                            <field name="pallet_count"/>
                            <field name="weight_lbs"/>
                            <field name="length_in"/>
                            <field name="width_in"/>
                            <field name="height_in"/>
                        </group>
                    </group>
                    <group>
                        <group string="Route">
                            <field name="pickup_stop_id"/>
                            <field name="delivery_stop_id"/>
                        </group>
                        <group string="Custody">
                            <field name="current_custody_type"/>
                            <field name="current_vehicle_id"/>
                            <field name="current_driver_id"/>
                            <field name="current_location_id"/>
                        </group>
                    </group>
                    <group string="Transit Evidence">
                        <field name="evidence_attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group>
                        <field name="notes" widget="text" nolabel="1"
                               placeholder="Notes about this item…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dispatch_items" model="ir.actions.act_window">
        <field name="name">Freight Items</field>
        <field name="res_model">prema.dispatch.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
