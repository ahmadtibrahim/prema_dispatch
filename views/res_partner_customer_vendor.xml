<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_customer_vendor_form" model="ir.ui.view">
        <field name="name">res.partner.customer.vendor.toggle</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="customer_rank" string="Is Customer" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="supplier_rank" string="Is Vendor" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
