<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_consolidation_wizard_form" model="ir.ui.view">
        <field name="name">prema.dispatch.consolidation.wizard.form</field>
        <field name="model">prema.dispatch.consolidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Suggested Consolidated Route">
                <div class="alert alert-info" role="alert">
                    Suggested combined stop order for <field name="vehicle_id" readonly="1" nolabel="1"/>
                    on <field name="date" readonly="1" nolabel="1"/> — review before applying.
                </div>
                <field name="line_ids">
                    <list create="0" delete="0">
                        <field name="job_id"/>
                        <field name="stop_type" widget="badge"
                               decoration-info="stop_type == 'pickup'"
                               decoration-success="stop_type == 'dropoff'"
                               decoration-warning="stop_type in ('cross_dock_drop', 'cross_dock_pickup')"/>
                        <field name="address"/>
                        <field name="pallets_in" string="In"/>
                        <field name="pallets_out" string="Out"/>
                        <field name="eta"/>
                        <field name="origin_stop_name" optional="show" string="Held For"/>
                    </list>
                </field>
                <footer>
                    <button name="action_accept" type="object"
                            string="Accept &amp; Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
