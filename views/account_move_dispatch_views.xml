<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_prema_dispatch" model="ir.ui.view">
        <field name="name">account.move.form.prema.dispatch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Dispatch button in header -->
            <xpath expr="//button[@name='action_ai_generate_invoice']" position="before">
                <button name="action_book_load"
                        string="Book Load"
                        type="object"
                        class="btn-primary"
                        icon="fa-truck"
                        invisible="move_type not in ('out_invoice','out_refund')"
                        help="Create a Prema Dispatch booking from this invoice. Customer details are pulled automatically."/>
            </xpath>

            <!-- Smart button — Prema Dispatch job count -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_dispatch_jobs_prema"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="move_type not in ('out_invoice','out_refund') or dispatch_job_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="dispatch_job_count"/>
                        </span>
                        <span class="o_stat_text">Dispatch</span>
                    </div>
                </button>
            </xpath>

            <!-- Fill the Dispatch tab with Prema Dispatch jobs only -->
            <xpath expr="//page[@name='dispatch_jobs_tab']" position="inside">
                <!-- Rate-confirmation summary — invoice-level fields, always shown once
                     the tab itself is visible. Read-only here: these are edited on the
                     invoice's own Other Info tab (payment terms) or via AI extraction /
                     dispatcher entry (BOL/PO/load ref), not from this overview tab. -->
                <group string="Rate Confirmation Details">
                    <group>
                        <field name="amount_total" string="Rate (Invoice Total)" readonly="1"/>
                        <field name="invoice_payment_term_id" string="Payment Terms" readonly="1"/>
                    </group>
                    <group>
                        <field name="premafirm_bol" string="BOL #" readonly="1"/>
                        <field name="premafirm_po" string="PO #" readonly="1"/>
                        <field name="load_reference" string="Load / Reference #" readonly="1"/>
                    </group>
                </group>

                <group invisible="dispatch_status == 'none' or not dispatch_status">
                    <group>
                        <field name="dispatch_status" readonly="1"
                               widget="badge"
                               decoration-muted="dispatch_status == 'none'"
                               decoration-info="dispatch_status == 'draft'"
                               decoration-warning="dispatch_status == 'in_progress'"
                               decoration-success="dispatch_status in ('completed','pod_ready','posted')"
                               decoration-danger="dispatch_status == 'error'"/>
                    </group>
                </group>

                <field name="dispatch_job_ids">
                    <list string="Dispatch Jobs" create="false">
                        <field name="name" string="Job #"/>
                        <field name="stage_id" string="Stage"/>
                        <field name="priority" widget="priority" optional="show"/>
                        <field name="vehicle_id" string="Truck" readonly="1"/>
                        <field name="driver_id" string="Driver" readonly="1"/>
                        <field name="scheduled_pickup" string="Pickup Time" readonly="1"/>
                        <field name="delivery_deadline" string="Delivery Deadline" readonly="1" optional="show"/>
                        <field name="bol_number" string="BOL #" readonly="1" optional="show"/>
                        <field name="po_number" string="PO #" readonly="1" optional="show"/>
                        <field name="stop_count" string="Stops"/>
                        <field name="total_skids" string="Skids" optional="show"/>
                        <field name="all_stops_completed" string="Stops Done" optional="show"/>
                        <field name="pod_complete" string="POD Received" optional="show"/>
                    </list>
                </field>

                <div class="mt-2">
                    <button name="action_book_load"
                            string="Book Load"
                            type="object"
                            class="btn btn-primary"
                            invisible="dispatch_job_count > 0"/>
                    <button name="action_open_dispatch_jobs_prema"
                            string="Open Dispatch Jobs"
                            type="object"
                            class="btn btn-secondary ms-2"
                            invisible="dispatch_job_count == 0"/>
                </div>
            </xpath>

            <!-- Hidden computed fields -->
            <xpath expr="//field[@name='dispatch_estimator_id']" position="after">
                <field name="dispatch_job_count" invisible="1"/>
                <field name="dispatch_status" invisible="1"/>
                <field name="dispatch_auto_posted" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
