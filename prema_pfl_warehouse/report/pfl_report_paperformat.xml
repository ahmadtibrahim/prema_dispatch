<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- 4x6in, the common thermal label size. It is a normal Odoo
             paperformat, so the label prints on a label printer when one is
             attached and on the office printer when one is not — no IoT box is
             required for either. -->
        <record id="paperformat_pfl_pallet_label" model="report.paperformat">
            <field name="name">PF Logistics Pallet Label (4x6 in)</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">152</field>
            <field name="page_width">102</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">203</field>
        </record>
    </data>
</odoo>
