<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- The label carries an opaque token and nothing else.

         Deliberately absent: the customer's name, the shipper, the origin, the
         freight description, any price, and any job reference that would let a
         stranger tie a pallet on a dock to a commercial document. A label falls
         off a pallet in a yard; whatever is on it becomes public. The QR
         resolves to a whitelisted, non-sensitive summary for anyone, and to the
         full record only for a signed-in Odoo user — so the label itself never
         has to carry the detail. -->
    <template id="report_pfl_pallet_label_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="page-break-after: always;">
                    <div style="text-align: center; padding-top: 4mm;">
                        <img t-att-src="o._pfl_qr_data_uri()"
                             style="width: 78mm; height: 78mm;"
                             alt="Pallet QR"/>
                        <div style="font-size: 22pt; font-weight: 700; letter-spacing: 1pt; margin-top: 3mm;">
                            <t t-esc="o.name"/>
                        </div>
                        <div style="font-size: 12pt; margin-top: 1mm;">PF Logistics</div>
                        <div style="font-size: 9pt; color: #555; margin-top: 2mm;">
                            Scan to identify this pallet
                        </div>
                        <div t-if="o.pfl_on_hold"
                             style="font-size: 14pt; font-weight: 700; margin-top: 4mm; border: 2pt solid #000; padding: 2mm;">
                            ON HOLD — DO NOT RELEASE
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_pfl_pallet_label" model="ir.actions.report">
        <field name="name">Pallet Label (QR)</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">prema_pfl_warehouse.report_pfl_pallet_label_document</field>
        <field name="report_file">prema_pfl_warehouse.report_pfl_pallet_label_document</field>
        <field name="paperformat_id" ref="paperformat_pfl_pallet_label"/>
        <field name="print_report_name">'Pallet %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="stock.model_stock_quant_package"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
