<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_prema_pfl_job_tree" model="ir.ui.view">
        <field name="name">prema.pfl.warehouse.job.tree</field>
        <field name="model">prema.pfl.warehouse.job</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-danger="on_hold_count &gt; 0"
                  decoration-success="state == 'released'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="freight_owner_id" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
                <field name="service_mode"/>
                <field name="package_count" string="Pallets"/>
                <field name="received_count" optional="show"/>
                <field name="released_count" optional="show"/>
                <field name="on_hold_count" optional="show"/>
                <field name="uninvoiced_total" widget="monetary" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_prema_pfl_job_form" model="ir.ui.view">
        <field name="name">prema.pfl.warehouse.job.form</field>
        <field name="model">prema.pfl.warehouse.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pfl_confirm" type="object"
                            string="Confirm &amp; Freeze Rates" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_pfl_ensure_expected_pallets" type="object"
                            string="Add Expected Pallets"
                            invisible="state not in ('confirmed', 'storing')"/>
                    <button name="action_button_receive" type="object"
                            string="Receive" class="btn-primary"
                            invisible="state not in ('confirmed', 'storing')"/>
                    <button name="action_button_prepare_release" type="object"
                            string="Prepare Release"
                            invisible="state not in ('storing', 'prepared')"/>
                    <button name="action_button_release" type="object"
                            string="Release" class="btn-primary"
                            invisible="state not in ('storing', 'prepared', 'released')"/>
                    <button name="action_pfl_review_charges" type="object"
                            string="Review Charges"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_pfl_create_invoice" type="object"
                            string="Create Draft Invoice"
                            invisible="state in ('draft', 'cancelled') or not uninvoiced_charge_count"/>
                    <button name="action_pfl_cancel" type="object"
                            string="Cancel" invisible="state in ('released', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,storing,prepared,released"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_prema_pfl_charge)d" type="action"
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="not charge_ids">
                            <field name="charge_total" widget="statinfo" string="Charges"/>
                        </button>
                        <button name="action_pfl_open_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Warehouse</span>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="freight_owner_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="sale_order_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="booking_id" readonly="state not in ('draft',)"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="service_mode"
                                   readonly="state not in ('draft',)"/>
                            <field name="label_restriction"
                                   readonly="state not in ('draft',)"/>
                            <field name="expected_pallets"/>
                            <field name="customer_reference"/>
                            <field name="bol_number"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pallets" name="pallets">
                            <field name="package_ids" readonly="1">
                                <list
                                      decoration-danger="pfl_on_hold"
                                      decoration-muted="pfl_state == 'released'">
                                    <field name="name"/>
                                    <field name="pfl_state" widget="badge"/>
                                    <field name="pfl_owner_id"/>
                                    <field name="pfl_on_hold"/>
                                    <field name="pfl_received_at"/>
                                    <field name="pfl_received_by" optional="hide"/>
                                    <field name="pfl_staged_at" optional="show"/>
                                    <field name="pfl_released_at"/>
                                    <field name="pfl_released_by" optional="hide"/>
                                    <field name="pfl_custody_hours"/>
                                    <field name="pfl_location_id"/>
                                    <field name="pfl_label_mode" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Charges" name="charges">
                            <field name="charge_ids" readonly="1">
                                <list decoration-muted="invoiced">
                                    <field name="service"/>
                                    <field name="name"/>
                                    <field name="basis"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="unit_rate"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="invoiced"/>
                                    <field name="invoice_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accepted Rates" name="rates">
                            <field name="rate_ids" readonly="1">
                                <list>
                                    <field name="service"/>
                                    <field name="product_id"/>
                                    <field name="unit_rate"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="source"/>
                                    <field name="free_service"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work Recorded" name="work">
                            <group string="Labour (one hour minimum per person)">
                                <field name="labour_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="occurred_at"/>
                                        <field name="persons"/>
                                        <field name="minutes"/>
                                        <field name="billable_hours"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Counted Services">
                                <field name="wrapping_pallets"/>
                                <field name="pallets_supplied"/>
                                <field name="labeling_pallets"/>
                            </group>
                            <group string="Agreed Extras">
                                <field name="extra_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="unit_rate"/>
                                        <field name="amount" widget="monetary"/>
                                        <field name="approved"/>
                                        <field name="approved_at" readonly="1"/>
                                        <button name="action_approve" type="object"
                                                string="Record Approval"
                                                invisible="approved"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Custody Log" name="events">
                            <field name="event_ids" readonly="1">
                                <list decoration-muted="is_corrected">
                                    <field name="occurred_at"/>
                                    <field name="package_id"/>
                                    <field name="event_type"/>
                                    <field name="user_id"/>
                                    <field name="from_location_id" optional="hide"/>
                                    <field name="to_location_id" optional="hide"/>
                                    <field name="corrects_id" optional="show"/>
                                    <field name="reason" optional="show"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="arrival_note"/>
                            <field name="notes" placeholder="Receiving instructions, label restrictions, agreed scope…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_prema_pfl_job_search" model="ir.ui.view">
        <field name="name">prema.pfl.warehouse.job.search</field>
        <field name="model">prema.pfl.warehouse.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="freight_owner_id"/>
                <field name="sale_order_id"/>
                <field name="customer_reference"/>
                <filter name="filter_active" string="In Custody"
                        domain="[('state', 'in', ('confirmed', 'storing', 'prepared'))]"/>
                <!-- These search across the related records rather than the
                     non-stored counters: a computed field that is not stored
                     cannot be searched, and making it stored would put a
                     derived number in the database where it could drift. -->
                <filter name="filter_hold" string="On Hold"
                        domain="[('package_ids.pfl_on_hold', '=', True)]"/>
                <filter name="filter_todo" string="To Invoice"
                        domain="[('charge_ids.invoiced', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Billing Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_mode" string="Handling"
                            context="{'group_by': 'service_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_prema_pfl_job" model="ir.actions.act_window">
        <field name="name">Warehouse Jobs</field>
        <field name="res_model">prema.pfl.warehouse.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warehouse jobs yet</p>
            <p>Open a job from a confirmed sales order, or create one here for a
               customer who is not going through the quotation flow.</p>
        </field>
    </record>

    <!-- The sales order is the normal way in, so the button lives there. -->
    <record id="view_order_form_prema_pfl" model="ir.ui.view">
        <field name="name">sale.order.form.prema.pfl</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_pfl_create_job" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="state != 'sale'"
                        groups="prema_dispatch.group_dispatcher,prema_dispatch.group_dispatch_manager,prema_dispatch.group_dispatch_warehouse">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Warehouse</span>
                        <span class="o_stat_text">Job</span>
                    </div>
                </button>
                <button name="action_pfl_open_jobs" type="object"
                        class="oe_stat_button" icon="fa-list"
                        invisible="not prema_pfl_job_count"
                        groups="prema_dispatch.group_dispatcher,prema_dispatch.group_dispatch_manager,prema_dispatch.group_dispatch_warehouse">
                    <field name="prema_pfl_job_count" widget="statinfo"
                           string="Jobs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
