<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_prema_pfl_card_tree" model="ir.ui.view">
        <field name="name">prema.pfl.card.tree</field>
        <field name="model">prema.pfl.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="package_id"/>
                <field name="position_location_id"/>
                <field name="job_id"/>
                <field name="active"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_prema_pfl_card_form" model="ir.ui.view">
        <field name="name">prema.pfl.card.form</field>
        <field name="model">prema.pfl.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="package_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="position_location_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"
                               placeholder="Why this pallet cannot carry a label, and where the card is kept."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prema_pfl_card" model="ir.actions.act_window">
        <field name="name">Off-Pallet Cards</field>
        <field name="res_model">prema.pfl.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No identification cards yet</p>
            <p>When a customer prohibits a label on their pallet, the pallet is
               identified by a card beside it and an exclusive position — never
               by a photograph or by memory.</p>
        </field>
    </record>
</odoo>
