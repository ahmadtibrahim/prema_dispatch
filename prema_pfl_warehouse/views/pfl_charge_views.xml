<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_prema_pfl_charge_tree" model="ir.ui.view">
        <field name="name">prema.pfl.charge.tree</field>
        <field name="model">prema.pfl.charge</field>
        <field name="arch" type="xml">
            <list decoration-muted="invoiced" create="false" delete="false">
                <field name="job_id"/>
                <field name="service"/>
                <field name="name"/>
                <field name="basis"/>
                <field name="package_id" optional="hide"/>
                <field name="quantity"/>
                <field name="unit_rate"/>
                <field name="amount" widget="monetary" sum="Uninvoiced total"/>
                <field name="invoiced"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_prema_pfl_charge_search" model="ir.ui.view">
        <field name="name">prema.pfl.charge.search</field>
        <field name="model">prema.pfl.charge</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="name"/>
                <field name="basis"/>
                <filter name="filter_uninvoiced" string="Not Yet Invoiced"
                        domain="[('invoiced', '=', False)]"/>
                <filter name="filter_invoiced" string="Invoiced"
                        domain="[('invoiced', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_service" string="Service"
                            context="{'group_by': 'service'}"/>
                    <filter name="group_job" string="Job"
                            context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_prema_pfl_charge" model="ir.actions.act_window">
        <field name="name">Warehouse Charges</field>
        <field name="res_model">prema.pfl.charge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_uninvoiced': 1}</field>
    </record>

    <record id="view_prema_pfl_rate_tree" model="ir.ui.view">
        <field name="name">prema.pfl.rate.tree</field>
        <field name="model">prema.pfl.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="job_id"/>
                <field name="service"/>
                <field name="product_id"/>
                <field name="unit_rate"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="source"/>
                <field name="free_service"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_prema_pfl_rate" model="ir.actions.act_window">
        <field name="name">Accepted Rates</field>
        <field name="res_model">prema.pfl.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_prema_pfl_labour_tree" model="ir.ui.view">
        <field name="name">prema.pfl.labour.tree</field>
        <field name="model">prema.pfl.labour</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="job_id"/>
                <field name="occurred_at"/>
                <field name="persons"/>
                <field name="minutes"/>
                <field name="billable_hours"/>
                <field name="package_id" optional="hide"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_prema_pfl_labour" model="ir.actions.act_window">
        <field name="name">Warehouse Labour</field>
        <field name="res_model">prema.pfl.labour</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_prema_pfl_extra_tree" model="ir.ui.view">
        <field name="name">prema.pfl.extra.tree</field>
        <field name="model">prema.pfl.extra</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="job_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="unit_rate"/>
                <field name="amount" widget="monetary"/>
                <field name="approved"/>
                <field name="approved_by" readonly="1"/>
                <field name="approved_at" readonly="1"/>
                <field name="approval_reference"/>
            </list>
        </field>
    </record>

    <record id="action_prema_pfl_extra" model="ir.actions.act_window">
        <field name="name">Agreed Extras</field>
        <field name="res_model">prema.pfl.extra</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
